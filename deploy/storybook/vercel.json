{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run tokens:build && npx storybook build -o deploy/storybook/dist --quiet",
  "outputDirectory": "dist",
  "ignoreCommand": "node ../../scripts/vercel-ignore.mjs storybook",
  "git": { "deploymentEnabled": { "agent/**": false, "test/**": false, "changeset-release/**": false, "explore/**": false, "bridge/**": false } }
}
