{
  "name": "@demo-ds/tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bridge design tokens in W3C DTCG 2025.10 format (primitives, brands, semantic light/dark, density, component tier), built to CSS variables and TypeScript with Style Dictionary.",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./fonts.css",
    "./resolved.json": "./dist/resolved.json",
    ".": "./dist/tokens.ts"
  },
  "files": [
    "dist",
    "src",
    "fonts.css",
    "scripts"
  ],
  "scripts": {
    "build": "node build.mjs",
    "build:ramps": "node scripts/ramps.mjs"
  },
  "devDependencies": {
    "style-dictionary": "4.4.0"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  }
}
