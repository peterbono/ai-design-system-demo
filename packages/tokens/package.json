{
  "name": "@bridge-ds/tokens",
  "version": "1.4.0",
  "type": "module",
  "description": "Bridge design tokens in W3C DTCG 2025.10 format (primitives, brands, semantic light/dark, density, component tier), built to CSS variables and TypeScript with Style Dictionary.",
  "license": "MIT",
  "author": "Florian Gouloubi",
  "homepage": "https://github.com/peterbono/ai-design-system-demo/tree/main/packages/tokens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterbono/ai-design-system-demo.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/peterbono/ai-design-system-demo/issues"
  },
  "keywords": [
    "design-tokens",
    "dtcg",
    "design-system",
    "css-variables",
    "bridge"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/tokens.js",
  "types": "./dist/tokens.d.ts",
  "exports": {
    ".": {
      "source": "./dist/tokens.ts",
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./fonts.css",
    "./resolved.json": "./dist/resolved.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "fonts.css",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:ramps": "node scripts/ramps.mjs",
    "build:package": "node build.mjs && node ../../scripts/build-packages.mjs tokens"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  },
  "devDependencies": {
    "style-dictionary": "4.4.0"
  }
}
