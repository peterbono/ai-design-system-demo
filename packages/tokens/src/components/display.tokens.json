{
  "avatar": {
    "$type": "color",
    "bg": {
      "$value": "{color.bg.subtle}"
    },
    "text": {
      "$value": "{color.text.default}"
    },
    "ring": {
      "$value": "{color.surface.default}"
    },
    "illustrated-bg": {
      "$value": "{color.illustration.surface}"
    },
    "agent-bg": {
      "$value": "{color.agent.surface}"
    },
    "agent-border": {
      "$value": "{color.border.default}"
    }
  },
  "tag": {
    "$type": "color",
    "bg": {
      "$value": "{color.bg.subtle}"
    },
    "border": {
      "$value": "{color.border.default}"
    },
    "bg-hover": {
      "$value": "{color.surface.hover}"
    },
    "text": {
      "$value": "{color.text.default}"
    },
    "bg-selected": {
      "$value": "{color.control.checked.bg}"
    },
    "text-selected": {
      "$value": "{color.control.checked.fg}"
