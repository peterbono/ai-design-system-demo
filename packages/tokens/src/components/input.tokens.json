{
  "input": {
    "bg": {
      "$type": "color",
      "$value": "{color.control.bg}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.strong}"
    },
    "border-hover": {
      "$type": "color",
      "$value": "{color.border.hover}"
    },
    "border-invalid": {
      "$type": "color",
      "$value": "{color.feedback.danger.icon}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.text.default}"
    },
    "placeholder": {
      "$type": "color",
      "$value": "{color.text.muted}"
    },
    "bg-disabled": {
      "$type": "color",
      "$value": "{color.action.disabled.bg}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.control}"
    }
  }
}
