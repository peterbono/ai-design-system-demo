{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "100": { "$value": { "value": 12, "unit": "px" } },
      "200": { "$value": { "value": 14, "unit": "px" } },
      "300": { "$value": { "value": 16, "unit": "px" } },
      "400": { "$value": { "value": 18, "unit": "px" } },
      "500": { "$value": { "value": 20, "unit": "px" } },
      "600": { "$value": { "value": 24, "unit": "px" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.25 },
      "normal": { "$value": 1.5 }
    }
  }
}
