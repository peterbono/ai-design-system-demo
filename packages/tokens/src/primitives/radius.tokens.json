      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "xs": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 14,
        "unit": "px"
      }
    },
    "2xl": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "3xl": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "border": {
    "width": {
      "1": {
        "$value": {
          "value": 1,
          "unit": "px"
        }
      },
      "2": {
        "$value": {
          "value": 2,
          "unit": "px"
        }
      },
      "3": {
        "$value": {
          "value": 3,
          "unit": "px"
        }
      },
      "$type": "dimension"
    }
  }
