{
  "color": {
    "bg": {
      "default": {
        "$type": "color",
        "$value": "{palette.neutral.0}",
        "$description": "Page canvas. White in bridge, so content sits on paper; ocean keeps a tinted canvas."
      },
      "subtle": {
        "$type": "color",
        "$value": "{palette.neutral.100}",
        "$description": "Recessed areas: table headers, code blocks, footers."
      },
      "muted": {
        "$type": "color",
        "$value": "{palette.neutral.200}",
        "$description": "Tracks, skeletons, neutral fills."
      },
      "zone": {
        "$type": "color",
        "$value": "{palette.primary.200}",
        "$description": "Large flat color blocks that open a space: the home hero, section page headers, the Studio greeting, onboarding. Never behind dense UI."
      }
    },
    "surface": {
      "default": {
        "$type": "color",
        "$value": "{palette.neutral.0}",
        "$description": "Panels, cards, inputs."
      },
