{
  "color": {
    "bg": {
      "default": {
        "$type": "color",
        "$value": "{palette.neutral.950}",
        "$description": "Page canvas behind panels."
      },
      "subtle": {
        "$type": "color",
        "$value": "{palette.neutral.900}",
        "$description": "Recessed areas: table headers, code blocks, footers."
      },
      "muted": {
        "$type": "color",
        "$value": "{palette.neutral.800}",
        "$description": "Tracks, skeletons, neutral fills."
      },
      "zone": {
        "$type": "color",
        "$value": "{palette.primary.900}",
        "$description": "Large flat color blocks that open a space. A muted deep blue in dark."
      }
    },
    "surface": {
      "default": {
        "$type": "color",
        "$value": "{palette.neutral.900}",
        "$description": "Panels, cards, inputs."
      },
      "raised": {
        "$type": "color",
        "$value": "{palette.neutral.800}",
        "$description": "Floating layers: popovers, menus, dialogs, toasts."
      },
      "hover": {
        "$type": "color",
        "$value": "{palette.neutral.800}",
        "$description": "Hover fill for rows, menu items, ghost controls."
      },
      "hover-raised": {
        "$type": "color",
        "$value": "{palette.neutral.700}",
        "$description": "Hover fill inside a raised surface."
      },
      "pressed": {
        "$type": "color",
        "$value": "{palette.neutral.700}",
        "$description": "Pressed fill."
      },
      "selected": {
        "$type": "color",
        "$value": "{palette.accent.950}",
        "$description": "Selected rows and items. Paired with a checked control or a mark, never alone."
      },
      "inverse": {
        "$type": "color",
        "$value": "{palette.neutral.100}",
        "$description": "Tooltips and inverse chips."
      },
      "strong": {
        "$type": "color",
        "$value": "{palette.primary.700}",
        "$description": "Deep Harbor in both themes, for a mode the whole page is in (Banner appearance strong). Text on it: text.on-solid. Dark keeps it dark, so it never reads as the Harbor zone or the light primary action of the dark theme."
      }
    },
    "text": {
      "default": {
        "$type": "color",
        "$value": "{palette.neutral.50}"
      },
      "muted": {
        "$type": "color",
        "$value": "{palette.neutral.400}",
        "$description": "Secondary text. 4.5:1 on every background."
      },
      "disabled": {
        "$type": "color",
        "$value": "{palette.neutral.600}",
        "$description": "Disabled text. Exempt from contrast minimums; never the only cue."
      },
      "inverse": {
        "$type": "color",
        "$value": "{palette.neutral.950}",
        "$description": "Text on surface.inverse."
      },
      "on-solid": {
        "$type": "color",
        "$value": "{palette.neutral.0}",
        "$description": "Text and icons on feedback and danger solids."
      },
      "link": {
        "$type": "color",
        "$value": "{palette.link.300}"
      },
      "link-hover": {
        "$type": "color",
        "$value": "{palette.link.200}"
      },
      "signal": {
        "$type": "color",
        "$value": "{palette.accent.300}",
        "$description": "Signal-colored text (match highlights, current step)."
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{palette.neutral.800}",
        "$description": "Hairlines: card edges, dividers. Decorative, no contrast minimum."
      },
      "subtle": {
        "$type": "color",
        "$value": "{palette.neutral.900}",
