    "chart": {
      "$type": "color",
      "$description": "Data visualization. Series colors mark graphics (bars, arcs, lines) and need 3:1 against the surface; every series also carries a text label, never color alone.",
      "series": {
        "1": {
          "$value": "{palette.accent.400}",
          "$description": "Series 1, the signal hue: the series a chart is about."
        },
        "2": {
          "$value": "{palette.info.400}",
          "$description": "Series 2, the info hue."
        },
        "3": {
          "$value": "{palette.success.400}",
          "$description": "Series 3, the success hue."
        },
        "4": {
          "$value": "{palette.warning.400}",
          "$description": "Series 4, the warning hue."
        },
        "5": {
          "$value": "{palette.categorical.400}",
