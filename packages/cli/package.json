{
  "name": "@bridge-ds/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "bridge CLI: set up Bridge in a design system repo, check tokens in CI, search and diff tokens, propose changes, start the MCP server.",
  "license": "MIT",
  "author": "Florian Gouloubi",
  "homepage": "https://github.com/peterbono/ai-design-system-demo/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterbono/ai-design-system-demo.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/peterbono/ai-design-system-demo/issues"
  },
  "keywords": [
    "cli",
    "design-tokens",
    "design-system",
    "bridge"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "sideEffects": false,
  "bin": {
    "bridge": "dist/index.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:package": "node ../../scripts/build-packages.mjs cli"
  },
  "dependencies": {
    "@bridge-ds/mcp": "^0.1.0",
    "@bridge-ds/visual": "^0.1.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "esbuild": "0.27.7"
  }
}
