{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/peterbono/ai-design-system-demo/main/packages/core/bridge.config.schema.json",
  "title": "Bridge config",
  "description": "bridge.config.json at the root of a design system repository: where its DTCG tokens live, how they layer per mode, the contrast gate, components, docs, changesets and the governance rules Bridge enforces. One schema for @bridge-ds/core, the DS Bridge Figma plugin, the docs site, the CLI and the MCP server. The older flat form (tokens.primitives and friends, modes.brands/themes/densities) is still accepted.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1,
      "description": "Config format version."
    },
    "repo": {
      "description": "GitHub repository. Pull requests target defaultBranch; Bridge never writes to it.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[\\w.-]+/[\\w.-]+$"
        },
        {
          "type": "object",
          "required": [
            "owner",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "owner": {
              "type": "string",
              "description": "GitHub owner (user or organization).",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "description": "Repository name.",
              "minLength": 1
            },
            "defaultBranch": {
              "type": "string",
              "description": "Base branch.",
              "minLength": 1,
              "default": "main"
            }
          }
        }
      ]
    },
    "branch": {
      "type": "string",
      "description": "Flat form: base branch (use repo.defaultBranch).",
      "minLength": 1
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "description": "Token locations. root is repo-relative; every other path is relative to root.",
      "properties": {
        "root": {
          "type": "string",
          "description": "Directory holding every token file.",
          "default": "tokens"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Token file globs, relative to root.",
          "default": [
            "**/*.tokens.json"
          ]
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Globs to skip, relative to root.",
          "default": []
        },
        "tiers": {
          "type": "object",
          "description": "Tier name -> directories or files relative to root (primitive, brand, base, semantic, density, component). First match wins.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "description": "Resolution order, lowest first; later layers override earlier ones. {mode} placeholders pick the file per mode value.",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "files"
                ],
                "additionalProperties": false,
                "properties": {
                  "files": {
                    "type": "string",
                    "description": "Glob relative to root, e.g. semantic/{theme}.tokens.json.",
                    "minLength": 1
                  },
                  "optional": {
                    "type": "boolean",
                    "default": false,
                    "description": "A missing file is fine (brand overrides only some brands have)."
                  }
                }
              }
            ]
          }
        },
        "primitives": {
          "type": "string",
          "description": "Flat form: primitive tier directory."
        },
        "brands": {
          "type": "string",
          "description": "Flat form: brand tier directory."
        },
        "semantic": {
          "type": "string",
          "description": "Flat form: semantic tier directory."
        },
        "base": {
          "type": "string",
          "description": "Flat form: stem of the theme-independent semantic file."
        },
        "density": {
          "type": "string",
          "description": "Flat form: density tier directory."
        },
        "components": {
          "type": "string",
          "description": "Flat form: component tier directory."
        },
        "contrastChecks": {
          "type": "string",
          "description": "Flat form: contrast checks file relative to root (use contrast.path)."
        }
      }
    },
    "modes": {
      "type": "object",
      "description": "Mode name -> values. Names match the {placeholders} in tokens.layers. brand, theme and density drive the Figma collections.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "values"
        ],
        "additionalProperties": false,
        "properties": {
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "default": {
            "type": "string",
            "description": "Defaults to the first value."
          },
          "parity": {
            "type": "boolean",
            "default": false,
            "description": "Every token defined for one value must be defined for the others."
          }
        }
      },
      "properties": {
        "brands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Flat form."
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Flat form."
        },
        "densities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Flat form."
        },
        "defaults": {
          "type": "object",
          "description": "Flat form.",
          "additionalProperties": false,
          "properties": {
            "brand": {
              "type": "string"
            },
            "theme": {
              "type": "string"
            },
            "density": {
              "type": "string"
            }
          }
        }
      }
    },
    "contrast": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Repo-relative JSON file with pairs: [[foreground, background, minimum ratio], ...]."
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Modes the gate iterates over; the others stay at their default. All modes when omitted."
        }
      }
    },
    "components": {
      "type": "object",
      "required": [
        "dir"
      ],
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string",
          "description": "Code components directory, repo-relative.",
          "minLength": 1
        },
        "docsSuffix": {
          "type": "string",
          "description": "Usage docs file suffix.",
          "default": ".docs.json"
        },
        "styleSuffix": {
          "type": "string",
          "description": "Stylesheet suffix.",
          "default": ".module.css"
        },
        "reference": {
          "type": "string",
          "description": "Component whose docs.json keys new components copy."
        },
        "index": {
          "type": "string",
          "description": "Barrel file new components are exported from."
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "designLanguage": {
          "type": "string",
          "description": "Design language document."
        },
        "guidelines": {
          "type": "string",
          "description": "Agent rules (AGENTS.md)."
        },
        "governance": {
          "type": "string",
          "description": "Governance document with the risk tiers."
        }
      }
    },
    "changesets": {
      "type": "object",
      "required": [
        "package"
      ],
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string",
          "description": "Changeset directory.",
          "default": ".changeset"
        },
        "package": {
          "type": "string",
          "description": "Package a token changeset bumps.",
          "minLength": 1
        }
      }
    },
    "changeset": {
      "type": "object",
      "required": [
        "package"
      ],
      "additionalProperties": false,
      "description": "Older name of changesets.",
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cssVar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": {
          "type": "string",
          "description": "CSS variable prefix.",
          "default": "--"
        },
        "separator": {
          "type": "string",
          "description": "Joins token path segments.",
          "default": "-"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protectedBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Branches no Bridge surface writes to. The default branch is always protected.",
          "default": [
            "main",
            "master"
          ]
        },
        "branchPrefix": {
          "type": "string",
          "description": "Prefix of branches agents create.",
          "default": "bridge/"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Labels on pull requests opened by an agent.",
          "default": [
            "source: mcp"
          ]
        },
        "guardrails": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Repo-relative files whose change is Tier 3 on its own; a trailing / matches a directory."
        },
        "owners": {
          "type": "object",
          "additionalProperties": false,
          "description": "GitHub logins that count as design and tech owners for Tier 3 approvals. Empty: two distinct approvers stand in.",
          "properties": {
            "design": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Design owners."
            },
            "tech": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tech owners."
            }
          }
        },
        "override": {
          "type": "object",
          "additionalProperties": false,
          "description": "Owner override: lets the listed logins merge from Bridge when the only thing missing is approvals (solo maintainers, small teams). Never applies while CI fails or runs, when changes are requested, or to a draft. Bridge posts a pull request comment starting with **Bridge owner override** with the login, the reason and the missing approvals before it merges. Absent: no override.",
          "properties": {
            "allowed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "GitHub logins allowed to merge as owner override. They still need write access to the repo.",
              "default": []
            },
            "requireReason": {
              "type": "boolean",
              "description": "Ask for a written reason, posted on the pull request as the audit trail.",
              "default": true
            },
            "minReasonLength": {
              "type": "integer",
              "minimum": 0,
              "description": "Shortest accepted reason, in characters.",
              "default": 20
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "description": "bridge audit: how product code that consumes this design system is measured (token and component adoption).",
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Packages the DS components are imported from. Default: the package that holds components.dir, plus @bridge-ds/react."
        },
        "foreignLibraries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extra import prefixes counted as foreign UI libraries (MUI, antd, Chakra, Radix, Headless UI, Mantine, react-admin... are built in)."
        },
        "nativeElements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Native elements counted as UI that a DS component should render (an <a> only with href).",
          "default": [
            "button",
            "input",
            "select",
            "textarea",
            "dialog",
            "table",
            "a",
            "img"
          ]
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Path globs, relative to the audited folder, to skip."
        }
      }
    },
    "previews": {
      "type": "object",
      "additionalProperties": false,
      "description": "Branch previews: packages published as snapshots per PR commit, per-branch deploy URL templates and production URLs. See docs/PREVIEWS.md.",
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Packages published to pkg.pr.new (or as release tarballs) for every PR commit."
        },
        "apps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "docs": {
              "type": "string",
              "pattern": "^https?://",
              "description": "Docs site preview. URL template. Placeholders: {branch} (Vercel-style slug), {rawBranch}, {pr}, {sha}, {sha7}."
            },
            "storybook": {
              "type": "string",
              "pattern": "^https?://",
              "description": "Storybook preview. URL template. Placeholders: {branch} (Vercel-style slug), {rawBranch}, {pr}, {sha}, {sha7}."
            },
            "admin": {
              "type": "string",
              "pattern": "^https?://",
              "description": "Admin demo preview. URL template. Placeholders: {branch} (Vercel-style slug), {rawBranch}, {pr}, {sha}, {sha7}."
            }
          }
        },
        "production": {
          "type": "object",
          "additionalProperties": false,
          "description": "Production URL of each app (what the default branch deploys). Fixed URLs, no placeholders. Used for links on the default branch and in local builds.",
          "properties": {
            "docs": { "type": "string", "pattern": "^https?://[^{}]*$", "description": "Docs site production URL." },
            "storybook": { "type": "string", "pattern": "^https?://[^{}]*$", "description": "Storybook production URL." },
            "admin": { "type": "string", "pattern": "^https?://[^{}]*$", "description": "Admin demo production URL." }
          }
        }
      }
    }
  }
}
