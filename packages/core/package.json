{
  "name": "@bridge-ds/core",
  "version": "0.24.0",
  "type": "module",
  "description": "Bridge core: bridge.config.json, DTCG token loading (tiers and layered modes), alias resolution, WCAG contrast, diffs, minimal-diff edits, PR body, the shared risk tier classifier, changesets and a fetch-based GitHub client. No Figma API, no DOM; Node-only helpers (git, reading a product folder) under @bridge-ds/core/node; the adoption audit under @bridge-ds/core/audit.",
  "license": "MIT",
  "author": "Florian Gouloubi",
  "homepage": "https://github.com/peterbono/ai-design-system-demo/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterbono/ai-design-system-demo.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/peterbono/ai-design-system-demo/issues"
  },
  "keywords": [
    "design-tokens",
    "dtcg",
    "wcag",
    "design-system",
    "bridge"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./audit": {
      "source": "./src/audit/index.ts",
      "types": "./dist/audit/index.d.ts",
      "default": "./dist/audit/index.js"
    },
    "./node": {
      "source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./bridge.config.schema.json": "./bridge.config.schema.json",
    "./audit-report.schema.json": "./audit-report.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bridge.config.schema.json",
    "audit-report.schema.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:package": "node ../../scripts/build-packages.mjs core"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "20.19.9"
  }
}
