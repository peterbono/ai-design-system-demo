{
  "name": "@bridge-ds/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Bridge core: DTCG token loading across tiers, alias resolution, WCAG contrast checks, three-way diff, minimal-diff JSON edits, PR body, risk tier, changesets and a fetch-based GitHub client. No Figma API, no DOM.",
  "license": "MIT",
  "author": "Florian Gouloubi",
  "homepage": "https://github.com/peterbono/ai-design-system-demo/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterbono/ai-design-system-demo.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/peterbono/ai-design-system-demo/issues"
  },
  "keywords": [
    "design-tokens",
    "dtcg",
    "wcag",
    "design-system",
    "bridge"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bridge.config.schema.json": "./bridge.config.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bridge.config.schema.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:package": "node ../../scripts/build-packages.mjs core"
  },
  "devDependencies": {
    "@types/node": "20.19.9"
  }
}
