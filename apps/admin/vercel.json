{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run admin:build",
  "outputDirectory": "dist",
  "ignoreCommand": "node ../../scripts/vercel-ignore.mjs admin",
  "git": { "deploymentEnabled": { "agent/**": false, "test/**": false, "changeset-release/**": false } },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
