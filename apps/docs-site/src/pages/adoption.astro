---
import Layout from '../layouts/Layout.astro';
import Updated from '../components/Updated.astro';
import { adoptionTone, categoryRows, componentBreakdown, formatDelta, formatPct, loadAudits, trendPoints } from '../lib/audits';
import { PAGE_SOURCES, freshness } from '../lib/sources';
import '../styles/process.css';
import '../styles/adoption.css';

const updated = freshness(PAGE_SOURCES.adoption);
const entries = loadAudits();
const trend = trendPoints(entries.map((e) => e.report));

const R = 52;
const C = 2 * Math.PI * R;
const arc = (pct: number | null) => `${((pct ?? 0) / 100) * C} ${C}`;
const date = (iso: string) => iso.slice(0, 10);
const w = (n: number, max: number) => `${max ? (n / max) * 100 : 0}%`;

// Trend chart geometry: x by run index, y by percent.
const TW = 640;
const TH = 200;
const PAD = { l: 36, r: 16, t: 12, b: 28 };
const tx = (i: number) => PAD.l + (trend.length > 1 ? (i / (trend.length - 1)) * (TW - PAD.l - PAD.r) : (TW - PAD.l - PAD.r) / 2);
const ty = (pct: number) => PAD.t + (1 - pct / 100) * (TH - PAD.t - PAD.b);
const line = (key: 'tokenAdoption' | 'componentAdoption') =>
  trend
    .map((p, i) => (p[key] === null ? null : `${tx(i)},${ty(p[key]!)}`))
    .filter(Boolean)
    .join(' ');
---

<Layout title="Adoption" description="How much of a product codebase uses the design system: tokens instead of hardcoded values, DS components instead of other UI libraries." sources={PAGE_SOURCES.adoption} updated={updated}>
  <h1>Adoption</h1>
  <p class="lead">
    How much of a product codebase uses the design system. <strong>Token adoption</strong> is token usages divided by token usages plus hardcoded
    values (colors, lengths, radii, shadows, durations, z-index, fonts). <strong>Component adoption</strong> is DS component instances divided by
    every UI component instance: DS components, components from other UI libraries, native elements that should be DS components
    (<code>&lt;button&gt;</code>, <code>&lt;input&gt;</code>, <code>&lt;select&gt;</code>, <code>&lt;dialog&gt;</code>, <code>&lt;table&gt;</code>) and local
    components that re-create a DS component.
  </p>
  <Updated date={updated} />

  {
    entries.length === 0 && (
      <div class="process-empty">
        <h2>No audit report yet</h2>
        <p>Run the audit on a product codebase and commit the JSON report here. This page renders every report it finds.</p>
        <pre class="ad-cmd">
          <code>bridge audit ../my-app/src --json apps/docs-site/src/data/audits/my-app.json --md audit.md</code>
        </pre>
        <p>
          Next time, pass the previous report with <code>--baseline</code> to record progress, and <code>--fail-under 80</code> to fail CI when token or component adoption drops below 80%.
        </p>
      </div>
    )
  }

  {
    entries.length > 1 && (
      <nav class="ad-picker" aria-label="Reports">
        <span class="muted small">Reports</span>
        <ul>
          {entries.map((e, i) => (
            <li>
              <a href={`#${e.id}`}>
                {e.report.label ?? e.id}
                {i === 0 && <span class="pill is-info">Latest</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {
    entries.map((entry) => {
      const r = entry.report;
      const cats = categoryRows(r);
      const catMax = Math.max(1, ...cats.map((c) => c.hardcoded));
      const comps = componentBreakdown(r);
      const gauges = [
        {
          key: 'tokens',
          title: 'Token adoption',
          pct: r.metrics.tokenAdoption,
          sub: `${r.metrics.tokenUsages} token usages, ${r.metrics.hardcoded} hardcoded values`,
          extra: r.metrics.themeRefs ? `${r.metrics.themeRefs} references to another theme (MUI theme, Tailwind scale), counted apart` : '',
          delta: r.baseline?.tokenAdoption.delta,
        },
        {
          key: 'components',
          title: 'Component adoption',
          pct: r.metrics.componentAdoption,
          sub: `${r.metrics.dsComponentInstances} of ${r.metrics.uiComponentInstances} UI component instances`,
          extra: '',
          delta: r.baseline?.componentAdoption.delta,
        },
      ];
      return (
        <section class="ad-report" id={entry.id} aria-labelledby={`${entry.id}-title`}>
          <header class="ad-head">
            <div>
              <h2 id={`${entry.id}-title`}>{r.label ?? entry.id}</h2>
              <p class="muted small">
                <code>{r.target.path}</code>, {r.target.files} files scanned, run on {date(r.generatedAt)} with bridge {r.tool.version}. Design system:{' '}
                {r.designSystem.packages.map((p) => <code>{p}</code>)}, {r.designSystem.tokens} tokens, {r.designSystem.components} components.
              </p>
            </div>
            <span class="muted small">
              <code>{`${'src/data/audits/'}${entry.file}`}</code>
            </span>
          </header>

          <div class="ad-gauges">
            {gauges.map((g) => (
              <figure class={`ad-gauge is-${adoptionTone(g.pct)}`}>
                <svg viewBox="0 0 140 140" role="img" aria-label={`${g.title}: ${formatPct(g.pct)}`}>
                  <circle cx="70" cy="70" r={R} class="ad-ring-track" />
                  <circle cx="70" cy="70" r={R} class="ad-ring" stroke-dasharray={arc(g.pct)} transform="rotate(-90 70 70)" />
                  <text x="70" y="70" class="ad-ring-value" text-anchor="middle" dominant-baseline="central">
                    {formatPct(g.pct)}
                  </text>
                </svg>
                <figcaption>
                  <h3>{g.title}</h3>
                  <p class="num">{g.sub}</p>
                  {g.extra && <p class="muted small">{g.extra}</p>}
                  {g.delta !== undefined && g.delta !== null && (
                    <p class={`pill ${g.delta >= 0 ? 'is-pass' : 'is-fail'}`}>
                      {formatDelta(g.delta)} points since {r.baseline?.label ?? date(r.baseline!.generatedAt)}
                    </p>
                  )}
                </figcaption>
              </figure>
            ))}
          </div>

          <div class="section-head">
            <div>
              <h2>Hardcoded values by category</h2>
              <p>Exact: the value equals a token, safe to replace. Near: a token is close (nearest color in OKLab, nearest scale step). None: no token fits, the value may need a new token or a design decision.</p>
            </div>
          </div>
          {cats.length === 0 ? (
            <p class="muted">No hardcoded value found.</p>
          ) : (
            <div class="table-wrap">
              <ul class="legend legend-inline ad-legend" aria-hidden="true">
                <li><span class="ad-key ad-exact" />Exact token</li>
                <li><span class="ad-key ad-near" />Near token</li>
                <li><span class="ad-key ad-none" />No token</li>
              </ul>
              <table class="ad-cats">
                <caption class="sr-only">Hardcoded values per category, split by how well a token matches</caption>
                <thead>
                  <tr>
                    <th scope="col">Category</th>
                    <th scope="col" class="ad-bar-col">Share</th>
                    <th scope="col" class="num">Hardcoded</th>
                    <th scope="col" class="num">Exact</th>
                    <th scope="col" class="num">Near</th>
                    <th scope="col" class="num">None</th>
                  </tr>
                </thead>
                <tbody>
                  {cats.map((c) => (
                    <tr>
                      <th scope="row">{c.label}</th>
                      <td class="ad-bar-col">
                        <span class="ad-track" style={`width: ${w(c.hardcoded, catMax)}`}>
                          {c.exact > 0 && <span class="ad-seg ad-exact" style={`width: ${w(c.exact, c.hardcoded)}`} />}
                          {c.near > 0 && <span class="ad-seg ad-near" style={`width: ${w(c.near, c.hardcoded)}`} />}
                          {c.none > 0 && <span class="ad-seg ad-none" style={`width: ${w(c.none, c.hardcoded)}`} />}
                        </span>
                      </td>
                      <td class="num">{c.hardcoded}</td>
                      <td class="num">{c.exact}</td>
                      <td class="num">{c.near}</td>
                      <td class="num">{c.none}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          <div class="section-head">
            <div>
              <h2>Components</h2>
              <p>Where the {comps.total} UI component instances come from.</p>
            </div>
          </div>
          {comps.total > 0 && (
            <div class="ad-split" role="img" aria-label={`DS ${comps.ds}, other libraries ${comps.foreign}, native elements ${comps.native}, re-created ${comps.recreated}`}>
              {comps.ds > 0 && <span class="ad-seg ad-exact" style={`width: ${w(comps.ds, comps.total)}`} title={`DS ${comps.ds}`} />}
              {comps.foreign > 0 && <span class="ad-seg ad-none" style={`width: ${w(comps.foreign, comps.total)}`} title={`Other libraries ${comps.foreign}`} />}
              {comps.native > 0 && <span class="ad-seg ad-near" style={`width: ${w(comps.native, comps.total)}`} title={`Native ${comps.native}`} />}
              {comps.recreated > 0 && <span class="ad-seg ad-recreated" style={`width: ${w(comps.recreated, comps.total)}`} title={`Re-created ${comps.recreated}`} />}
            </div>
          )}
          <div class="ad-comp-grid">
            <article class="ad-card">
              <h3>
                <span class="ad-key ad-exact" aria-hidden="true" />
                Design system <span class="num muted">{comps.ds}</span>
              </h3>
              {comps.dsTop.length ? (
                <ul class="ad-list">
                  {comps.dsTop.map((x) => (
                    <li>
                      <code>{x.name}</code>
                      <span class="num">{x.count}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="muted small">No DS component used yet.</p>
              )}
            </article>
            {comps.libraries.map((l) => (
              <article class="ad-card">
                <h3>
                  <span class="ad-key ad-none" aria-hidden="true" />
                  <code>{l.name}</code> <span class="num muted">{l.instances}</span>
                </h3>
                <ul class="ad-list">
                  {l.top.map((x) => (
                    <li>
                      <code>{x.name}</code>
                      <span class="num">{x.count}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
            {comps.native > 0 && (
              <article class="ad-card">
                <h3>
                  <span class="ad-key ad-near" aria-hidden="true" />
                  Native elements <span class="num muted">{comps.native}</span>
                </h3>
                <ul class="ad-list">
                  {comps.nativeTop.map((x) => (
                    <li>
                      <code>{`<${x.name}>`}</code>
                      <span class="num">{x.count}</span>
                    </li>
                  ))}
                </ul>
              </article>
            )}
            {r.components.recreated.length > 0 && (
              <article class="ad-card">
                <h3>
                  <span class="ad-key ad-recreated" aria-hidden="true" />
                  Re-created <span class="num muted">{comps.recreated}</span>
                </h3>
                <p class="muted small">Local components named like a DS component.</p>
                <ul class="ad-list">
                  {r.components.recreated.slice(0, 8).map((x) => (
                    <li>
                      <span>
                        <code>{x.name}</code> <span class="muted small">{`${x.file}:${x.line}`}</span>
                      </span>
                      <span class="num">{x.instances}</span>
                    </li>
                  ))}
                </ul>
              </article>
            )}
          </div>

          <div class="section-head">
            <div>
              <h2>Top offending files</h2>
              <p>Files with the most hardcoded values and non-DS components. Start the migration here.</p>
            </div>
          </div>
          {r.topFiles.length === 0 ? (
            <p class="muted">Nothing to fix.</p>
          ) : (
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th scope="col">File</th>
                    <th scope="col" class="num">Hardcoded</th>
                    <th scope="col" class="num">Non-DS components</th>
                    <th scope="col" class="num">Token usages</th>
                    <th scope="col" class="num">DS components</th>
                  </tr>
                </thead>
                <tbody>
                  {r.topFiles.slice(0, 12).map((f) => (
                    <tr>
                      <th scope="row" class="ad-path">
                        <code>{f.path}</code>
                      </th>
                      <td class="num">{f.hardcoded}</td>
                      <td class="num">{f.otherComponents}</td>
                      <td class="num">{f.tokenUsages}</td>
                      <td class="num">{f.dsComponents}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          <div class="section-head">
            <div>
              <h2>Top fixes</h2>
              <p>The most repeated literals and the token that replaces them. Exact matches in CSS files can be fixed with <code>bridge audit --fix</code>.</p>
            </div>
          </div>
          {r.topFixes.length === 0 ? (
            <p class="muted">No repeated literal.</p>
          ) : (
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Value</th>
                    <th scope="col">Token</th>
                    <th scope="col">Confidence</th>
                    <th scope="col" class="num">Uses</th>
                    <th scope="col" class="num">Files</th>
                  </tr>
                </thead>
                <tbody>
                  {r.topFixes.slice(0, 15).map((f) => (
                    <tr>
                      <th scope="row">
                        <code>{f.value}</code> <span class="muted small">{f.category}</span>
                      </th>
                      <td>
                        {f.suggestion ? (
                          <span>
                            <code>{`var(${f.suggestion.cssVar})`}</code> <span class="muted small">{f.suggestion.value}</span>
                          </span>
                        ) : (
                          <span class="muted">No token fits</span>
                        )}
                      </td>
                      <td>
                        {f.suggestion ? (
                          <span class={`pill ${f.suggestion.level === 'exact' ? 'is-pass' : f.suggestion.level === 'high' ? 'is-info' : f.suggestion.level === 'medium' ? 'is-warn' : ''}`}>{f.suggestion.level}</span>
                        ) : (
                          <span class="pill is-fail">missing</span>
                        )}
                      </td>
                      <td class="num">{f.count}</td>
                      <td class="num">{f.files}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {r.baseline && (
            <p class="muted small">
              Since {r.baseline.label ?? date(r.baseline.generatedAt)}: hardcoded values {r.baseline.hardcoded.before} to {r.baseline.hardcoded.after} ({formatDelta(r.baseline.hardcoded.delta)}),{' '}
              {r.baseline.improved.length} files improved, {r.baseline.regressed.length} regressed, {r.baseline.newFiles.length} new.
            </p>
          )}
        </section>
      );
    })
  }

  {
    entries.length > 0 && (
      <section class="ad-trend" aria-labelledby="trend-title">
        <div class="section-head">
          <div>
            <h2 id="trend-title">Trend</h2>
            <p>Adoption across runs, from each report and the baselines it was compared with.</p>
          </div>
        </div>
        {trend.length < 2 ? (
          <p class="process-empty">
            One run so far. Run <code>bridge audit &lt;path&gt; --baseline previous.json --json next.json</code> to track progress.
          </p>
        ) : (
          <figure class="ad-card ad-trend-chart">
            <ul class="legend legend-inline ad-legend" aria-hidden="true">
              <li><span class="ad-key ad-tok" />Token adoption</li>
              <li><span class="ad-key ad-comp" />Component adoption</li>
            </ul>
            <svg viewBox={`0 0 ${TW} ${TH}`} role="img" aria-label={`Adoption trend: ${trend.map((p) => `${p.label} tokens ${formatPct(p.tokenAdoption)}, components ${formatPct(p.componentAdoption)}`).join('; ')}`}>
              {[0, 50, 100].map((v) => (
                <g>
                  <line x1={PAD.l} x2={TW - PAD.r} y1={ty(v)} y2={ty(v)} class="ad-grid" />
                  <text x={PAD.l - 6} y={ty(v)} class="ad-axis" text-anchor="end" dominant-baseline="central">{`${v}%`}</text>
                </g>
              ))}
              <polyline points={line('tokenAdoption')} class="ad-line ad-tok" />
              <polyline points={line('componentAdoption')} class="ad-line ad-comp" />
              {trend.map((p, i) => (
                <g>
                  {p.tokenAdoption !== null && <circle cx={tx(i)} cy={ty(p.tokenAdoption)} r="4" class="ad-dot ad-tok" />}
                  {p.componentAdoption !== null && <circle cx={tx(i)} cy={ty(p.componentAdoption)} r="4" class="ad-dot ad-comp" />}
                  <text x={tx(i)} y={TH - 8} class="ad-axis" text-anchor="middle">{date(p.generatedAt)}</text>
                </g>
              ))}
            </svg>
            <figcaption class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Run</th>
                    <th scope="col" class="num">Token adoption</th>
                    <th scope="col" class="num">Component adoption</th>
                    <th scope="col" class="num">Hardcoded</th>
                  </tr>
                </thead>
                <tbody>
                  {trend.map((p) => (
                    <tr>
                      <th scope="row">
                        {p.label} <span class="muted small">{date(p.generatedAt)}</span>
                      </th>
                      <td class="num">{formatPct(p.tokenAdoption)}</td>
                      <td class="num">{formatPct(p.componentAdoption)}</td>
                      <td class="num">{p.hardcoded}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </figcaption>
          </figure>
        )}
      </section>
    )
  }
</Layout>
