---
import '../../styles/github.css';
import '../../styles/reviews.css';
import Layout from '../../layouts/Layout.astro';
import GitHubConnect from '../../components/GitHubConnect.astro';
import GitHubDialog from '../../components/GitHubDialog.astro';
import Icon from '../../components/Icon.astro';
import { siteRepo } from '../../lib/config';
import { lastUpdated, readText } from '../../lib/repo';
import { CONTRAST_FILE } from '../../lib/contrast';

const r = siteRepo();
const checks = readText(CONTRAST_FILE).replace(/</g, '\\u003c');
---

<Layout
  title="Reviews"
  description="Open pull requests on the design system repo: token diffs with contrast before and after, CI, approvals, and review actions."
  sources={['docs/GOVERNANCE.md', '.github/CODEOWNERS']}
  updated={lastUpdated(['docs/GOVERNANCE.md', '.github/CODEOWNERS'])}
  wide
>
  <div class="rv">
    <p class="rv-notice" id="rv-notice" role="status" hidden></p>
    <div id="rv-list-view">
      <header class="rv-page-head">
        <div>
          <h1>Reviews <span class="rv-count num" id="rv-count" aria-label="open pull requests"></span></h1>
          <p class="lead">
            Open pull requests on <a href={`https://github.com/${r.owner}/${r.repo}/pulls`}><code>{r.owner}/{r.repo}</code></a>. Token changes read the
            way designers think about them: values, swatches and contrast before and after. Approve, comment or merge from here once GitHub is connected.
          </p>
        </div>
        <GitHubConnect />
      </header>
      <ul class="rv-list" id="rv-list" aria-label="Open pull requests" aria-busy="true">
        <li class="rv-skel" aria-hidden="true"></li>
        <li class="rv-skel" aria-hidden="true"></li>
        <li class="rv-skel" aria-hidden="true"></li>
      </ul>
      <aside class="rv-howto">
        <Icon name="shield" />
        <p>
          The same gates apply here as on GitHub: Tier 3 changes merge only with a design and a tech approval, and nothing merges while CI fails. A listed owner can merge past missing approvals only, with a reason posted on the pull request.
          <a href="/governance/">How review works</a>
        </p>
      </aside>
    </div>
    <div id="rv-detail" class="rv-detail" hidden></div>
  </div>

  <GitHubDialog />
  <script type="application/json" id="bridge-contrast" set:html={checks} />
  <script>
    import { initReviews } from '../../scripts/reviews';
    initReviews();
  </script>
</Layout>
