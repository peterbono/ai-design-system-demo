---
// The site's own not-found page (dist/404.html, which Vercel serves for any address no file or rewrite answers,
// including a team address that is not a Studio or Library route). It replaces Vercel's platform page, whose inline
// scripts the enforced Content-Security-Policy blocks, and keeps the visitor inside Bridge.
import Layout from '../layouts/Layout.astro';
import ButtonLink from '../components/ds/ButtonLink';
---

<Layout title="Page not found" description="This address does not match any page of Bridge." crumbs={false}>
  <h1>Page not found</h1>
  <p>This address does not match any page. It may have moved, or the link has a typo.</p>
  <p>
    <ButtonLink href="/" variant="primary">Go to the home page</ButtonLink>
    <ButtonLink href="/library/">Open the Library</ButtonLink>
  </p>
</Layout>
