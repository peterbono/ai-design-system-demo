---
import '../../styles/explorer.css';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Updated from '../../components/Updated.astro';
import { explorerTokens, previewKind, type ExplorerToken } from '../../lib/explorer';
import { PAGE_SOURCES, freshness } from '../../lib/sources';

const updated = freshness(PAGE_SOURCES.lookup);
const tokens = explorerTokens().map((t) => ({ ...t, kind: previewKind(t) }));
const layers = [
  { key: 'semantic', label: 'Semantic', note: 'Tokens with a job. They point to a different primitive in each theme. Design and build with these.' },
  { key: 'primitive', label: 'Primitives', note: 'The raw scales and palette. Semantic tokens point here; components rarely should.' },
] as const;

const typeCounts = [...tokens.reduce((m, t) => m.set(t.type, { label: t.typeLabel, n: (m.get(t.type)?.n ?? 0) + 1 }), new Map<string, { label: string; n: number }>())]
  .sort((a, b) => b[1].n - a[1].n);
const unusedCount = tokens.filter((t) => !t.used).length;
const searchText = (t: ExplorerToken) =>
  [t.path, t.cssVar, t.figma, t.value, t.hex ?? '', ...(t.modes ? Object.values(t.modes).flatMap((m) => [m.css, m.hex ?? '', ...m.chain]) : [])].join(' ').toLowerCase();
const shortValue = (t: ExplorerToken) =>
  t.modes ? (t.modes.light.css === t.modes.dark.css ? t.modes.light.css : `${t.modes.light.hex ?? t.modes.light.css} / ${t.modes.dark.hex ?? t.modes.dark.css}`) : (t.hex ?? t.value);
const json = JSON.stringify(tokens).replace(/</g, '\\u003c');
---

<Layout title="Token explorer" description="Every token in the system: filter, search and open one to see its alias chain, values, contrast and usage." sources={PAGE_SOURCES.lookup} updated={updated} wide>
  <div class="tx">
    <header class="tx-head">
      <div>
        <h1>Token explorer</h1>
        <p class="lead">
          All {tokens.length} tokens, straight from the token files. Open one to follow its alias chain in both themes, check its contrast pairs and
          see which components would change with it.
        </p>
        <Updated date={updated} />
      </div>
    </header>

    <div class="tx-toolbar" role="search">
      <label class="tx-search">
        <Icon name="search" size={18} />
        <span class="sr-only">Search tokens</span>
        <input id="tx-q" type="search" placeholder="Name, CSS variable, Figma name or hex" autocomplete="off" spellcheck="false" />
      </label>
      <div class="tx-seg" role="group" aria-label="Layer" data-filter="layer">
        <button type="button" data-value="" aria-pressed="true">All layers</button>
        <button type="button" data-value="semantic" aria-pressed="false">Semantic</button>
        <button type="button" data-value="primitive" aria-pressed="false">Primitive</button>
      </div>
      <div class="tx-seg" role="group" aria-label="Usage" data-filter="usage">
        <button type="button" data-value="" aria-pressed="true">Any usage</button>
        <button type="button" data-value="used" aria-pressed="false">In use</button>
        <button type="button" data-value="unused" aria-pressed="false">Unused <span class="tx-n">{unusedCount}</span></button>
      </div>
    </div>
    <div class="tx-types" role="group" aria-label="Type" data-filter="type">
      <button type="button" data-value="" aria-pressed="true">All types <span class="tx-n">{tokens.length}</span></button>
      {
        typeCounts.map(([key, v]) => (
          <button type="button" data-value={key} aria-pressed="false">
            {v.label} <span class="tx-n">{v.n}</span>
          </button>
        ))
      }
    </div>

    <p class="tx-count" id="tx-count" aria-live="polite">{tokens.length} tokens</p>

    {
      layers.map((layer) => {
        const list = tokens.filter((t) => t.layer === layer.key);
        return (
          <section class="tx-section" data-layer-section={layer.key} aria-labelledby={`tx-h-${layer.key}`}>
            <div class="tx-section-head">
              <h2 id={`tx-h-${layer.key}`}>
                {layer.label} <span class="tx-section-n" data-section-count>{list.length}</span>
              </h2>
              <p>{layer.note}</p>
            </div>
            <ul class="tx-grid" role="list">
              {list.map((t) => (
                <li class="tk" data-path={t.path} data-type={t.type} data-layer={t.layer} data-used={t.used ? 'used' : 'unused'} data-search={searchText(t)}>
                  <button type="button" class="tk-card" data-open={t.path} aria-haspopup="dialog">
                    <span class={`tk-preview kind-${t.kind}`} aria-hidden="true">
                      {t.kind === 'color' &&
                        (t.layer === 'semantic' ? (
                          <span class="pv-split">
                            <span data-theme="light" style={`background-color: var(${t.cssVar})`} />
                            <span data-theme="dark" style={`background-color: var(${t.cssVar})`} />
                          </span>
                        ) : (
                          <span class="pv-fill" style={`background-color: var(${t.cssVar})`} />
                        ))}
                      {t.kind === 'shadow' &&
                        (t.layer === 'semantic' ? (
                          <span class="pv-split pv-shadow-split">
                            <span data-theme="light"><i style={`box-shadow: var(${t.cssVar})`} /></span>
                            <span data-theme="dark"><i style={`box-shadow: var(${t.cssVar})`} /></span>
                          </span>
                        ) : (
                          <span class="pv-shadow-solo" data-theme={t.path.endsWith('strong') ? 'dark' : 'light'}>
                            <i style={`box-shadow: var(${t.cssVar})`} />
                          </span>
                        ))}
                      {t.kind === 'radius' && <span class="pv-corner" style={`border-top-left-radius: var(${t.cssVar})`} />}
                      {t.kind === 'stroke' && <span class="pv-stroke" style={`border-top-width: var(${t.cssVar})`} />}
                      {t.kind === 'space' && (
                        <span class="pv-space">
                          <span style={`width: var(${t.cssVar})`} />
                        </span>
                      )}
                      {t.kind === 'size' && <span class="pv-text" style={`font-size: var(${t.cssVar})`}>Ag</span>}
                      {t.kind === 'family' && <span class="pv-text" style={`font-family: var(${t.cssVar})`}>Ag</span>}
                      {t.kind === 'weight' && <span class="pv-text" style={`font-weight: var(${t.cssVar})`}>Ag</span>}
                      {t.kind === 'number' && (
                        <span class="pv-leading" style={`line-height: var(${t.cssVar})`}>
                          Tokens decide,
                          <br />
                          Figma explores.
                        </span>
                      )}
                    </span>
                    <span class="tk-body">
                      <span class="tk-name">{t.path}</span>
                      <span class="tk-value">{shortValue(t)}</span>
                      <span class="tk-meta">
                        <span>{t.typeLabel}</span>
                        {!t.used && <span class="pill is-warn">Unused</span>}
                        {t.deprecated && <span class="pill is-fail">Deprecated</span>}
                        {t.usedBy.length > 0 && (
                          <span class="tk-users">
                            {t.usedBy.length} component{t.usedBy.length > 1 ? 's' : ''}
                          </span>
                        )}
                      </span>
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }

    <div class="tx-empty" id="tx-empty" hidden>
      <Icon name="search" size={28} />
      <h2>No token matches these filters</h2>
      <p>Try a shorter name, a hex value like <code>#3449cc</code>, or clear the filters. If a value came from a mockup and is not here, it is not in the system.</p>
      <button type="button" class="btn btn-secondary btn-sm" id="tx-clear">Clear filters</button>
    </div>
  </div>

  <dialog class="tx-drawer" id="tx-drawer" aria-labelledby="tx-d-title">
    <div class="tx-d-inner">
      <div class="tx-d-bar">
        <span class="tx-d-crumb">Token</span>
        <button type="button" class="icon-btn" id="tx-d-close" aria-label="Close token details"><Icon name="close" /></button>
      </div>
      <div class="tx-d-body" id="tx-d-body"></div>
    </div>
  </dialog>

  <script type="application/json" id="tx-data" set:html={json} />
  <script>
    import { initExplorer } from '../../scripts/explorer';
    initExplorer();
  </script>
</Layout>
