---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import TokenExplorerSlot from '../../components/TokenExplorerSlot.astro';
import Updated from '../../components/Updated.astro';
import { explorerTokens } from '../../lib/explorer';
import { PAGE_SOURCES, freshness } from '../../lib/sources';

const updated = freshness(PAGE_SOURCES.explorer);
const total = explorerTokens().length;
---

<Layout title="Token explorer" description="Every token in the system: filter, search by name or hex, and open one to see its alias chain, values, contrast and usage." sources={PAGE_SOURCES.explorer} updated={updated} wide>
  <script is:inline>
    // Old links to the editor (/tokens/?edit=1) now open Studio Tokens.
    (function () {
      var p = new URLSearchParams(location.search);
      if (p.get('edit') === '1') { p.delete('edit'); var q = p.toString(); location.replace('/studio/tokens/' + (q ? '?' + q : '') + location.hash); }
    })();
  </script>
  <header class="page-head">
    <div>
      <h1>Token explorer</h1>
      <p class="lead">
        All {total} tokens across five tiers, straight from the token files of the latest release. Search by name, CSS variable, Figma name or
        a hex from a mockup, then open a token to follow its alias chain in both themes and brands, check its contrast pairs and see which
        components use it.
      </p>
      <Updated date={updated} />
    </div>
    <div class="page-head-actions">
      <a class="btn btn-secondary" href="/studio/tokens/"><Icon name="edit" size={16} />Edit in Studio</a>
    </div>
  </header>
  <TokenExplorerSlot mode="read" />
</Layout>
