---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Updated from '../../components/Updated.astro';
import TokenExplorer from '../../components/explorer/TokenExplorer.astro';
import TokenEditorKit from '../../components/explorer/TokenEditorKit.astro';
import { PAGE_SOURCES, freshness } from '../../lib/sources';
import { loadTokens } from '../../lib/tokens';

const updated = freshness(PAGE_SOURCES.lookup);
const { primitives, all } = loadTokens();
const total = primitives.length + all.length;
---

<Layout title="Token explorer" description="Every token in the system by collection or type, with its value in every mode, alias chain, contrast and usage." sources={PAGE_SOURCES.lookup} updated={updated} wide>
  <div class="xp-page">
    <header class="xp-page-head">
      <div>
        <h1>Token explorer</h1>
        <p class="lead">
          All {total} tokens in the same collections the Figma plugin creates, one column per mode. Select a token to follow its alias chain, its contrast pairs and the
          components that read it.
        </p>
        <Updated date={updated} />
      </div>
      <button type="button" class="btn btn-primary tx-edit-toggle" id="tx-edit-toggle" aria-pressed="false">
        <Icon name="sliders" size={16} /><span class="when-off">Edit tokens</span><span class="when-on">Done editing</span>
      </button>
    </header>
    <p class="ed-banner ed-only">
      <Icon name="pr" size={18} />
      <span>
        Edit mode. Select a value cell and press Enter to change it. Edits stay in this browser as a draft, contrast and guardrails update as you go, and nothing reaches the
        repo until you propose a pull request and it is reviewed.
      </span>
    </p>
    <TokenExplorer mode="read" />
  </div>
  <TokenEditorKit />
</Layout>
