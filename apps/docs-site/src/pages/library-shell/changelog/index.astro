---
// Library shell, Changelog (lib/library-shells.ts LIBRARY_USE_PAGES): served for /library/<owner>/<repo>/changelog/. The
// same view as Bridge's own page, with what the team publishes (components/ds/library/LibraryTeamUse.tsx) and the
// Bridge tools of this build, then the team's token and guidance changes (components/TokenChanges.astro, read only).
import LibraryShell from '../../../components/LibraryShell.astro';
import LibraryTeamUse from '../../../components/ds/library/LibraryTeamUse';
import { bridgeTools } from '../../../lib/library-use';
import TokenChanges from '../../../components/TokenChanges.astro';
---

<LibraryShell title="Changelog" description="What changed in each release of a team's design system, with an announcement ready to post." reading>
  <LibraryTeamUse page="changelog" bridge={bridgeTools()} client:load />
  <TokenChanges />
</LibraryShell>
