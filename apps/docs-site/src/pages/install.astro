---
// Library > Use > Install: the shared view (components/ds/library/views/InstallView.tsx), rendered at build time.
import Layout from '../layouts/Layout.astro';
import InstallView from '../components/ds/library/views/InstallView';
import { siteLibraryData } from '../lib/library-site';
import { INSTALL_SOURCES, siteUseExtras } from '../lib/library-use';
import { freshness } from '../lib/sources';
import '../styles/process.css';
import '../styles/connect.css';
import '../styles/library.css';

const updated = freshness(INSTALL_SOURCES);
---

<Layout title="Install" description="Install the Bridge packages from npm in a product, or the DS Bridge Figma plugin." sources={INSTALL_SOURCES} updated={updated}>
  <InstallView data={siteLibraryData({ use: siteUseExtras() })} />
</Layout>
