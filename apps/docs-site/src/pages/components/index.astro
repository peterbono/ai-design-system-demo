---
import '../../styles/component.css';
import '../../styles/library.css';
import Layout from '../../layouts/Layout.astro';
import Example from '../../components/Example.tsx';
import { Badge, Link } from '@bridge-ds/react';
import { loadComponents, type ComponentInfo } from '../../lib/components';
import { freshness, PAGE_SOURCES } from '../../lib/sources';

const components = loadComponents();
const updated = freshness(PAGE_SOURCES.components);
const groups = new Map<string, ComponentInfo[]>();
for (const c of components) {
  const cat = c.category;
  if (!groups.has(cat)) groups.set(cat, []);
  groups.get(cat)!.push(c);
}
const documented = components.filter((c) => c.docs).length;
const statusOf = (c: ComponentInfo) => c.docs?.status ?? 'stable';
const toneOf = (s: string) => (s === 'stable' ? 'success' : s === 'beta' ? 'info' : 'warning');
const label = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const famSlug = (label: string) => label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const plural = (n: number, w: string, many = `${w}s`) => `${n} ${n === 1 ? w : many}`;
import LibraryHeader from '../../components/LibraryHeader.astro';
import { studioHref } from '../../lib/team-path';
---

<Layout title="Components" description="Every component, with usage guidance, accessibility notes and the tokens it reads." sources={PAGE_SOURCES.components} updated={updated}>
  <LibraryHeader title="Components" art="components" updated={updated} studio={studioHref('components/')} studioLabel="Open in Studio">
    {plural(components.length, 'component')} in {plural(groups.size, 'family', 'families')}. Each page has the same tabs: Usage (when to use it, do and don't, accessibility), Tokens, Code (props and a playground) and Changelog. Guidance first, specs second.
  </LibraryHeader>
  <p class="gallery-stats">
    <Badge>{plural(components.length, 'component')}</Badge>
    <Badge tone="success">{documented} with usage guidance</Badge>
    {components.length - documented > 0 && <Badge tone="warning">{components.length - documented} missing guidance</Badge>}
  </p>

  {
    [...groups.entries()].map(([cat, list]) => (
      <details class="gallery-group family" id={`fam-${famSlug(cat)}`} open>
        <summary>
          <h2>{cat}</h2>
          <span class="family-count">{list.length}</span>
        </summary>
        <ul class="gallery">
          {list.map((c) => (
            <li class="gcard">
              <div class="gcard-stage stage-checker" data-theme="light" aria-hidden="true" inert>
                {c.docs?.preview ? <Example node={c.docs.preview} /> : <span class="gcard-empty">No preview yet</span>}
              </div>
              <div class="gcard-body">
                <div class="gcard-title">
                  <h3>
                    <Link href={`/components/${c.slug}/`}>{c.name}</Link>
                  </h3>
                  <Badge tone={toneOf(statusOf(c))} size="sm">{label(statusOf(c))}</Badge>
                </div>
                <p>{c.docs?.summary ?? c.description ?? 'No usage guidance yet.'}</p>
                <dl class="gcard-stats">
                  <div>
                    <dt>Props</dt>
                    <dd class="num">{c.props.length}</dd>
                  </div>
                  <div>
                    <dt>Tokens</dt>
                    <dd class="num">{c.allTokenPaths.length}</dd>
                  </div>
                  <div>
                    <dt>Stories</dt>
                    <dd class="num">{c.stories.length}</dd>
                  </div>
                </dl>
              </div>
            </li>
          ))}
        </ul>
      </details>
    ))
  }
  <script>
    // A link to /components/#fam-forms opens that family even if it was collapsed.
    const open = () => {
      const el = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
      if (el instanceof HTMLDetailsElement) {
        el.open = true;
        el.scrollIntoView();
      }
    };
    window.addEventListener('hashchange', open);
    open();
  </script>
</Layout>
