---
// Library > Components: the shared view (components/ds/library/views/ComponentsView.tsx), rendered at build time, with
// the search and family filter as an island.
import '../../styles/component.css';
import '../../styles/library.css';
import '../../styles/team-components.css';
import Layout from '../../layouts/Layout.astro';
import Example from '../../components/Example.tsx';
import ComponentsView, { componentFamilies } from '../../components/ds/library/views/ComponentsView';
import ComponentFilter from '../../components/ds/library/ComponentFilter';
import { siteComponentExtras, siteLibraryData } from '../../lib/library-site';
import { freshness, PAGE_SOURCES } from '../../lib/sources';

const data = siteLibraryData(siteComponentExtras());
const updated = freshness(PAGE_SOURCES.components);
---

<Layout title="Components" description="Every component, with usage guidance, accessibility notes and the tokens it reads." sources={PAGE_SOURCES.components} updated={updated}>
  <ComponentsView data={data} Example={Example}>
    <ComponentFilter slot="tools" client:idle families={componentFamilies(data)} />
  </ComponentsView>
  <script>
    import { initComponentsIndex } from '../../scripts/component-page';
    initComponentsIndex();
  </script>
</Layout>
