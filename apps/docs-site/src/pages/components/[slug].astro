---
// Library > Components > one component: the shared view (components/ds/library/views/ComponentView.tsx), rendered at
// build time. The islands it cannot hydrate itself come in as slots (the preview brand and density menu, the props
// playground); edit mode (?edit=1, maintainers) stays on this page.
import '../../styles/component.css';
import '../../styles/library.css';
import '../../styles/library-edit.css';
import Layout from '../../layouts/Layout.astro';
import Example from '../../components/Example.tsx';
import PropsPlayground from '../../components/PropsPlayground.tsx';
import ComponentView from '../../components/ds/library/views/ComponentView';
import LibraryEditMode from '../../components/LibraryEditMode';
import GitHubDialog from '../../components/GitHubDialog.astro';
import PreviewScope from '../../components/PreviewScope.astro';
import { loadComponents, playgroundSpec, type ComponentInfo } from '../../lib/components';
import { mainStory, previewScopes } from '../../lib/library/component-page';
import { lastUpdated, exists, readText } from '../../lib/repo';
import { componentPrefill } from '../../lib/docs-prefill';
import { siteRepo } from '../../lib/config';
import { siteComponentExtras, siteLibraryData } from '../../lib/library-site';

export function getStaticPaths() {
  return loadComponents().map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: ComponentInfo };
const data = siteLibraryData(siteComponentExtras());
const sources = Object.values(c.files);
const updated = lastUpdated(sources);
const spec = playgroundSpec(c);
const story = mainStory(c);
const scopes = previewScopes(data.model);
// Edit mode (?edit=1, maintainers): the docs on main, or the deterministic pre-fill when there are none.
const originalDocs = exists(c.files.docs) ? readText(c.files.docs) : null;
const editInitial = originalDocs ? JSON.parse(originalDocs) : componentPrefill(c).draft;
const repo = siteRepo();
---

<Layout title={c.name} description={c.docs?.summary ?? c.description} sources={sources} updated={updated} crumbs={[{ label: 'Catalog', href: '/components/' }, { label: c.name }]} toc={false}>
  <ComponentView data={data} component={c} Example={Example}>
    <PreviewScope slot="heroTools" />
    {spec && story && data.extras.storybook && <PropsPlayground slot="playground" client:visible spec={spec} storybook={data.extras.storybook} storyId={story.id} brands={scopes.brands} densities={scopes.densities} />}
  </ComponentView>
  <LibraryEditMode client:only="react" name={c.name} slug={c.slug} path={c.files.docs} original={originalDocs} initial={editInitial} repo={{ owner: repo.owner, repo: repo.repo }} />
  <GitHubDialog />

  <script>
    import { initComponentPage } from '../../scripts/component-page';
    initComponentPage();
  </script>
</Layout>
