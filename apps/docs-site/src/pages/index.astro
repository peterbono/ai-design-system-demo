---
// The homepage, ported from the owner's validated test page (2026-10-21): one promise you can drag ("Keep what works":
// move the bridge to keep the profile header your exploration added), two step-tab sections (start in Bridge, ship) and
// "One system everyone can trust", the design system lead's queue, and the Horizon closing (Florian carries the kept card across
// the bridge). Every drawing is decorative markup with a spoken label; the controls are DS components, except the
// hero range input and the step tabs (see their audit comments). Behaviour: scripts/homepage.ts, pure parts in
// lib/homepage.ts. The Library home is at /library/ (lib/nav LIBRARY_HOME).
import '../styles/homepage.css';
import Landing from '../layouts/Landing.astro';
import ButtonLink from '../components/ds/ButtonLink';
import { Link } from '@bridge-ds/react';
import { ArrowRight } from 'lucide-react';
import HpSprite from '../components/home/HpSprite.astro';
import HpPencil from '../components/home/HpPencil.astro';
import HpGhost from '../components/home/HpGhost.astro';
import HpProfile from '../components/home/HpProfile.astro';
import HpStepSection from '../components/home/HpStepSection.astro';
import HpSieve from '../components/home/HpSieve.astro';
import HpSignoff from '../components/home/HpSignoff.astro';
import HpQueue from '../components/home/HpQueue.astro';
import HpFaq from '../components/home/HpFaq';
import HpFaqArt from '../components/home/HpFaqArt.astro';
import HpPanorama from '../components/home/HpPanorama.astro';
import HpWalkers from '../components/home/HpWalkers.astro';
import { DEMO, STUDIO_HOME } from '../lib/nav';

const handles = [
  [157, 33],
  [376, 33],
  [157, 132],
  [376, 132],
];
const code = '<s>import</s> { <em>ProfileHeader</em> }\n  <s>from</s> "@bridge-ds/react";\n\n&lt;<em>ProfileHeader</em>\n  name="Ann Leroy"\n  role="Product designer"\n/&gt;';
---

<Landing
  title="Bridge: explore with AI, keep what works in your design system"
  description="Bridge finds what your exploration added. You review it, then the code and Figma kit follow."
>
  <div class="hp">
    <HpSprite />

    <!-- Hero: the promise, then the bridge you drag to keep the piece. -->
    <section class="hp-hero hp-wrap" aria-labelledby="hp-title" data-hero>
      <div class="hp-hero-text">
        <h1 id="hp-title" class="hp-h1">
          <span class="hp-hl">Explore with AI. </span><span class="hp-hl hp-hk"><span class="hp-keep">Keep<svg class="hp-ul" viewBox="0 0 150 18" preserveAspectRatio="none" aria-hidden="true"><path d="M3 12C28 6 66 3.5 104 6.5S140 11 147 7" pathLength="1"></path></svg></span> what works </span><span class="hp-hl">in your design system.</span>
        </h1>
        <p class="hp-lede"><span class="hp-hs">Bridge finds what your exploration added. </span><span class="hp-hs">You review it, then the code and Figma kit follow.</span></p>
        <div class="hp-go">
          <ButtonLink variant="primary" size="lg" iconEnd={ArrowRight} href={STUDIO_HOME}>Get started</ButtonLink>
          {/* TODO: point to /demo/ once the read-only demo has its own route (lib/nav DEMO). */}
          <Link variant="standalone" className="hp-demo" href={DEMO}><span class="hp-dl">Explore the demo</span><span class="hp-dc">No account needed</span></Link>
        </div>
      </div>
      <div class="hp-hero-vis">
        <div class="hp-fit" data-fit="540">
          <div class="hp-stage" data-stage>
            <HpPencil />
            <div class="hp-crr">
              <HpGhost />
              <HpProfile card class="hp-stage-card" />
              <span class="hp-hsel" aria-hidden="true"></span>
              {handles.map(([l, t]) => <span class="hp-hh" style={`--l: ${l}; --t: ${t}`} aria-hidden="true" />)}
              <span class="hp-tag hp-htag" aria-hidden="true"><svg><use href="#hp-comp" /></svg>Profile header</span>
              <span class="hp-hlib" aria-hidden="true"><svg><use href="#hp-lib" /></svg>Library</span>
              <span class="hp-stamp" aria-hidden="true"><svg><use href="#hp-check" /></svg>Kept</span>
            </div>
            <div class="hp-handle" aria-hidden="true">
              <span class="hp-ln"></span>
              <span class="hp-kn"><svg viewBox="0 0 24 24"><path d="M9 7l-5 5 5 5M15 7l5 5-5 5"></path></svg></span>
              <span class="hp-ln"></span>
            </div>
            <!-- bridge-audit-ignore-next-line: the whole drawing is the slider: an invisible native range input over the before and after stage, with the bridge handle as its visible thumb; the DS Slider is a track with its own thumb and would need its internals restyled (Slider "compare" appearance requested in the PR) -->
            <input class="hp-rng" type="range" min="0" max="100" step="1" value="50" aria-label="Keep the profile header: move the bridge left to keep it in your design system" aria-valuetext="Half exploration, half design system" data-range />
          </div>
        </div>
        <p class="hp-hcap" aria-live="polite"><span class="hp-d">Drag: your explorations / your design system</span><span class="hp-k">Kept in your design system.</span></p>
      </div>
      <span class="hp-kline" aria-hidden="true" data-kline></span>
    </section>

    <div id="steps">
      <HpStepSection
        id="hp-b1"
        title="Start it in Bridge. Every change is tracked."
        lede="Explore with Claude AI as usual. Bridge tracks what it changes in your system."
        steps={[
          { title: 'Start your exploration from Bridge', text: 'Pick the product, link the Jira ticket, start with Claude AI. It works on its own branch, with its own preview.' },
          { title: 'Bridge traces what changed', text: 'New pieces, changed tokens, values written by hand: everything the exploration did to your design system is listed.' },
          { title: 'Your DS lead reviews just that', text: 'No screenshots to compare. The DS lead and a developer review exactly those changes, in the product, with contrast checked.' },
        ]}
        labels={[
          'Create branch dialog: A feature in a product is selected, with a field to link a Jira ticket and a Start with Claude AI button',
          'A sieve labelled Bridge: the pieces your library already has, an avatar, text and a Follow button, fall through; the new Profile header is caught on top. New, Bridge keeps it',
          'The new Profile header, contrast passing in light and dark, and two people ticking it off: Dana for design, Leo for code',
        ]}
      >
        <div slot="p0" class="hp-card hp-dlg">
          <span class="hp-xs hp-muted">Create branch</span>
          <strong class="hp-dt">What are you working on?</strong>
          <div class="hp-opt hp-pick"><span class="hp-radio"></span><span><strong>A feature in a product</strong><small>A new screen or flow, built with your library.</small></span></div>
          <div class="hp-opt"><span class="hp-radio"></span><span><strong>A change to the library</strong><small>A token, a variant or a component.</small></span></div>
          <div class="hp-jira"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Link a Jira ticket</div>
          <div class="hp-row hp-dlg-foot"><span class="hp-sp"></span><span class="hp-btn hp-btn-line">Cancel</span><span class="hp-btn hp-btn-deep hp-ring"><span class="hp-ai"><svg aria-hidden="true"><use href="#hp-robot" /></svg></span>Start with Claude AI</span></div>
        </div>
        <div slot="p1" class="hp-sc hp-sc-center"><HpSieve /></div>
        <div slot="p2" class="hp-sc hp-sc-center"><HpSignoff /></div>
      </HpStepSection>

      <HpStepSection
        id="hp-b3"
        flip
        title="Ship it everywhere at once."
        lede="Merge once. The code is published and your Figma kit follows."
        steps={[
          { title: 'Merge', text: 'Design and code approved, contrast checked, other products unchanged. One merge.' },
          { title: 'The code is published', text: 'The Profile header ships in @bridge-ds/react, ready to import.' },
          { title: 'Your Figma kit follows', text: 'One Pull in the DS Bridge plugin brings it into the Figma kit.' },
        ]}
        labels={[
          'Library branch Profile header, contrast checked and approved by Dana and Leo; Merge is pressed and the branch shows Merged',
          'The Profile header component page: its preview, the import from @bridge-ds/react and the code ProfileHeader name Ann Leroy role Product designer',
          'DS Bridge plugin in Figma, Pull tab: Profile header, new component, is pulled and marked Added; the fidelity check confirms the Figma kit matches the code',
        ]}
      >
        <div slot="p0" class="hp-card hp-mcard">
          <div class="hp-mtop"><span class="hp-xs hp-muted">Library branch</span><span class="hp-state"><span class="hp-s-open">Open</span><span class="hp-s-mrg"><svg aria-hidden="true"><use href="#hp-check" /></svg>Merged</span></span></div>
          <strong class="hp-mt">Profile header</strong>
          <div class="hp-thumb"><HpProfile card /></div>
          <ul class="hp-checks">
            <li><svg aria-hidden="true"><use href="#hp-check" /></svg>Contrast passes in light and dark</li>
            <li><span class="hp-avs"><span class="hp-av hp-av-xs hp-grey">D</span><span class="hp-av hp-av-xs hp-grey">L</span></span>Design and code approved</li>
          </ul>
          <span class="hp-obtn hp-press"><span class="hp-a">Merge</span><span class="hp-b"><svg aria-hidden="true"><use href="#hp-check" /></svg>Merged</span></span>
        </div>
        <div slot="p1" class="hp-card hp-cpage">
          <div class="hp-row hp-wrap-row"><strong class="hp-mt">Profile header</strong><span class="hp-flag">Published</span><span class="hp-sp"></span><span class="hp-mono hp-pkg">@bridge-ds/react</span></div>
          <div class="hp-thumb"><HpProfile card /></div>
          <pre class="hp-code hp-mono" set:html={code} />
        </div>
        <div slot="p2" class="hp-card hp-plug">
          <div class="hp-plugbar"><svg class="hp-lg" aria-hidden="true"><use href="#hp-logo" /></svg>DS Bridge<span class="hp-x" aria-hidden="true">×</span></div>
          <div class="hp-ptabs2"><span class="hp-on">Pull</span><span>Push</span></div>
          <div class="hp-plugbody">
            <div class="hp-plugrow"><span class="hp-mini"><HpProfile card /></span><span class="hp-t"><strong>Profile header</strong><small>New component</small></span><span class="hp-added"><svg aria-hidden="true"><use href="#hp-check" /></svg>Added</span></div>
            <span class="hp-obtn hp-press"><span class="hp-a">Pull</span><span class="hp-b"><svg aria-hidden="true"><use href="#hp-check" /></svg>Pulled</span></span>
            <span class="hp-kitn"><span class="hp-k1">1 new component from the code</span><span class="hp-k2"><svg aria-hidden="true"><use href="#hp-check" /></svg>Fidelity check: Figma kit matches the code</span></span>
          </div>
        </div>
      </HpStepSection>

      <HpStepSection
        id="hp-b4"
        title="One system everyone can trust."
        lede="The library documents itself, stays the same in Figma and in code, and shows how much of it your products really use."
        steps={[
          { title: 'A library everyone can read', text: 'Public docs for every component. Claude AI drafts the guidance from the code, a person reviews it before it ships.' },
          { title: 'Same components in Figma and Storybook', text: 'Both come from the same coded components. A fidelity check confirms they match.' },
          { title: 'Know how much your products use it', text: 'An audit per product measures how much of it runs on your components and tokens.' },
        ]}
        labels={[
          'The public Library page of the Profile header: its preview and usage guidance, tagged Drafted by Claude AI, reviewed by Dana',
          'The same Profile header in two windows, Figma kit and Storybook, joined by a Matches check',
          'Quality view, adoption by product: Docs site at 100 percent, was 81.7 percent before the audit; Admin demo audited',
        ]}
      >
        <div slot="p0" class="hp-card hp-lib">
          <div class="hp-row"><span class="hp-xs hp-muted">Library</span><span class="hp-xs hp-muted" aria-hidden="true">/</span><span class="hp-xs hp-muted">Components</span><span class="hp-sp"></span><span class="hp-flag">Public</span></div>
          <strong class="hp-mt">Profile header</strong>
          <div class="hp-thumb"><HpProfile card /></div>
          <div class="hp-guide hp-asm" style="--d: 1"><strong>Usage</strong><p>Open a member profile with it.</p><p>Keep one Follow button per header.</p></div>
          <span class="hp-drafted"><span class="hp-ai hp-ai-sm"><svg aria-hidden="true"><use href="#hp-robot" /></svg></span>Drafted by Claude AI <i aria-hidden="true">·</i> reviewed by Dana</span>
        </div>
        <div slot="p1" class="hp-twin">
          <div class="hp-pair">
            <div class="hp-mwin hp-fg hp-asm" style="--d: 0"><div class="hp-mbar"><span class="hp-dots"><i></i><i></i><i></i></span><strong>Figma kit</strong></div><div class="hp-mcv"><HpProfile card /></div></div>
            <div class="hp-mwin hp-asm" style="--d: 1"><div class="hp-mbar"><span class="hp-dots"><i></i><i></i><i></i></span><strong>Storybook</strong></div><div class="hp-mcv"><HpProfile card /></div></div>
            <span class="hp-match"><svg aria-hidden="true"><use href="#hp-check" /></svg>Matches</span>
          </div>
          <p class="hp-tnote"><svg aria-hidden="true"><use href="#hp-check" /></svg>Fidelity check on every component</p>
        </div>
        <div slot="p2" class="hp-card hp-qual">
          <div class="hp-row"><span class="hp-xs hp-muted">Quality</span></div>
          <strong class="hp-mt">Design system adoption</strong>
          <p class="hp-qsub">Components and tokens in use, per product</p>
          <div class="hp-adrow">
            <div class="hp-adhd"><strong>Docs site</strong><span class="hp-qnum"><span class="hp-n1">81.7%</span><span class="hp-n2">100%</span></span></div>
            <span class="hp-qbar"><i></i></span>
            <small class="hp-was">Was 81.7% before the audit</small>
          </div>
          <div class="hp-adrow hp-q2">
            <div class="hp-adhd"><strong>Admin demo</strong><span class="hp-aud"><svg aria-hidden="true"><use href="#hp-check" /></svg>Audited</span></div>
          </div>
        </div>
      </HpStepSection>
    </div>

    <!-- The design system lead: the queue, played for real. -->
    <section class="hp-lead" aria-labelledby="hp-lead-t">
      <div class="hp-wrap hp-leadg">
        <div class="hp-leadt">
          <p class="hp-who"><span class="hp-av hp-av-sm hp-grey" aria-hidden="true">D</span>For the design system lead</p>
          <h2 id="hp-lead-t" class="hp-st-h">Stop reviewing screenshots in Slack.</h2>
          <p class="hp-st-p">Every change from designers and Claude AI waits in one queue, shown as the real change with its checks already run. 304&nbsp;contrast checks and accessibility tests run on every change.</p>
        </div>
        <HpQueue />
      </div>
    </section>

    <!-- Questions teams ask: the DS Accordion, one open at a time. -->
    <section class="hp-faq" aria-labelledby="hp-faq-t">
      <div class="hp-wrap hp-faqgrid">
        <div class="hp-faqside">
          <h2 id="hp-faq-t" class="hp-faqh">Questions teams ask.</h2>
          <HpFaqArt />
        </div>
        <HpFaq client:visible />
      </div>
    </section>

    <!-- Closing: Horizon. Florian carries the kept card across the bridge; hover or focus pauses the walk. -->
    <section class="hp-closing" aria-labelledby="hp-close-t">
      <div class="hp-wrap hp-hz-text">
        <p class="hp-eyebrow">Open source · MIT</p>
        <h2 id="hp-close-t" class="hp-hz-h">Explore freely. <span class="hp-keep">Keep<svg class="hp-ul hp-ul-late" viewBox="0 0 150 18" preserveAspectRatio="none" aria-hidden="true"><path d="M3 12C28 6 66 3.5 104 6.5S140 11 147 7" pathLength="1"></path></svg></span> what works.</h2>
        <p class="hp-hz-p">Your next exploration is one branch away.</p>
        <div class="hp-hz-cta"><ButtonLink variant="primary" size="lg" iconEnd={ArrowRight} href={STUDIO_HOME}>Get started</ButtonLink></div>
      </div>
      <div class="hp-pano" data-pano>
        <div class="hp-hz-stage" data-pano-stage>
          <HpPanorama />
          <div class="hp-walk">
            <div class="hp-bob">
              <HpWalkers />
              <div class="hp-fgcard">
                <span class="hp-av hp-av-lg">FG</span>
                <span class="hp-pt">
                  <strong>Florian Gouloubi</strong>
                  <small>Senior Product Designer</small>
                  <ButtonLink variant="primary" size="sm" href="https://www.linkedin.com/in/floriangouloubi/" target="_blank" rel="noopener" aria-label="Connect with Florian Gouloubi on LinkedIn (opens in a new tab)" className="hp-connect">Connect</ButtonLink>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <script>
    import { initHomepage } from '../scripts/homepage';
    initHomepage();
  </script>
</Landing>
