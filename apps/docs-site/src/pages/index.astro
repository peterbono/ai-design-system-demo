---
import '../styles/dashboard.css';
import '../styles/home.css';
import Layout from '../layouts/Layout.astro';
import HeroBridge from '../components/HeroBridge.astro';
import Icon from '../components/Icon.astro';
import { releases, versionInfo } from '../lib/changelog';
import { mdTitleHtml } from '../lib/markdown';
import { FOUNDATIONS, LIBRARY_USE, componentFamilies } from '../lib/nav';
import { GITHUB_URL, PLUGIN_URL } from '../lib/repo';
import { PAGE_SOURCES, freshness } from '../lib/sources';
import { dashboard, humanDate } from '../lib/stats';
import type { IconName } from '../brand/icons';

const s = dashboard();
const version = versionInfo();
const kindTone: Record<string, string> = { Breaking: 'is-fail', New: 'is-info', Fix: 'is-pass', Docs: 'is-accent', Improvement: 'is-accent' };
// What's new: the latest entries people notice (internal tooling left out), newest first.
const recent = releases()
  .flatMap((r) => r.entries.map((e) => ({ ...e, pending: r.pending, date: e.date ?? r.date })))
  .filter((e) => e.kind !== 'Internal')
  .slice(0, 6);
const families = componentFamilies();

const starts: { icon: IconName; title: string; text: string; href: string; cta: string }[] = [
  { icon: 'palette', title: 'Designers', text: 'Color roles, type and spacing, with every value shown in both themes. Pull the same tokens into Figma with the plugin.', href: '/foundations/color/', cta: 'Start with color' },
  { icon: 'terminal', title: 'Engineers', text: 'Install the packages, then build with components that read CSS variables only. Props come straight from the TypeScript.', href: '/install/', cta: 'Install' },
  { icon: 'agent', title: 'AI agents', text: 'The same docs as plain text in llms.txt, and an MCP server so your Claude builds with real tokens and proposes changes by pull request.', href: '/agents/', cta: 'Connect an agent' },
];
---

<Layout
  title="Home"
  description="Bridge Library: the latest release of the design system. Foundations, tokens, components and how to use them, for people and agents."
  sources={PAGE_SOURCES.home}
  updated={freshness(PAGE_SOURCES.home)}
  wide
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title">Your design system, one source of truth.</h1>
      <p class="hero-lead">
        This Library shows the latest release, <span class="mono">{version.current}</span>, rebuilt from the repository on every merge. What you read
        here is what ships. To change something, open it in the Studio: every change goes through a draft, a review and a merge.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="/components/"><Icon name="components" size={18} />Browse components</a>
        <a class="btn btn-secondary" href="/tokens/"><Icon name="grid" size={18} />Explore tokens</a>
        <a class="btn btn-secondary" href="/studio/"><Icon name="edit" size={18} />Open the Studio</a>
      </div>
      <p class="hero-note">
        Free and open source, by Florian Gouloubi. {s.total} tokens, {s.components} components, {s.brands} brands, {s.themes} themes and {s.densities}
        densities.
      </p>
    </div>
    <HeroBridge />
  </section>

  <div class="home-grid">
    <section class="home-news" aria-labelledby="news-title">
      <header class="home-head">
        <h2 id="news-title">What's new</h2>
        <a href="/changelog/" class="panel-link">All release notes</a>
      </header>
      {
        recent.length === 0 ? (
          <p class="empty">No changes recorded yet.</p>
        ) : (
          <ol class="news">
            {recent.map((e) => (
              <li class="news-item">
                <span class={`pill ${kindTone[e.kind] ?? ''}`}>{e.kind}</span>
                <div>
                  <p class="news-title" set:html={mdTitleHtml(e.title)} />
                  <p class="news-meta">
                    {e.date ? humanDate(e.date) : 'Not released yet'}
                    {e.pending && <span class="news-pending">Next release</span>}
                    {e.source === 'commit' && (
                      <a href={`${GITHUB_URL}/commit/${e.ref}`} class="mono">
                        {e.ref}
                      </a>
                    )}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        )
      }
    </section>

    <section class="home-index" aria-labelledby="index-title">
      <h2 id="index-title">In the Library</h2>
      <div class="index-cols">
        <div>
          <p class="index-label">Foundations</p>
          <ul class="index-list">
            {FOUNDATIONS.map((f) => (
              <li>
                <a href={f.href}>{f.icon && <Icon name={f.icon} size={16} />}{f.label}</a>
              </li>
            ))}
          </ul>
          <p class="index-label">Tokens</p>
          <ul class="index-list">
            <li><a href="/tokens/"><Icon name="grid" size={16} />Explorer <span class="index-n num">{s.total}</span></a></li>
            <li><a href="/playground/"><Icon name="play" size={16} />Theme playground</a></li>
          </ul>
        </div>
        <div>
          <p class="index-label">Components</p>
          <ul class="index-list">
            {families.map((f) => (
              <li>
                <a href={`/components/#fam-${f.label.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`}><Icon name="components" size={16} />{f.label} <span class="index-n num">{f.items.length}</span></a>
              </li>
            ))}
          </ul>
          <p class="index-label">Use</p>
          <ul class="index-list">
            {LIBRARY_USE.map((f) => (
              <li>
                <a href={f.href}>{f.icon && <Icon name={f.icon} size={16} />}{f.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </div>

  <section class="home-starts" aria-labelledby="starts-title">
    <h2 id="starts-title">Where to start</h2>
    <ul class="starts">
      {
        starts.map((x) => (
          <li>
            <span class="path-icon"><Icon name={x.icon} /></span>
            <div>
              <h3>{x.title}</h3>
              <p>{x.text}</p>
              <a href={x.href}>{x.cta}</a>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="home-door">
      <Icon name="edit" size={16} />
      <span>
        Want to change a token or a component? Every page here has an <strong>Edit in Studio</strong> action that opens it in a draft. Designers can also
        propose from Figma with the <a href={PLUGIN_URL}>DS Bridge plugin</a>.
      </span>
    </p>
  </section>
</Layout>
