---
// Team shell of Studio Being built (lib/team-shells.ts): served for /studio/<owner>/<repo>/building/ by the vercel.json
// rewrite. The same island as the self-hosted page (components/ds/studio/BeingBuilt), reading the team's build requests
// in the browser (scripts/building-data.ts); the sample team of the demo shows its sample ones, read only. On top,
// for whoever may publish it, the team's next release (components/NextRelease.astro).
import '../../styles/studio-home.css';
import '../../styles/branch-thumb.css';
import '../../styles/building.css';
import TeamShell from '../../components/TeamShell.astro';
import BeingBuilt from '../../components/ds/studio/BeingBuilt';
import NextRelease from '../../components/NextRelease.astro';
---

<TeamShell route="building/" title="Being built" what="build requests" description="The changes sent from Figma that this team's developers are building, and where each one stands.">
  <NextRelease />
  <BeingBuilt client:only="react" />
</TeamShell>
