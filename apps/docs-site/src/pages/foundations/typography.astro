---
import Layout from '../../layouts/Layout.astro';
import ButtonLink from '../../components/ds/ButtonLink';
import { Pencil } from 'lucide-react';
import CopyAs from '../../components/foundations/CopyAs.astro';
import LibraryKit from '../../components/foundations/LibraryKit.astro';
import TokenList from '../../components/foundations/TokenList.astro';
import { groupRows, primitiveRows, type FoundationRow } from '../../lib/foundations';
import { PAGE_SOURCES, freshness } from '../../lib/sources';

const updated = freshness(PAGE_SOURCES.typography);

// Roles, line heights and tracking per step come from docs/DESIGN-LANGUAGE.md (section 5), mapped to the
// nearest token of the scale.
const STEPS: Record<string, { role: string; leading: string; tracking: string }> = {
  '1000': { role: 'Display: the home hero and onboarding only (typography.display)', leading: 'none', tracking: 'tighter' },
  '900': { role: 'Numbers that must win a glance', leading: 'none', tracking: 'tighter' },
  '800': { role: 'Page titles (typography.h1)', leading: 'tight', tracking: 'tight' },
  '700': { role: 'Rare emphasis in dense views', leading: 'tight', tracking: 'tight' },
  '600': { role: 'Section titles (typography.h2), page titles on phones', leading: 'tight', tracking: 'snug' },
  '500': { role: 'Headings inside dense Studio views', leading: 'tight', tracking: 'snug' },
  '400': { role: 'Card, dialog and group titles (typography.h3)', leading: 'snug', tracking: 'snug' },
  '300': { role: 'Reading body and leads (typography.body)', leading: 'normal', tracking: 'normal' },
  '200': { role: 'Interface text, labels, table cells (typography.ui)', leading: 'normal', tracking: 'normal' },
  '100': { role: 'Captions, badges, table meta (typography.caption)', leading: 'snug', tracking: 'wide' },
};
const WEIGHTS: Record<string, string> = {
  'font.weight.regular': 'Body text.',
  'font.weight.medium': 'Labels and buttons.',
  'font.weight.semibold': 'Titles.',
  'font.weight.bold': 'Only for numbers that must win a glance.',
};
const LEADING: Record<string, string> = {
  'font.line-height.none': 'Icons and single glyphs, never text that wraps.',
  'font.line-height.tight': 'Headings from 24 px up.',
  'font.line-height.snug': 'Captions and card titles.',
  'font.line-height.normal': 'Body text and UI text that wraps.',
  'font.line-height.relaxed': 'Long reading, like changelogs and guidance.',
};
const withRole = (rows: FoundationRow[], roles: Record<string, string>) => rows.map((r) => ({ ...r, role: r.role || roles[r.path] || '' }));

const sizes = primitiveRows('font.size');
const sizeRows = withRole([...sizes].reverse(), Object.fromEntries(sizes.map((r) => [r.path, `${STEPS[r.path.split('.').pop()!]?.role ?? ''}.`])));
const weights = withRole(primitiveRows('font.weight'), WEIGHTS);
const leading = withRole(primitiveRows('font.line-height'), LEADING);
const tracking = primitiveRows('font.tracking');
const families = [...groupRows('font.family'), ...primitiveRows('font.family')];
const px = (css: string) => css.replace('px', ' px');
const lh = (name: string) => primitiveRows('font.line-height').find((r) => r.path.endsWith(`.${name}`))?.values.light ?? '';
import LibraryHeader from '../../components/LibraryHeader.astro';
import PreviewScope from '../../components/PreviewScope.astro';
---

<Layout title="Typography" description="The type scale at every step, weights, line heights, tracking and font families." sources={PAGE_SOURCES.typography} updated={updated}>
  <div data-fd-page>
    <LibraryHeader title="Typography" art="foundations" updated={updated}>
      Fraunces for display and page titles, Instrument Sans for reading and interface text, IBM Plex Mono for code and token names. Seven roles set size, line height and weight together; a screen uses four sizes at most. If a design needs a step that is not here, propose a token instead of picking a value by eye.
      <Fragment slot="actions">
        <ButtonLink variant="secondary" size="sm" iconStart={Pencil} href="/studio/tokens/?focus=font">Edit in Studio</ButtonLink>
      </Fragment>
    </LibraryHeader>
    <div class="fd-toolbar">
      <p class="fd-hint">Select a token to see where it is used and its history. Click a name to copy it.</p>
      <div class="fd-tools">
        <PreviewScope />
        <CopyAs />
      </div>
    </div>

    <section class="fd-group" aria-labelledby="scale">
      <header class="fd-group-head">
        <h2 id="scale">Type scale</h2>
        <code class="fd-group-path">font.size</code>
        <span class="fd-group-n">{sizes.length} tokens</span>
      </header>
      <p class="fd-group-note">Each step at its size, with the line height and tracking it pairs with.</p>
      <div class="fd-stage" role="group" aria-label="Type scale specimen">
        {
          sizeRows.map((r) => {
            const step = r.path.split('.').pop()!;
            const s = STEPS[step]!;
            return (
              <div class="sp-type-row">
                <span class="sp-type-meta">
                  <strong>{step}</strong>
                  <span>
                    {px(r.values.light)} / {lh(s.leading)}
                  </span>
                  <span>{s.role}</span>
                </span>
                <p
                  class="sp-type-sample"
                  style={`font-size: var(${r.cssVar}); line-height: var(--font-line-height-${s.leading}); letter-spacing: var(--font-tracking-${s.tracking}); font-weight: var(--font-weight-${Number(step) >= 400 ? 'semibold' : 'regular'})`}
                >
                  {Number(step) >= 500 ? 'Review the token change' : 'Every token change ships as a reviewed pull request.'}
                </p>
              </div>
            );
          })
        }
      </div>
      <TokenList rows={sizeRows} preview="size" label="Font size tokens" />
    </section>

    <section class="fd-group" aria-labelledby="weights">
      <header class="fd-group-head">
        <h2 id="weights">Weights</h2>
        <code class="fd-group-path">font.weight</code>
        <span class="fd-group-n">{weights.length} tokens</span>
      </header>
      <div class="fd-stage sp-type-weights" role="group" aria-label="Weight specimen">
        {
          weights.map((w) => (
            <div>
              <span class="sp-type-meta">
                <strong>{w.path.split('.').pop()}</strong>
                <span>{w.values.light}</span>
              </span>
              <p style={`font-weight: var(${w.cssVar}); font-size: var(--font-size-500); line-height: var(--font-line-height-tight)`}>Approve and merge</p>
            </div>
          ))
        }
      </div>
      <TokenList rows={weights} preview="weight" label="Font weight tokens" />
    </section>

    <section class="fd-group" aria-labelledby="leading">
      <header class="fd-group-head">
        <h2 id="leading">Line heights</h2>
        <code class="fd-group-path">font.line-height</code>
        <span class="fd-group-n">{leading.length} tokens</span>
      </header>
      <div class="fd-stage sp-type-leading" role="group" aria-label="Line height specimen">
        {
          leading
            .filter((l) => !l.path.endsWith('.none'))
            .map((l) => (
              <div>
                <span class="sp-type-meta">
                  <strong>{l.path.split('.').pop()}</strong>
                  <span>{l.values.light}</span>
                </span>
                <p style={`line-height: var(${l.cssVar}); font-size: var(--font-size-200)`}>
                  Semantic tokens give each color a job and point to a different primitive in each theme, so one change repaints every screen.
                </p>
              </div>
            ))
        }
      </div>
      <TokenList rows={leading} preview="line-height" label="Line height tokens" />
    </section>

    <section class="fd-group" aria-labelledby="tracking">
      <header class="fd-group-head">
        <h2 id="tracking">Tracking</h2>
        <code class="fd-group-path">font.tracking</code>
        <span class="fd-group-n">{tracking.length} tokens</span>
      </header>
      <p class="fd-group-note">Tighter as type gets bigger, slightly open at caption size. Values are in em, so they scale with the text.</p>
      <TokenList rows={tracking} preview="tracking" label="Tracking tokens" />
    </section>

    <section class="fd-group" aria-labelledby="families">
      <header class="fd-group-head">
        <h2 id="families">Families</h2>
        <code class="fd-group-path">font.family</code>
        <span class="fd-group-n">{families.length} tokens</span>
      </header>
      <p class="fd-group-note">
        Brands pick their faces through the font roles <code>font.family.display</code>, <code>font.family.sans</code> and
        <code>font.family.mono</code>. Bridge sets Fraunces, Instrument Sans and IBM Plex Mono; Ocean uses IBM Plex throughout. All are
        self-hosted with <code>@bridge-ds/tokens/fonts.css</code>; without it, products fall back to the platform font.
      </p>
      <div class="fd-stage sp-type-families" role="group" aria-label="Font family specimen">
        <div>
          <span class="sp-type-meta"><strong>display</strong></span>
          <p style="font-family: var(--font-family-display)">Your design system, one source of truth</p>
        </div>
        <div>
          <span class="sp-type-meta"><strong>sans</strong></span>
          <p style="font-family: var(--font-family-sans)">Ship the system, not the slides</p>
        </div>
        <div>
          <span class="sp-type-meta"><strong>mono</strong></span>
          <p style="font-family: var(--font-family-mono)">color.bg.default 0O Il1</p>
        </div>
      </div>
      <TokenList rows={families} preview="family" label="Font family tokens" />
    </section>
  </div>
  <LibraryKit />
</Layout>
