---
// Library > Foundations > Typography: the shared view (components/ds/library/views/TypographyView.tsx), rendered at
// build time.
import Layout from '../../layouts/Layout.astro';
import LibraryKit from '../../components/foundations/LibraryKit.astro';
import TypographyView from '../../components/ds/library/views/TypographyView';
import { siteLibraryData } from '../../lib/library-site';
import { PAGE_SOURCES, freshness } from '../../lib/sources';

const updated = freshness(PAGE_SOURCES.typography);
---

<Layout title="Typography" description="The type scale at every step, weights, line heights, tracking and font families." sources={PAGE_SOURCES.typography} updated={updated}>
  <TypographyView data={siteLibraryData()} />
  <LibraryKit />
</Layout>
