---
// Library > Foundations > Accessibility: the shared view (components/ds/library/views/AccessibilityView.tsx),
// rendered at build time, with the token detail drawer its rows open.
import '../../styles/foundations.css';
import '../../styles/a11y.css';
import Layout from '../../layouts/Layout.astro';
import TokenDetailDrawer from '../../components/explorer/TokenDetailDrawer.astro';
import AccessibilityView from '../../components/ds/library/views/AccessibilityView';
import { devContrastFixture, siteLibraryData } from '../../lib/library-site';
import { PAGE_SOURCES, freshness } from '../../lib/sources';

const updated = freshness(PAGE_SOURCES.accessibility);
---

<Layout title="Accessibility" description="What Bridge commits to for accessibility, and every gated color pair checked in every brand and theme." sources={PAGE_SOURCES.accessibility} updated={updated}>
  <AccessibilityView data={siteLibraryData({ extraPairs: devContrastFixture(import.meta.env.DEV) })} />
  <TokenDetailDrawer />
</Layout>

<script>
  import { initA11yChecks } from '../../scripts/a11y-checks';
  initA11yChecks();
</script>
