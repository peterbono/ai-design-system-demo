---
// Library > Foundations > Accessibility. Summary first: one status sentence from the contrast gate, then the gated
// pairs grouped by use for one brand and theme at a time (or all four side by side), what every component
// guarantees, and the method behind it, collapsed. All numbers come from packages/tokens/src/contrast.checks.json
// resolved against the tokens at build time (lib/contrast.ts, lib/a11y-checks.ts).
import '../../styles/foundations.css';
import '../../styles/a11y.css';
import Layout from '../../layouts/Layout.astro';
import LibraryHeader from '../../components/LibraryHeader.astro';
import TokenDetailDrawer from '../../components/explorer/TokenDetailDrawer.astro';
import ContrastMatrix, { type MatrixRow } from '../../components/foundations/ContrastMatrix';
import { Badge, Button, Icon, Link, SegmentedControl } from '@bridge-ds/react';
import { CircleAlert, CircleCheck, Columns2, Moon, Sun } from 'lucide-react';
import { CONTRAST_FILE, pagePairs, THRESHOLDS } from '../../lib/contrast';
import {
  buildGroups,
  combos as makeCombos,
  groupStatus,
  resultFor,
  rowTitle,
  shortName,
  statusLabel,
  statusOf,
  statusSentence,
  summarize,
  type Status,
} from '../../lib/a11y-checks';
import { PAGE_SOURCES, freshness } from '../../lib/sources';
import { BRAND_LABEL, BRANDS, DEFAULT_BRAND, MODES } from '../../lib/tokens';

const pairs = pagePairs(import.meta.env.DEV);
const updated = freshness(PAGE_SOURCES.accessibility);
const COMBOS = makeCombos(BRANDS, MODES, BRAND_LABEL);
const DEFAULT_KEY = `${DEFAULT_BRAND}-${MODES[0]}`;
const summary = summarize(pairs, COMBOS);
const groups = buildGroups(pairs, COMBOS);
const TONE: Record<Status, 'success' | 'neutral' | 'danger'> = { aaa: 'success', aa: 'neutral', fail: 'danger' };
const pairName = (p: (typeof pairs)[number]) => `${shortName(p.fg)} on ${shortName(p.bg)}`;
const cssVar = (path: string) => `var(--${path.replace(/\./g, '-')})`;
const matrixRows = (g: (typeof groups)[number]): MatrixRow[] =>
  g.pairs.map((p) => ({
    id: `${p.fg}|${p.bg}`,
    name: pairName(p),
    cells: COMBOS.map((c) => {
      const r = resultFor(p, c);
      const s = statusOf(r);
      return { key: c.key, ratio: r.ratio.toFixed(2), status: s, label: statusLabel(s, p.min), title: `${c.label}: ${rowTitle(p, r)}` };
    }),
  }));
---

<Layout title="Accessibility" description="What Bridge commits to for accessibility, and every gated color pair checked in every brand and theme." sources={PAGE_SOURCES.accessibility} updated={updated}>
  <LibraryHeader title="Accessibility" art="foundations" updated={updated} studio="/studio/quality/" studioLabel="Open in Studio">
    <p class="a11y-status" data-state={summary.failing ? 'fail' : 'pass'}>
      <Icon icon={summary.failing ? CircleAlert : CircleCheck} size="md" className="a11y-status-icon" />
      <span>{statusSentence(summary)}</span>
    </p>
    <Fragment slot="actions">
      <Link href="#how-we-check" variant="standalone" data-a11y-how>How we check</Link>
    </Fragment>
  </LibraryHeader>

  <section class="a11y-checks" aria-labelledby="a11y-checks-h" data-a11y-checks data-view="list" data-combo={DEFAULT_KEY}>
    <h2 id="a11y-checks-h">Contrast checks</h2>
    <div class="a11y-bar">
      <div class="a11y-scope">
        <div class="a11y-field">
          <span class="a11y-field-label" id="a11y-brand-l">Brand</span>
          <SegmentedControl
            aria-labelledby="a11y-brand-l"
            size="sm"
            data-vanilla
            data-a11y-brand
            defaultValue={DEFAULT_BRAND}
            items={BRANDS.map((b) => ({ value: b, label: BRAND_LABEL[b] }))}
          />
        </div>
        <div class="a11y-field">
          <span class="a11y-field-label" id="a11y-mode-l">Theme</span>
          <SegmentedControl
            aria-labelledby="a11y-mode-l"
            size="sm"
            data-vanilla
            data-a11y-mode
            defaultValue={MODES[0]}
            items={MODES.map((m) => ({ value: m, label: m === 'light' ? 'Light' : 'Dark', icon: m === 'light' ? Sun : Moon }))}
          />
        </div>
      </div>
      <Button variant="secondary" size="sm" iconStart={Columns2} pressed={false} data-a11y-compare className="a11y-compare">
        Compare all {COMBOS.length}
      </Button>
    </div>
    <p class="a11y-legend">
      <span><span class="a11y-chip-key" data-s="aaa"></span>AAA: text at 7:1 or more</span>
      <span><span class="a11y-chip-key" data-s="aa"></span>AA: meets the pair's minimum</span>
      <span><Icon icon={CircleAlert} size="xs" className="a11y-fail-key" />Fails: below the minimum</span>
    </p>

    {
      groups.map((g) => (
        <details class="a11y-group" open={g.open} data-group={g.id} data-fails={g.failing.all ? '' : undefined}>
          <summary class="a11y-group-head">
            <h3 class="a11y-group-title">{g.label}</h3>
            {[...COMBOS.map((c) => c.key), 'all'].map((k) => (
              <span class="a11y-group-status" data-c={k} data-fails={g.failing[k] ? '' : undefined} hidden={k !== DEFAULT_KEY}>
                {g.failing[k] ? <Icon icon={CircleAlert} size="sm" /> : null}
                {k === 'all' ? `${groupStatus(g.pairs.length, g.failing[k]!)} in all ${COMBOS.length}` : groupStatus(g.pairs.length, g.failing[k]!)}
              </span>
            ))}
          </summary>
          <ul class="a11y-rows" aria-label={g.label}>
            {g.pairs.map((p) => {
              const first = resultFor(p, COMBOS[0]!);
              return (
                <li>
                  <button type="button" class="a11y-row" data-fd-open={p.fg} title={rowTitle(p, first)}>
                    <span class="a11y-tile" data-theme={COMBOS[0]!.mode} data-brand={COMBOS[0]!.brand} data-scope-fixed aria-hidden="true" style={`background-color: ${cssVar(p.bg)}`}>
                      {p.usage === 'text' ? <span style={`color: ${cssVar(p.fg)}`}>Aa</span> : <i style={`border-color: ${cssVar(p.fg)}`} />}
                    </span>
                    <span class="a11y-pair">
                      {shortName(p.fg)} <span class="a11y-on">on</span> {shortName(p.bg)}
                    </span>
                    {COMBOS.map((c) => {
                      const r = resultFor(p, c);
                      const s = statusOf(r);
                      return (
                        <span class="a11y-res" data-c={c.key} data-title={rowTitle(p, r)} hidden={c.key !== DEFAULT_KEY}>
                          <span class="a11y-ratio num" data-s={s}>
                            {r.ratio.toFixed(2)}:1
                          </span>
                          <Badge tone={TONE[s]} icon={s === 'fail' ? CircleAlert : undefined} className="a11y-chip" title={s === 'fail' ? undefined : `Needs ${p.min}:1`}>
                            {statusLabel(s, p.min)}
                          </Badge>
                        </span>
                      );
                    })}
                  </button>
                </li>
              );
            })}
          </ul>
          <div class="a11y-matrix" hidden>
            <ContrastMatrix label={g.label} combos={COMBOS.map((c) => ({ key: c.key, label: c.label }))} rows={matrixRows(g)} />
          </div>
        </details>
      ))
    }
  </section>

  <section aria-labelledby="a11y-floor-h">
    <h2 id="a11y-floor-h">What every component guarantees</h2>
    <ul class="a11y-floor">
      <li><strong>Keyboard and screen readers.</strong> Every interactive component is keyboard operable, with the right role, name and state. Behavior comes from native elements or Base UI parts.</li>
      <li><strong>Visible focus.</strong> A 2px ring in the focus color, offset by 2px, on <code>:focus-visible</code> only. Inputs draw it inside the field.</li>
      <li><strong>Color is never the only signal.</strong> Status has text and an icon; an invalid field has a message.</li>
      <li><strong>Targets of at least 24 by 24 px</strong> in both densities.</li>
      <li><strong>Reduced motion.</strong> With <code>prefers-reduced-motion: reduce</code>, every motion duration drops to 0.</li>
      <li><strong>Checked in CI.</strong> Storybook runs the accessibility addon in error mode, and component tests run axe-core.</li>
    </ul>
  </section>

  <details class="a11y-how" id="how-we-check">
    <summary class="a11y-how-head"><h2>How we check</h2></summary>
    <div class="a11y-how-body">
      <h3>Thresholds</h3>
      <p>
        Bridge targets WCAG 2.2 AA. Text needs {THRESHOLDS.text.aa}:1 against its background, and reaches AAA at {THRESHOLDS.text.aaa}:1. Control edges, icons
        and focus rings need {THRESHOLDS.ui.aa}:1 (WCAG 1.4.11), which has no AAA level. Ratios are rounded down, so 4.496 never shows as a passing 4.50.
      </p>
      <h3>Text or UI</h3>
      <p>
        Each pair carries its own minimum. A pair gated at {THRESHOLDS.text.aa}:1 is text: body copy, labels, links, button text, chart axis labels. A pair
        gated at {THRESHOLDS.ui.aa}:1 is a UI part: borders, control tracks, icons, focus rings, chart series. Text samples show "Aa"; UI samples show a stroke.
      </p>
      <h3>The build gate</h3>
      <p>
        The pairs live in <code>{CONTRAST_FILE}</code>. The token build resolves each one in every brand and theme and fails below its minimum, so a token
        change that breaks a pair never ships. To gate a new combination, add <code>{'["<fg token>", "<bg token>", <min>]'}</code> to that file.
      </p>
      <h3>When a pair fails</h3>
      <ul>
        <li>Fix it with a token change, never locally in a screen or a component. A local fix hides the problem and the next team hits it again.</li>
        <li>Open an issue or a DS Bridge proposal with the pair, the ratio and where it shows up. A token change is Tier 3: design and tech owners both approve it.</li>
        <li>Until it ships, avoid that pair in new places.</li>
      </ul>
      <p data-maintainer-only>
        <Link href="/studio/quality/" variant="standalone">See every check in Studio Quality</Link>
      </p>
    </div>
  </details>

  <TokenDetailDrawer />
</Layout>

<script>
  import { initA11yChecks } from '../../scripts/a11y-checks';
  initA11yChecks();
</script>
