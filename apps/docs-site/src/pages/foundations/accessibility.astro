---
import '../../styles/foundations.css';
import '../../styles/library.css';
import Layout from '../../layouts/Layout.astro';
import ButtonLink from '../../components/ds/ButtonLink';
import { Badge } from '@bridge-ds/react';
import ContrastTable, { type ContrastRow } from '../../components/foundations/ContrastTable';
import { CircleAlert, CircleCheck, ShieldCheck } from 'lucide-react';
import Icon from '../../components/Icon.astro';
import { contrastPairs, THRESHOLDS } from '../../lib/contrast';
import { PAGE_SOURCES, freshness } from '../../lib/sources';
import { anchorOf, BRAND_LABEL, BRANDS, MODES, type Brand, type Mode } from '../../lib/tokens';

const pairs = contrastPairs();
const updated = freshness(PAGE_SOURCES.accessibility);
/** Every brand x theme combination the build gates on. */
const COMBOS = BRANDS.flatMap((b) => MODES.map((m) => ({ b, m, key: `${b}-${m}` }))) as { b: Brand; m: Mode; key: string }[];
const res = (p: (typeof pairs)[number], c: (typeof COMBOS)[number]) => p.brands[c.b][c.m];
const failures = pairs.flatMap((p) => COMBOS.filter((c) => !res(p, c).aa).map((c) => ({ p, c })));
const total = pairs.length * COMBOS.length;
const passing = total - failures.length;
const rate = total ? Math.floor((passing / total) * 1000) / 10 : 100;
const perMode = COMBOS.map((c) => ({ c, pass: pairs.filter((p) => res(p, c).aa).length, total: pairs.length }));
const failingPairs = pairs.filter((p) => COMBOS.some((c) => !res(p, c).aa));
const comboLabel = (c: { b: Brand; m: Mode }) => `${BRAND_LABEL[c.b]} ${c.m === 'light' ? 'light' : 'dark'}`;
const need = (p: { min: number }) => p.min;
const tableCombos = COMBOS.map((c) => ({ key: c.key, brand: c.b, mode: c.m, label: comboLabel(c) }));
const tableRows: ContrastRow[] = [...pairs]
  .sort((a, b) => Number(COMBOS.every((c) => res(a, c).aa)) - Number(COMBOS.every((c) => res(b, c).aa)))
  .map((p) => ({
    fg: p.fg,
    bg: p.bg,
    fgHref: `/foundations/color/#${anchorOf(p.fgToken.cssVar)}`,
    bgHref: `/foundations/color/#${anchorOf(p.bgToken.cssVar)}`,
    fgVar: p.fgToken.cssVar,
    bgVar: p.bgToken.cssVar,
    usage: p.usage === 'text' ? 'text' : 'ui',
    min: p.min,
    results: COMBOS.map((c) => {
      const r = res(p, c);
      return { ratio: r.ratio, fgHex: r.fgHex, bgHex: r.bgHex, aa: r.aa, aaa: r.aaa };
    }),
  }));
import LibraryHeader from '../../components/LibraryHeader.astro';
---

<Layout title="Accessibility" description="What Bridge commits to for accessibility, and the contrast grid of every gated color pair in every brand and theme." sources={PAGE_SOURCES.accessibility} updated={updated}>
  <LibraryHeader title="Accessibility" art="foundations" updated={updated}>
    Bridge targets WCAG 2.2 AA: text needs {THRESHOLDS.text.aa}:1 against its background, control edges, icons and focus rings need {THRESHOLDS.ui.aa}:1. The token build checks every gated color pair in both brands and both themes, so a token change that breaks a pair fails the build before it ships.
    <Fragment slot="actions">
      <ButtonLink variant="secondary" size="sm" iconStart={ShieldCheck} href="/studio/checks/">Open in Studio Checks</ButtonLink>
    </Fragment>
  </LibraryHeader>

  <h2>What every component guarantees</h2>
  <ul class="a11y-floor">
    <li><strong>Keyboard and screen readers.</strong> Every interactive component is keyboard operable, with the right role, name and state (<code>aria-checked</code>, <code>aria-expanded</code>, <code>aria-invalid</code>, <code>aria-busy</code>). Behavior comes from native elements or Base UI parts, and the wrappers do not break it.</li>
    <li><strong>Visible focus.</strong> A 2px ring in the focus color, offset by 2px, on <code>:focus-visible</code> only. Inputs draw it inside so it hugs the field. The ring keeps 3:1 against canvas and surfaces.</li>
    <li><strong>Color is never the only signal.</strong> Status has text and an icon; an invalid field has a message.</li>
    <li><strong>Targets of at least 24 by 24 px</strong> in both densities.</li>
    <li><strong>Reduced motion.</strong> With <code>prefers-reduced-motion: reduce</code>, every motion duration in <code>tokens.css</code> drops to 0.</li>
    <li><strong>Checked in CI.</strong> Storybook runs the accessibility addon in error mode, and the component tests run axe-core on keyboard and ARIA behavior.</li>
  </ul>

  <h2>Contrast grid</h2>
  <p class="muted">The pairs the token build gates on, computed at build time from the token values. Fix a failing pair with a token change, never locally.</p>

  <section class="ct-summary" aria-label="Summary">
    <div class="ct-score">
      <p class="ct-big display num">{rate}%</p>
      <p class="ct-score-label"><strong class="num">{passing} of {total}</strong> checks pass AA</p>
      <div class="ct-meter" role="img" aria-label={`${passing} of ${total} checks pass`}>
        <span style={`width: ${(passing / Math.max(total, 1)) * 100}%`}></span>
      </div>
      <ul class="ct-modes">
        {
          perMode.map((x) => (
            <li>
              <span>{comboLabel(x.c)}</span>
              <strong class="num">
                {x.pass}/{x.total}
              </strong>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="ct-rules">
      <p><strong>Text</strong> needs {THRESHOLDS.text.aa}:1 for AA and {THRESHOLDS.text.aaa}:1 for AAA.</p>
      <p><strong>UI</strong> (control edges, icons, focus rings) needs {THRESHOLDS.ui.aa}:1, WCAG 1.4.11. There is no AAA level for UI.</p>
      <p class="muted small">
        To gate a new combination, add it to <code>packages/tokens/src/contrast.checks.json</code> as
        <code>{'["<fg token path>", "<bg token path>", <min ratio>]'}</code>. The token build checks it in every brand and theme and
        fails below the minimum.
      </p>
    </div>
  </section>

  {
    failingPairs.length > 0 && (
      <section class="ct-failing" aria-labelledby="ct-fail-h">
        <h3 id="ct-fail-h" class="ct-fail-title">
          <Icon name="alert" /> {failures.length} {failures.length === 1 ? 'check needs' : 'checks need'} attention
        </h3>
        <div class="ct-fail-grid">
          {failingPairs.map((p) => (
            <article class="ct-fail-card">
              <p class="ct-fail-pair">
                <a href={`/tokens/?t=${encodeURIComponent(p.fg)}`}>{p.fg}</a> <span class="muted">on</span>{' '}
                <a href={`/tokens/?t=${encodeURIComponent(p.bg)}`}>{p.bg}</a>
              </p>
              <div class="ct-fail-modes">
                {COMBOS.map((c) => {
                  const r = res(p, c);
                  return (
                    <div class="ct-fail-mode">
                      <div class="ct-tile" data-theme={c.m} data-brand={c.b} data-scope-fixed style={`background-color: var(${p.bgToken.cssVar})`}>
                        {p.usage === 'text' ? (
                          <span style={`color: var(${p.fgToken.cssVar})`}>Aa</span>
                        ) : (
                          <i style={`border-color: var(${p.fgToken.cssVar})`} />
                        )}
                      </div>
                      <div>
                        <p class="ct-ratio num">{r.ratio.toFixed(2)}:1</p>
                        <p class="small muted">
                          {comboLabel(c)}, needs {need(p)}:1
                        </p>
                        <Badge tone={r.aa ? 'success' : 'danger'} icon={r.aa ? CircleCheck : CircleAlert} size="sm">{r.aa ? 'AA pass' : 'AA fail'}</Badge>
                      </div>
                    </div>
                  );
                })}
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <h3>All pairs</h3>
  <p class="muted">Failing pairs first. Each tile renders the real tokens in that brand and theme, whatever this page is set to.</p>
  <ContrastTable combos={tableCombos} rows={tableRows} />

  <h2>What to do with a failing pair</h2>
  <ul>
    <li>Do not fix it locally in a screen or a component. That hides the problem and the next team hits it again.</li>
    <li>Open an issue or a DS Bridge proposal with the pair, the ratio and where it shows up. A token change is Tier 3: design and tech owners both approve it.</li>
    <li>Until it ships, avoid using that pair in new places.</li>
  </ul>
</Layout>
