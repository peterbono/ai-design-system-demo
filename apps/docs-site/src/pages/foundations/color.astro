---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Updated from '../../components/Updated.astro';
import CopyAs from '../../components/foundations/CopyAs.astro';
import LibraryKit from '../../components/foundations/LibraryKit.astro';
import TokenGroup from '../../components/foundations/TokenGroup.astro';
import type { SpecimenGroup } from '../../components/foundations/Specimens.tsx';
import { groupRows } from '../../lib/foundations';
import { PAGE_SOURCES, freshness } from '../../lib/sources';
import { luminance } from '../../lib/contrast';
import { anchorOf, colorRamps, loadTokens, MODES } from '../../lib/tokens';

const { semantic } = loadTokens();
const colors = semantic.filter((s) => s.type === 'color');
const groups = [...new Set(colors.map((s) => s.group))];
const ramps = colorRamps();
const updated = freshness(PAGE_SOURCES.color);

const SPECIMEN: Record<string, SpecimenGroup> = {
  'color.bg': 'color.bg',
  'color.surface': 'color.surface',
  'color.text': 'color.text',
  'color.border': 'color.border',
  'color.action': 'color.action',
  'color.control': 'color.control',
  'color.signal': 'color.signal',
  'color.overlay': 'color.overlay',
  'color.feedback': 'color.feedback',
  'color.selection': 'color.selection',
  focus: 'focus',
};
const sections = groups.map((g) => ({ group: g, rows: groupRows(g).filter((r) => r.type === 'color') })).filter((s) => s.rows.length);

// Step label color: whichever of the system's own extremes reads better on the swatch.
const labelOn = (hex?: string) => (hex && luminance(hex) > 0.36 ? 'var(--color-neutral-950)' : 'var(--color-neutral-0)');
const semanticUsing = (primitivePath: string) =>
  colors.filter((s) => MODES.some((m) => s.modes[m].chain.includes(primitivePath))).map((s) => s.path);
---

<Layout title="Color" description="Semantic color tokens shown in context in light and dark, and the primitive palette behind them." sources={PAGE_SOURCES.color} updated={updated}>
  <div data-fd-page>
    <header class="page-head">
      <div>
        <h1>Color</h1>
        <p class="lead">
          Every color has a job. Each group below shows its tokens at work in both themes, then lists them. Design and build with these semantic
          tokens; the primitive palette at the end is what they point to.
        </p>
        <Updated date={updated} />
      </div>
      <div class="page-head-actions">
        <a class="btn btn-secondary" href="/studio/tokens/?focus=color"><Icon name="edit" size={16} />Edit in Studio</a>
      </div>
    </header>
    <div class="fd-toolbar">
      <p class="fd-hint">Select a token to see its alias chain, contrast pairs and history. Click a name to copy it.</p>
      <CopyAs />
    </div>

    {sections.map((s) => <TokenGroup group={s.group} rows={s.rows} preview="color" specimen={SPECIMEN[s.group]} />)}

    <section class="fd-group" aria-labelledby="primitives">
      <header class="fd-group-head">
        <h2 id="primitives">Primitive palette</h2>
      </header>
      <p class="fd-group-note">
        Raw values. Components never use these directly; semantic tokens point to them. Use them when you propose a new semantic token, not when you
        design a screen.
      </p>
      {
        ramps.map(({ hue, steps }) => (
          <section aria-labelledby={`ramp-${hue}`} class="fd-ramp">
            <h3 id={`ramp-${hue}`}>{hue}</h3>
            <div class="ramp-strip" role="list">
              {steps.map((p) => {
                const n = semanticUsing(p.path).length;
                return (
                  <div class="ramp-step" id={anchorOf(p.cssVar)} role="listitem">
                    <span class="ramp-color" style={`background-color: var(${p.cssVar}); color: ${labelOn(p.hex)}`}>
                      <strong>{p.segments.slice(2).join('.') || p.segments.slice(1).join('.')}</strong>
                    </span>
                    <span class="ramp-meta">
                      <button type="button" class="ramp-copy" data-copy={`var(${p.cssVar})`} aria-label={`Copy CSS variable var(${p.cssVar})`} title={`Copy var(${p.cssVar})`}>
                        {p.hex}
                      </button>
                      <span class={n ? 'ramp-n' : 'ramp-n is-unused'}>{n > 0 ? `${n} semantic` : 'Unused'}</span>
                    </span>
                  </div>
                );
              })}
            </div>
          </section>
        ))
      }
      <p>
        Want to know exactly who uses a value? Paste a hex in search (<kbd class="kbd">⌘K</kbd>) or in the <a href="/tokens/">token explorer</a>.
      </p>
    </section>
  </div>
  <LibraryKit />
</Layout>
