---
// Library > Foundations > Color: the shared view (components/ds/library/views/ColorView.tsx), rendered at build time.
import Layout from '../../layouts/Layout.astro';
import LibraryKit from '../../components/foundations/LibraryKit.astro';
import ColorView from '../../components/ds/library/views/ColorView';
import { siteLibraryData } from '../../lib/library-site';
import { PAGE_SOURCES, freshness } from '../../lib/sources';

const updated = freshness(PAGE_SOURCES.color);
---

<Layout title="Color" description="Semantic color tokens shown in context in light and dark, and the primitive palette behind them." sources={PAGE_SOURCES.color} updated={updated}>
  <ColorView data={siteLibraryData()} />
  <LibraryKit />
</Layout>
