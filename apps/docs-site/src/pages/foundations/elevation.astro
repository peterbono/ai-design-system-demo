---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Updated from '../../components/Updated.astro';
import CopyAs from '../../components/foundations/CopyAs.astro';
import LibraryKit from '../../components/foundations/LibraryKit.astro';
import TokenGroup from '../../components/foundations/TokenGroup.astro';
import TokenList from '../../components/foundations/TokenList.astro';
import { groupRows, primitiveRows } from '../../lib/foundations';
import { PAGE_SOURCES, freshness } from '../../lib/sources';

const updated = freshness(PAGE_SOURCES.elevation);
const elevation = groupRows('elevation');
const shadows = primitiveRows('shadow');
---

<Layout title="Elevation" description="Elevation levels on real surfaces in light and dark, and the shadow primitives behind them." sources={PAGE_SOURCES.elevation} updated={updated}>
  <div data-fd-page>
    <header class="page-head">
      <div>
        <h1>Elevation</h1>
        <p class="lead">
          Things that float cast shadows; things that sit do not. Cards and panels are flat plates with a hairline edge. Only popovers, menus, dialogs,
          drawers and toasts get elevation, and dark mode uses darker, tighter shadows so edges stay visible.
        </p>
        <Updated date={updated} />
      </div>
      <div class="page-head-actions">
        <a class="btn btn-secondary" href="/studio/tokens/?focus=shadow"><Icon name="edit" size={16} />Edit in Studio</a>
      </div>
    </header>
    <div class="fd-toolbar">
      <p class="fd-hint">Select a token to see where it is used and its history. Click a name to copy it.</p>
      <CopyAs />
    </div>

    <TokenGroup group="elevation" title="Levels" rows={elevation} preview="shadow" specimen="elevation" />

    <section class="fd-group" aria-labelledby="primitives">
      <header class="fd-group-head">
        <h2 id="primitives">Shadow primitives</h2>
        <code class="fd-group-path">shadow</code>
        <span class="fd-group-n">{shadows.length} tokens</span>
      </header>
      <p class="fd-group-note">The raw two-layer shadows. The dark variants exist because a light shadow disappears on a dark surface.</p>
      <TokenList rows={shadows} preview="shadow" label="Shadow primitive tokens" />
    </section>
  </div>
  <LibraryKit />
</Layout>
