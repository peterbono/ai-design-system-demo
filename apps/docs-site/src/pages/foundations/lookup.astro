---
import '../../styles/foundations.css';
import { Button, Input } from '@bridge-ds/react';
import Layout from '../../layouts/Layout.astro';
import Updated from '../../components/Updated.astro';
import { PAGE_SOURCES, freshness } from '../../lib/sources';

const updated = freshness(PAGE_SOURCES.lookup);
---

<Layout title="Token lookup" description="Who uses this hex value or this primitive token?" sources={PAGE_SOURCES.lookup} updated={updated}>
  <h1>Token lookup</h1>
  <p class="lead">
    Paste a hex value from a mockup or type a token name. You get the primitive behind it, every semantic token that points to it in each theme,
    and the components that end up using it. Handy before you change a value: you see the blast radius first.
  </p>
  <Updated date={updated} />

  <form class="lookup-form" id="lookup-form" role="search">
    <div>
      <Input id="lookup-q" label="Hex value or token name" placeholder="#3449cc, brand.600, space-4" hint="Try a hex like #ffffff, or part of a name like danger." autocomplete="off" />
    </div>
    <Button type="submit" variant="primary">Look up</Button>
  </form>
  <p id="lookup-status" role="status" aria-live="polite" class="muted"></p>
  <div id="lookup-results"></div>
  <noscript><p>The lookup needs JavaScript. The full data is at <a href="/lookup-index.json">/lookup-index.json</a>.</p></noscript>

  <script is:inline>
    (function () {
      var form = document.getElementById('lookup-form');
      var input = document.getElementById('lookup-q');
      var out = document.getElementById('lookup-results');
      var status = document.getElementById('lookup-status');
      var data = null;
      function norm(q) {
        q = q.trim().toLowerCase().replace(/^var\(|\)$/g, '').replace(/^--/, '');
        var m = q.match(/^#?([0-9a-f]{3}|[0-9a-f]{6})$/);
        if (m) {
          var h = m[1];
          if (h.length === 3) h = h.split('').map(function (c) { return c + c; }).join('');
          return { hex: '#' + h };
        }
        return { text: q.replace(/[-/]/g, '.') };
      }
      function el(tag, attrs, text) {
        var n = document.createElement(tag);
        for (var k in attrs || {}) n.setAttribute(k, attrs[k]);
        if (text != null) n.textContent = text;
        return n;
      }
      function link(href, text) { return el('a', { href: href }, text); }
      function render(q) {
        var n = norm(q);
        out.textContent = '';
        if (!q.trim()) { status.textContent = ''; return; }
        var hits = data.filter(function (p) {
          if (n.hex) return p.hex === n.hex;
          var hay = [p.path].concat(p.semantic.map(function (s) { return s.path; })).join(' ');
          return hay.indexOf(n.text) !== -1;
        });
        status.textContent = hits.length ? hits.length + ' primitive' + (hits.length > 1 ? 's' : '') + ' found.' : 'Nothing uses that value. If it came from a mockup, it is not in the system.';
        hits.slice(0, 40).forEach(function (p) {
          var box = el('section', { class: 'panel result' });
          var h = el('h3');
          if (p.hex) { var sw = el('span', { class: 'swatch', 'aria-hidden': 'true' }); sw.style.backgroundColor = 'var(' + p.cssVar + ')'; h.appendChild(sw); }
          h.appendChild(link(p.href, p.path));
          box.appendChild(h);
          box.appendChild(el('p', { class: 'chain' }, p.cssVar + '  |  ' + p.figma + '  |  ' + p.value));
          var ex = el('p', { class: 'small' });
          ex.appendChild(link('/tokens/?t=' + encodeURIComponent(p.path), 'Open in the token explorer'));
          box.appendChild(ex);
          if (p.semantic.length) {
            box.appendChild(el('h4', null, 'Semantic tokens pointing here'));
            var ul = el('ul');
            p.semantic.forEach(function (s) {
              var li = el('li');
              li.appendChild(link(s.href, s.path));
              li.appendChild(document.createTextNode(' (' + s.modes.join(' and ') + ')'));
              if (s.components.length) {
                li.appendChild(document.createTextNode(', used by '));
                s.components.forEach(function (c, i) { if (i) li.appendChild(document.createTextNode(', ')); li.appendChild(link(c.href, c.name)); });
              }
              ul.appendChild(li);
            });
            box.appendChild(ul);
          } else if (p.type === 'color') {
            box.appendChild(el('p', { class: 'muted' }, 'No semantic token points to this primitive yet.'));
          }
          if (p.components.length) {
            var pc = el('p');
            pc.appendChild(document.createTextNode('Used directly by: '));
            p.components.forEach(function (c, i) { if (i) pc.appendChild(document.createTextNode(', ')); pc.appendChild(link(c.href, c.name)); });
            box.appendChild(pc);
          }
          out.appendChild(box);
        });
      }
      function run(e) {
        if (e) e.preventDefault();
        var q = input.value;
        try { history.replaceState(null, '', q ? '?q=' + encodeURIComponent(q) : location.pathname); } catch (x) {}
        if (data) return render(q);
        status.textContent = 'Loading index…';
        fetch('/lookup-index.json').then(function (r) { return r.json(); }).then(function (d) { data = d; render(q); }, function () { status.textContent = 'Could not load the index.'; });
      }
      form.addEventListener('submit', run);
      input.addEventListener('input', function () { if (data) render(input.value); });
      var initial = new URLSearchParams(location.search).get('q');
      if (initial) { input.value = initial; run(); }
    })();
  </script>
</Layout>
