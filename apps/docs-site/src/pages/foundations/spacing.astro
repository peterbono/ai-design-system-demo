---
// Library > Foundations > Spacing: the shared view (components/ds/library/views/SpacingView.tsx), rendered at build
// time.
import Layout from '../../layouts/Layout.astro';
import LibraryKit from '../../components/foundations/LibraryKit.astro';
import SpacingView from '../../components/ds/library/views/SpacingView';
import { siteLibraryData } from '../../lib/library-site';
import { PAGE_SOURCES, freshness } from '../../lib/sources';

const updated = freshness(PAGE_SOURCES.spacing);
---

<Layout title="Spacing" description="The 4 px spacing scale and the density tokens built on it, shown in a real layout." sources={PAGE_SOURCES.spacing} updated={updated}>
  <SpacingView data={siteLibraryData()} />
  <LibraryKit />
</Layout>
