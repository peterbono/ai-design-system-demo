---
// Library > Foundations > Radius and borders: the shared view (components/ds/library/views/RadiusView.tsx), rendered
// at build time.
import Layout from '../../layouts/Layout.astro';
import LibraryKit from '../../components/foundations/LibraryKit.astro';
import RadiusView from '../../components/ds/library/views/RadiusView';
import { siteLibraryData } from '../../lib/library-site';
import { PAGE_SOURCES, freshness } from '../../lib/sources';

const updated = freshness(PAGE_SOURCES.radius);
---

<Layout title="Radius and borders" description="Radius roles by rank, the radius scale, border widths and the focus ring width." sources={PAGE_SOURCES.radius} updated={updated}>
  <RadiusView data={siteLibraryData()} />
  <LibraryKit />
</Layout>
