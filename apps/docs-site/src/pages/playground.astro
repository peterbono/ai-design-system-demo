---
import '../styles/playground.css';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import SampleScreen from '../components/SampleScreen.astro';
import Updated from '../components/Updated.astro';
import { Alert, Button, SegmentedControl } from '@bridge-ds/react';
import { Moon, Sun } from 'lucide-react';
import { scaleBaseline } from '../lib/inspect';
import { lastUpdated } from '../lib/repo';
import { dashboard } from '../lib/stats';
import { BRANDS, BRAND_LABEL, DENSITIES, DENSITY_LABEL, TOKEN_SOURCE_FILES } from '../lib/tokens';

const sources = [...TOKEN_SOURCE_FILES(), 'packages/react/src/components'];
const updated = lastUpdated(sources);
const s = dashboard();
const baseline = scaleBaseline();
const radiusOptions = [
  { key: 'square', label: 'Square' },
  { key: 'shipped', label: 'As shipped' },
  { key: 'soft', label: 'Soft' },
  { key: 'pill', label: 'Pill' },
];
const ratios = [
  { key: 'shipped', label: 'As shipped', value: 0 },
  { key: '1.125', label: 'Major second', value: 1.125 },
  { key: '1.2', label: 'Minor third', value: 1.2 },
  { key: '1.25', label: 'Major third', value: 1.25 },
  { key: '1.333', label: 'Perfect fourth', value: 1.333 },
];
---

<Layout
  title="Theme playground"
  description="A sample product screen built with the real components, in light and dark. Hover any part to see the tokens it reads."
  sources={sources}
  updated={updated}
  wide
>
  <h1>Theme playground</h1>
  <p class="lead">
    Tiny tokens, big impact. This billing screen is built only with the real components from <code>@bridge-ds/react</code>, and the same
    {s.semantic} semantic tokens paint it in both themes, in either brand and density. Hover or focus any part to see exactly which tokens it reads.
  </p>
  <Updated date={updated} />

  <div class="pg-toolbar" role="toolbar" aria-label="Preview options">
    <SegmentedControl
      label="Themes shown"
      data-vanilla
      data-pg-view
      defaultValue="both"
      items={[
        { value: 'both', label: 'Side by side' },
        { value: 'light', label: 'Light', icon: Sun },
        { value: 'dark', label: 'Dark', icon: Moon },
      ]}
    />
    <SegmentedControl label="Brand" data-vanilla data-pg-scope="brand" defaultValue="bridge" items={BRANDS.map((b) => ({ value: b, label: BRAND_LABEL[b] }))} />
    <SegmentedControl
      label="Density"
      data-vanilla
      data-pg-scope="density"
      defaultValue="comfortable"
      items={DENSITIES.map((d) => ({ value: d, label: DENSITY_LABEL[d] }))}
    />
    <label class="switch">
      <input type="checkbox" id="pg-outline" />
      <span class="switch-track" aria-hidden="true"></span>
      Outline inspectable parts
    </label>
    <p class="pg-hint small"><Icon name="target" size={16} /> Hover, or tab through the screen, to inspect.</p>
  </div>

  <div class="pg-stage" id="pg-stage" data-view="both">
    <section class="pg-frame" data-theme="light" aria-label="Sample screen, light theme">
      <p class="pg-frame-label"><Icon name="sun" size={14} />Light</p>
      <SampleScreen theme="light" />
    </section>
    <section class="pg-frame" data-theme="dark" aria-label="Sample screen, dark theme">
      <p class="pg-frame-label"><Icon name="moon" size={14} />Dark</p>
      <SampleScreen theme="dark" />
    </section>
  </div>

  <div class="pg-tip" id="pg-tip" role="tooltip" hidden></div>

  <section class="tactile" aria-labelledby="tactile-title">
    <div class="section-head">
      <div>
        <h2 id="tactile-title">Turn the knobs</h2>
        <p>
          Three scales drive most of how a product feels. Try them on the screen above. This is a playground: it changes this preview in your
          browser only, the design system does not change.
        </p>
      </div>
      <Button variant="secondary" size="sm" id="pg-reset">Reset to shipped values</Button>
    </div>

    <div class="knobs">
      <fieldset class="knob knob-radius">
        <legend>Corner radius</legend>
        <p class="knob-value" id="radius-out">As shipped</p>
        <div class="radius-picks">
          {
            radiusOptions.map((o) => (
              <label class={`radius-pick r-${o.key}`}>
                <input type="radio" name="radius" value={o.key} checked={o.key === 'shipped'} />
                <span class="radius-shape" aria-hidden="true" />
                <span>{o.label}</span>
              </label>
            ))
          }
        </div>
        <p class="knob-foot mono">--radius-sm, --radius-md, --radius-lg</p>
      </fieldset>

      <fieldset class="knob knob-density">
        <legend>Density</legend>
        <p class="knob-value" id="density-out">Default</p>
        <div class="density-scale" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <input type="range" id="density" min="0" max="2" step="1" value="1" aria-valuetext="Default" aria-describedby="density-foot" />
        <div class="range-labels" aria-hidden="true"><span>Compact</span><span>Default</span><span>Comfortable</span></div>
        <p class="knob-foot mono" id="density-foot">--space-1 to --space-12</p>
      </fieldset>

      <fieldset class="knob knob-type">
        <legend>Type scale</legend>
        <p class="knob-value"><span id="ratio-out">As shipped</span> <span class="knob-num num" id="ratio-num"></span></p>
        <div class="type-ladder" aria-hidden="true">
          {baseline.fontSize.map((f) => <span style={`font-size: ${f.px}px`} data-size={f.key}>Ag</span>)}
        </div>
        <input type="range" id="ratio" min="0" max={ratios.length - 1} step="1" value="0" aria-valuetext="As shipped" aria-describedby="ratio-foot" />
        <p class="knob-foot mono" id="ratio-foot">--font-size-100 to --font-size-600</p>
      </fieldset>
    </div>
    <Alert tone="info" announce="off" className="lib-tactile-alert">
      Want one of these for real? Propose it with DS Bridge from Figma or open an issue: scale changes are Tier 3 and need both the design and the tech
      owner.
    </Alert>
  </section>

  <script type="application/json" id="pg-data" set:html={JSON.stringify({ baseline, ratios })} />
  <script>
    import { initPlayground } from '../scripts/playground';
    initPlayground();
  </script>
</Layout>
