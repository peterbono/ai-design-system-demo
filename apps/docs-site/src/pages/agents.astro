---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { CodeBlock, Link } from '@bridge-ds/react';
import AgentToolsTable from '../components/ds/AgentToolsTable';
import { GITHUB_URL, readJson, sourceUrl } from '../lib/repo';
import { PAGE_SOURCES, freshness } from '../lib/sources';
import { AI_DOC, mcpPrompts, mcpTools, safetyModel } from '../lib/mcp';
import { buildLlmsTxt } from '../lib/llms';
import '../styles/process.css';
import '../styles/connect.css';
import '../styles/library.css';

const sources = [...new Set([...PAGE_SOURCES.mcp, ...PAGE_SOURCES.agents])];
const updated = freshness(sources);

// llms.txt, counted from the generated text itself so the numbers describe exactly what an agent receives.
const text = buildLlmsTxt();
const lines = text.split('\n');
const sectionOf = (title: string) => {
  const start = lines.findIndex((l) => l === `## ${title}`);
  if (start < 0) return [];
  const end = lines.findIndex((l, i) => i > start && l.startsWith('## '));
  return lines.slice(start + 1, end < 0 ? undefined : end);
};
const stats = [
  { value: lines.length, label: 'lines' },
  { value: sectionOf('Rules for agents (from AGENTS.md)').filter((l) => l.startsWith('- ')).length, label: 'agent rules' },
  { value: sectionOf('Semantic tokens').filter((l) => l.startsWith('- `var(')).length, label: 'semantic tokens' },
  { value: sectionOf('Components').filter((l) => l.startsWith('### ')).length, label: 'components' },
  { value: Math.round(new TextEncoder().encode(text).length / 1024), label: 'KB of plain text' },
];
const tools = mcpTools();
const prompts = mcpPrompts();
const safety = safetyModel();
const MCP_PACKAGE = readJson<{ name: string }>('packages/mcp/package.json').name;
const CLI_PACKAGE = readJson<{ name: string }>('packages/cli/package.json').name;

// The server runs from npm. A GitHub repository is the main path (no clone); a local folder is the alternative.
const npx = ['-y', MCP_PACKAGE];
const claudeCode = `claude mcp add bridge -s user -- npx ${npx.join(' ')} --repo owner/name`;
const desktopRemote = JSON.stringify({ mcpServers: { bridge: { command: 'npx', args: [...npx, '--repo', 'owner/name'] } } }, null, 2);
const claudeCodeLocal = `claude mcp add bridge -- npx ${npx.join(' ')} --root /abs/path/to/your-ds`;
const projectJson = JSON.stringify({ mcpServers: { bridge: { command: 'npx', args: [...npx, '--root', '.'] } } }, null, 2);
const desktopLocal = JSON.stringify({ mcpServers: { bridge: { command: 'npx', args: [...npx, '--root', '/abs/path/to/your-ds'] } } }, null, 2);
const cli = [
  { cmd: 'bridge init', text: 'Detects your token folder, tiers and modes, writes bridge.config.json and .mcp.json, prints the Claude Desktop snippet.' },
  { cmd: 'bridge check', text: 'Validates tokens and runs the contrast gate. Use it in CI: exit 0 ok, 1 failures, 2 setup error.' },
  { cmd: 'bridge tokens <query>', text: 'Searches tokens by words, CSS variable or value.' },
  { cmd: 'bridge diff <base>', text: 'Designer-readable token diff against a git ref, with alias impact, contrast and the risk tier.' },
  { cmd: 'bridge propose --title "..." --set path=value', text: 'Turns token edits into a commit on a new local bridge/* branch. Blocked when a check fails.' },
  { cmd: 'bridge history [token]', text: 'Token history: versions and merged changes, or every change of one token, with who, when and why.' },
  { cmd: 'bridge revert <pr|commit> --dry-run', text: 'Plans the undo of a merged token change against today: conflicts with later changes shown. Without --dry-run, a new local branch.' },
  { cmd: 'bridge impact --plan', text: 'Visual impact: which stories and app screens a change touches. Without --plan, screenshots both refs and pixel-diffs them (needs Chrome).' },
  { cmd: 'bridge audit <path>', text: 'Design system adoption in product code (CSS, TSX, Astro, Vue, Svelte): token and component adoption, hardcoded values with the closest token, native elements to replace, top files. --fix for exact CSS matches.' },
  { cmd: 'bridge mcp', text: `Starts the MCP server on stdio, same as npx ${MCP_PACKAGE}.` },
];
const cliRun = `npx ${CLI_PACKAGE} check`;
const asks = [
  'Which token should this card background use in dark mode?',
  'Darken muted text in the light theme and show me the contrast impact first.',
  'Review the newest open change for the design owner.',
  "Audit this component's CSS for hardcoded values.",
];
import LibraryHeader from '../components/LibraryHeader.astro';
---

<Layout
  title="Agents"
  description="Three ways for AI agents to read and change this design system: the Bridge MCP server, the bridge CLI and llms.txt."
  sources={sources}
  updated={updated}
>
  <LibraryHeader title="Agents" art="guide" updated={updated}>
    Three ways in, all generated from the same token files, components and rules. <a href="#mcp">The MCP server</a> gives Claude Code, Claude Desktop or any MCP client a structured view and proposes changes as pull requests. <a href="#cli">The bridge CLI</a> does the same from a terminal or CI. <a href="#llms">llms.txt</a> is the whole documentation as plain text, for any agent that can read a URL.
  </LibraryHeader>

  <ul class="cx-facts" aria-label="At a glance">
    <li><Icon name="check" size={16} /> Free and open source, MIT</li>
    <li><Icon name="check" size={16} /> Local: no account, no backend</li>
    <li><Icon name="check" size={16} /> Your repo, your Claude, your GitHub token</li>
    <li><Icon name="check" size={16} /> Any DTCG token repo</li>
  </ul>

  <h2 id="llms">llms.txt</h2>
  <p>
    One source, two outputs. The pages you read and the file an agent reads come from the same build, so they cannot disagree.
    <a href="/llms.txt">/llms.txt</a> holds the agent rules from <code>AGENTS.md</code>, every semantic token with its light and dark value, the
    scales, failing contrast pairs, and each component's props and usage rules.
  </p>
  <dl class="stat-strip" aria-label="What /llms.txt contains, counted from the generated file">
    {
      stats.map((s) => (
        <div>
          <dt>{s.label}</dt>
          <dd class="num">{s.value}</dd>
        </div>
      ))
    }
  </dl>
  <ul class="why-list">
    <li>
      <span class="why-icon" aria-hidden="true"><Icon name="layers" size={18} /></span>
      <p>Agents follow short, structured context better than long prose style guides. Values come from the token files, not from a copy.</p>
    </li>
    <li>
      <span class="why-icon" aria-hidden="true"><Icon name="shield" size={18} /></span>
      <p>The hard rules are not only in this text: CI blocks raw colors and shadows, so an agent that ignores the file still cannot merge.</p>
    </li>
  </ul>
  <details class="llms-preview">
    <summary>Preview llms.txt ({lines.length} lines)</summary>
    <CodeBlock className="cx-block" code={text} label="llms.txt" />
    <p class="small"><Link href="/llms.txt">Open raw llms.txt</Link></p>
  </details>

  <h2 id="mcp">MCP server</h2>
  <p>
    Tokens resolved in every brand, theme and density, the contrast gate, components with their props and usage docs, and the agent rules. Claude
    builds UI with real tokens and proposes token changes as pull requests your design and tech owners review.
  </p>

  <h3 id="claude-code">1. Claude Code</h3>
  <p>Connect Claude to your design system repository on GitHub. No clone, nothing to build, and read-only until you add a token:</p>
  <CodeBlock className="cx-block" code={claudeCode} label="Claude Code command" />
  <p>
    To let Claude open changes for review, add <code>-e GITHUB_TOKEN=github_pat_...</code> before <code>--</code>: a fine-grained token limited to that
    one repository, with contents and pull requests read and write. Without a token, GitHub allows 60 requests an hour.
  </p>

  <h3 id="claude-desktop">2. Claude Desktop</h3>
  <p>In Settings, Developer, Edit config, add this to <code>claude_desktop_config.json</code>, then restart Claude Desktop:</p>
  <CodeBlock className="cx-block" code={desktopRemote} label="claude_desktop_config.json" />
  <p class="small muted">For the token, add <code>"env": {"{"} "GITHUB_TOKEN": "github_pat_..." {"}"}</code> next to <code>args</code>.</p>

  <details class="cx-details">
    <summary>Work on a local folder instead of a GitHub repository</summary>
    <p>Pass <code>--root</code> with the path to your design system checkout. Claude Code:</p>
    <CodeBlock className="cx-block" code={claudeCodeLocal} label="Claude Code command for a local folder" />
    <p>
      Or share it with your team through git: a project <code>.mcp.json</code> at the repository root. Claude Code asks you to approve project servers the first time.
    </p>
    <CodeBlock className="cx-block" code={projectJson} label="Project .mcp.json" />
    <p>Claude Desktop:</p>
    <CodeBlock className="cx-block" code={desktopLocal} label="Claude Desktop configuration for a local folder" />
  </details>
  <p class="small muted">
    Other MCP clients work the same way over stdio: <code>npx -y {MCP_PACKAGE} --repo owner/name</code> (add <code>--ref</code> for another
    branch) or <code>--root &lt;dir&gt;</code>. Options can also come from <code>BRIDGE_REPO</code>, <code>BRIDGE_REF</code>, <code>BRIDGE_ROOT</code>
    and <code>GITHUB_TOKEN</code>.
  </p>

  <h3 id="tools">What Claude can do: {tools.length} tools</h3>
  <AgentToolsTable tools={tools} />
  {
    prompts.length > 0 && (
      <>
        <h3>Prompts</h3>
        <p class="small">Slash commands in Claude Code, for example <code>/mcp__bridge__audit-ui-for-tokens</code>.</p>
        <ul class="cx-list">
          {prompts.map((p) => (
            <li>
              <code>{p.name}</code>: <span set:html={p.text} />
            </li>
          ))}
        </ul>
      </>
    )
  }
  <h3>Things to ask</h3>
  <ul class="cx-list">{asks.map((a) => <li>{a}</li>)}</ul>

  <h2 id="cli">bridge CLI</h2>
  <p>The same checks and proposals from a terminal or CI, from npm with nothing to install first. Run it in your design system repository: every command below is <code>npx {CLI_PACKAGE} &lt;command&gt;</code>, starting with <code>check</code>.</p>
  <CodeBlock className="cx-block" code={cliRun} label="Run bridge init" />
  <dl class="cx-cli">
    {
      cli.map((c) => (
        <div>
          <dt>
            <code>{c.cmd}</code>
          </dt>
          <dd>{c.text}</dd>
        </div>
      ))
    }
  </dl>

  <h2 id="safety">Safety model</h2>
  <ul class="why-list">
    {
      safety.map((s) => (
        <li>
          <span class="why-icon" aria-hidden="true">
            <Icon name="shield" size={18} />
          </span>
          <p>
            {s.title && <strong>{s.title}. </strong>}
            <span set:html={s.text} />
          </p>
        </li>
      ))
    }
  </ul>

  <p class="small muted">
    Full guide: <a href={sourceUrl(AI_DOC)}>{AI_DOC}</a>. Source and license: <a href={GITHUB_URL}>GitHub</a>, MIT.
  </p>
</Layout>
