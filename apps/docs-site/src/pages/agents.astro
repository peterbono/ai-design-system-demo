---
// Library > Use > Agents: the shared view (components/ds/library/views/AgentsView.tsx), rendered at build time from
// this build's llms.txt and docs/AI.md.
import Layout from '../layouts/Layout.astro';
import AgentsView from '../components/ds/library/views/AgentsView';
import { siteLibraryData } from '../lib/library-site';
import { siteUseExtras } from '../lib/library-use';
import { PAGE_SOURCES, freshness } from '../lib/sources';
import '../styles/process.css';
import '../styles/connect.css';
import '../styles/library.css';

const sources = [...new Set([...PAGE_SOURCES.mcp, ...PAGE_SOURCES.agents])];
const updated = freshness(sources);
---

<Layout title="Agents" description="Three ways for AI agents to read and change this design system: the Bridge MCP server, the bridge CLI and llms.txt." sources={sources} updated={updated}>
  <AgentsView data={siteLibraryData({ use: siteUseExtras() })} />
</Layout>
