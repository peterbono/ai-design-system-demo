---
// Library > Use > Changelog: the shared view (components/ds/library/views/ChangelogView.tsx), rendered at build time
// from the releases of this build's snapshot (lib/site-snapshot.ts: the CHANGELOG.md files and the pending
// changesets, as a team's snapshot carries them), and hydrated for its folds, package lists and version picker.
import Layout from '../layouts/Layout.astro';
import ChangelogView from '../components/ds/library/views/ChangelogView';
import { bridgeTools, siteUseExtras } from '../lib/library-use';
import { PAGE_SOURCES, freshness } from '../lib/sources';
import { siteSnapshot } from '../lib/site-snapshot';
import '../styles/process.css';

const all = siteSnapshot.releases ?? [];
const updated = all.find((r) => r.date)?.date ?? freshness(PAGE_SOURCES.changelog);
const { versionMenu } = siteUseExtras();
// Only what the view reads: the releases, the version picker and Bridge's repository (the island's props).
const data = { team: null, extras: { releases: all, use: { bridge: bridgeTools(), versionMenu } } };
---

<Layout title="Changelog" description="What changed in the design system, what it means for you, and a message ready to post." sources={['CHANGELOG.md', '.changeset']} updated={updated}>
  <ChangelogView client:load data={data} />
</Layout>
