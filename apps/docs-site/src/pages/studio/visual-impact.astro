---
import '../../styles/reviews.css';
import '../../styles/studio.css';
import Layout from '../../layouts/Layout.astro';
import StudioHeader from '../../components/StudioHeader.astro';
import { lastUpdated, sourceUrl } from '../../lib/repo';

const sources = ['.github/workflows/visual-impact.yml', 'packages/visual/src'];
---

<Layout
  title="Visual impact"
  description="Which stories and product screens each open pull request changes, from screenshots of the base and the head commit."
  sources={sources}
  updated={lastUpdated(sources)}
  wide
>
  <StudioHeader title="Visual impact" subtitle="Stories and product screens each open pull request changes, base against head, pixel by pixel." />
  <p class="rv-notice" id="vi-notice" role="status" hidden></p>
  <p class="st-scope small" id="vi-scope" hidden></p>
  <ul class="st-vi-list" id="vi-list" aria-label="Open pull requests and their visual impact" aria-busy="true">
    <li class="rv-skel" aria-hidden="true"></li>
    <li class="rv-skel" aria-hidden="true"></li>
  </ul>
  <p class="rv-foot-note">
    Screenshots run in CI with <code>bridge impact</code> and land on the <code>bridge-visual</code> branch. Run <code>npm run bridge -- impact --plan</code> to see what a change would capture.
    <a href={sourceUrl('.github/workflows/visual-impact.yml')}>The workflow</a>
  </p>
  <script>
    import { initVisualList } from '../../scripts/visual-list';
    void initVisualList();
  </script>
</Layout>
