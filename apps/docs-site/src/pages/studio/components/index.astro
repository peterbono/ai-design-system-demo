---
// Studio Components: one sentence on the state of the catalog, one primary while guidance is missing, then every
// component grouped by family (search and the family menu filter it), each row with a calm thumbnail of the real
// component and its facts in words. A row opens a drawer, top to bottom: the family as an eyebrow on the name, one
// sentence, ONE live preview with a Light/Dark switch, the facts in one line (a badge only when something waits for
// someone), then one row of actions with a single primary (the guidance while it is missing or in review, else
// "Change this component"). The designer drives a change: the drawer asks what she wants to change, in place, and
// leads to her component's tokens, to an exploration Claude builds from her Figma frame, or to a mismatch report
// (scripts/request-form.ts, lib/change-intent.ts). Token origins, code, the component sandbox, props and file paths
// sit in one "For developers" fold at the bottom.
import '../../../styles/studio.css';
import '../../../styles/components-studio.css';
import '../../../styles/requests.css';
import '../../../styles/preview-frames.css';
import Layout from '../../../layouts/Layout.astro';
import StudioHeader from '../../../components/StudioHeader.astro';
import { siteIcon } from '../../../brand/site-icons';
import ButtonLink from '../../../components/ds/ButtonLink';
import Example from '../../../components/Example';
import ComponentsSearch from '../../../components/ds/studio/ComponentsSearch';
import BridgedSelect from '../../../components/ds/BridgedSelect';
import ComponentsList, { exceptions, type ComponentListRow } from '../../../components/ds/studio/ComponentsList';
import { Badge, Button, Icon, IconButton, Input, Link, SegmentedControl, Textarea } from '@bridge-ds/react';
import { FileText, ImagePlus, Moon, Pencil, Sun, X } from 'lucide-react';
import ChangeIntent from '../../../components/ds/studio/ChangeIntent';
import { GitHubMark, StorybookMark } from '../../../components/ds/studio/brand-icons';
import { docsEditHref, editTokensHref, guidanceState, loadComponents, type ComponentInfo } from '../../../lib/components';
import { componentsLead, componentsPrimary, drawerActions, drawerFacts, productUsage, tokenOrigin } from '../../../lib/components-studio';
import { groupByApp, loadAudits } from '../../../lib/audits';
import { PREVIEW_APPS, PREVIEW_PACKAGES, sourceUrl, STORYBOOK_URL } from '../../../lib/repo';
import { siteRepo } from '../../../lib/config';
import { ghAction } from '../../../lib/gh-wording';
import { signInConfig } from '../../../lib/signin-config';
import { PAGE_SOURCES, freshness } from '../../../lib/sources';

const components = loadComponents();
const updated = freshness(PAGE_SOURCES.components);
const statusOf = (c: ComponentInfo) => c.docs?.status ?? 'stable';
// "Used in products": the DS component instances `bridge audit` counted in each audited product (the committed
// reports under src/data/audits, latest per product). No report: nothing is said about usage.
const audits = groupByApp(loadAudits()).apps.map((a) => {
  const latest = a.after ?? a.reports[a.reports.length - 1]!;
  return { product: a.app.title.replace(/\s*\(.*$/, ''), components: latest.report.components?.ds ?? {}, label: latest.report.label ?? '' };
});
const usage = productUsage(audits, components.map((c) => c.name));
const rows: ComponentListRow[] = components.map((c) => ({
  slug: c.slug,
  name: c.name,
  family: c.category,
  status: statusOf(c),
  guidance: guidanceState(c),
  tokensTotal: c.allTokenPaths.length,
  examples: c.stories.length,
  preview: c.docs?.preview,
  usedIn: audits.length ? (usage.get(c.name) ?? []) : undefined,
}));
const families = [...new Set(rows.map((r) => r.family))].map((f) => ({ name: f, n: rows.filter((r) => r.family === f).length }));
const lead = componentsLead(rows);
const primary = componentsPrimary(rows, docsEditHref);
const docsLabel = (g: string) => (g === 'missing' ? 'Add guidance' : g === 'review' ? 'Review guidance' : 'Edit docs');
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
// Add a variant or option starts an exploration: the repository and its preview settings, as Changes embeds them.
const site = siteRepo();
const branchesJson = JSON.stringify({ owner: site.owner, repo: site.repo, defaultBranch: site.defaultBranch, apps: PREVIEW_APPS, packages: PREVIEW_PACKAGES }).replace(/</g, '\\u003c');
const signIn = Boolean(signInConfig());
---

<Layout
  title="Components"
  description="Every component by family, with a live thumbnail, the products that use it, open requests, examples and tokens, and the doors to edit its docs and tokens."
  sources={PAGE_SOURCES.components}
  updated={updated}
  wide
>
  <div class="cm">
    <StudioHeader title="Components">
      <p class="cm-lead">
        {lead.status}
        {lead.guidance && (
          <>
            {' '}
            <Button variant="link" pressed={false} data-cm-guidance title="Show only these">
              {lead.guidance.replace(/\.$/, '')}
            </Button>{lead.guidance.endsWith('.') && '.'}
          </>
        )}
      </p>
      {primary && <Fragment slot="actions"><ButtonLink variant="primary" href={primary.href} iconStart={FileText} data-latest-only>{primary.label}</ButtonLink></Fragment>}
    </StudioHeader>
    <div class="view-banner" data-view-banner hidden></div>

    <div class="cm-tools" role="search">
      <ComponentsSearch />
      <BridgedSelect
        client:load
        id="cm-fam"
        label="Family"
        hideLabel
        className="cm-fam"
        value=""
        options={[{ value: '', label: 'All families', count: rows.length }, ...families.map((f) => ({ value: f.name, label: f.name, count: f.n }))]}
      />
    </div>
    <p class="cm-count" data-cm-count role="status" aria-live="polite"></p>

    <ComponentsList rows={rows} products={audits.length} />
    <p class="cm-none" data-cm-none hidden>No component matches. <Button variant="link" data-cm-reset>Show every component</Button></p>
    {audits.length > 0 && <p class="cm-note">Used in names the audited products that render the component ({audits.map((a) => a.product).join(' and ')}), from their last <Link href="/studio/quality/">audit report</Link>. Open requests counts the change requests not shipped yet.</p>}
  </div>

  <div class="cm-scrim" data-cm-scrim hidden></div>
  <aside class="cm-drawer" role="dialog" aria-modal="true" aria-labelledby="cm-d-title" data-cm-drawer hidden>
    <header class="cm-d-head">
      <hgroup class="cm-d-names">
        <p class="cm-d-eyebrow" data-cm-d-family></p>
        <h2 id="cm-d-title" class="cm-d-title" tabindex="-1" data-cm-d-title>Component</h2>
      </hgroup>
      <IconButton icon={X} label="Close" size="sm" data-cm-close />
    </header>
    {
      components.map((c) => {
        const r = rows.find((x) => x.slug === c.slug)!;
        const tokensHref = editTokensHref(c);
        const acts = drawerActions({ guidance: r.guidance });
        const action = (a: 'docs' | 'change', variant: 'primary' | 'secondary') =>
          a === 'docs' ? (
            <ButtonLink variant={variant} href={docsEditHref(c.slug)} iconStart={variant === 'primary' ? FileText : undefined}>
              {docsLabel(r.guidance)}
            </ButtonLink>
          ) : (
            <Button variant={variant} iconStart={variant === 'primary' ? Pencil : undefined} data-cm-change-open aria-expanded="false" aria-controls="cm-chg">
              Change this component
            </Button>
          );
        return (
          <section class="cm-d-panel" data-cm-panel={c.slug} data-name={c.name} data-family={c.category} data-tokens-href={tokensHref ?? ''} hidden>
            <p class="cm-d-summary">
              {c.docs?.summary ?? c.description ?? 'No summary yet.'}{' '}
              <Link href={`/components/${c.slug}/`}>Open in the Library</Link>
            </p>
            {c.docs?.preview ? (
              <figure class="cm-d-preview" aria-label={`${c.name}, live`}>
                <div class="xe-frame cm-d-frame" data-theme="light" data-cm-d-frame aria-hidden="true" inert>
                  <div class="xe-fit">
                    <Example node={c.docs!.preview!} />
                  </div>
                </div>
                <figcaption class="cm-d-pv-bar" data-cm-pv-slot />
              </figure>
            ) : (
              <p class="cm-d-nopv">No preview: the guidance has no example to render.</p>
            )}
            <p class="cm-d-facts">
              {exceptions(r).map((b) => (
                <Badge tone={b.tone} size="sm" className="cm-d-badge">{b.label}</Badge>
              ))}
              <span>{drawerFacts({ guidance: r.guidance, tokens: r.tokensTotal, usedIn: r.usedIn }).join(' ')}</span>
              <span data-cm-d-req />
            </p>
            <div class="cm-d-actions">
              {action(acts.primary, 'primary')}
              {acts.secondary.map((a) => action(a, 'secondary'))}
            </div>
          </section>
        );
      })
    }
    {/* One Light/Dark switch for the whole drawer: scripts/components-studio.ts moves it under the open preview. */}
    <div class="cm-d-shared" data-cm-shared hidden>
      <SegmentedControl
        label="Preview theme"
        data-vanilla
        data-cm-theme
        size="sm"
        defaultValue="light"
        items={[
          { value: 'light', label: 'Light', icon: Sun },
          { value: 'dark', label: 'Dark', icon: Moon },
        ]}
      />
    </div>
    {/* Change this component, in place under the component (scripts/request-form.ts): what she wants to change, then
        the flow that does it. One form serves "Add a variant or option" (it starts an exploration), "Ask a developer"
        and "Report a mismatch"; its words change with the choice (lib/change-intent.ts). */}
    <section class="cm-req cm-chg" id="cm-chg" data-cm-chg aria-label="Change this component" hidden>
      <ChangeIntent client:load />
      <div class="rq-actions" data-cm-chg-foot>
        <ButtonLink variant="primary" href="/studio/tokens/" iconStart={Pencil} data-cm-look data-keep-branch="" hidden>Edit its tokens</ButtonLink>
        <Button variant="ghost" data-cm-chg-cancel>Cancel</Button>
      </div>
      <form class="rq-form cm-chg-form" id="cm-req-form" data-cm-req-form aria-labelledby="cm-chg-form-title" novalidate hidden>
        <h3 class="cm-chg-title" id="cm-chg-form-title" data-cm-form-title>Describe the new option</h3>
        <Input label="What to add" name="title" autoComplete="off" placeholder="A danger ghost variant" required />
        <Textarea label="What it is for" name="summary" rows={3} placeholder="Where you need it, and how it differs from what we have." required />
        <Input label="Figma link (optional)" name="figma" type="url" inputMode="url" autoComplete="off" placeholder="https://www.figma.com/design/..." hint="In Figma, right-click the frame, then Copy link to selection." />
        <div class="cm-req-img" data-rq-image-box>
          <span class="cm-req-img-label" id="cm-req-img-label">Image (optional)</span>
          <p class="cm-req-img-hint" data-rq-image-hint>Paste a screenshot anywhere in this form, or attach a file. PNG, JPEG, GIF or WebP, up to 5 MB.</p>
          <!-- bridge-audit-ignore-next-line: hidden file picker behind the DS Button "Attach an image"; the DS has no file input -->
          <input class="sr-only" type="file" accept="image/png,image/jpeg,image/gif,image/webp" tabindex="-1" aria-hidden="true" data-rq-image-file />
          <Button variant="secondary" size="sm" className="cm-req-start" type="button" iconStart={ImagePlus} aria-describedby="cm-req-img-label" data-rq-image-pick>Attach an image</Button>
          <div class="cm-req-img-preview" data-rq-image-preview hidden>
            <img alt="Attached image" data-rq-image-img />
            <Button variant="ghost" size="sm" type="button" data-rq-image-remove>Remove image</Button>
          </div>
        </div>
        <fieldset class="rq-changes cm-req-changes" data-rq-changes hidden>
          <legend>What differs (optional)</legend>
          <div class="cm-req-change" data-rq-change>
            <Input name="field" aria-label="What differs" placeholder="What: radius" autoComplete="off" size="sm" />
            <Input name="before" aria-label="Now" placeholder="Now: 12" autoComplete="off" size="sm" />
            <Input name="after" aria-label="In Figma" placeholder="In Figma: 6" autoComplete="off" size="sm" />
          </div>
          <Button variant="ghost" size="sm" className="cm-req-start" type="button" data-rq-add-row>Add a row</Button>
        </fieldset>
        <p class="rq-error" role="alert" data-rq-error hidden></p>
        <div class="rq-actions">
          <Button variant="primary" type="submit" data-rq-submit data-gh-only hidden>Start exploration</Button>
          <Button variant="primary" iconStart={GitHubMark} data-gh-open data-no-gh data-cm-connect>{ghAction('start', signIn)}</Button>
          <Button variant="ghost" data-cm-chg-cancel>Cancel</Button>
        </div>
        <Button variant="ghost" size="sm" className="cm-req-start" data-cm-ask>Ask a developer instead</Button>
      </form>
    </section>
    <div class="rq-done cm-chg-done" role="status" data-rq-done hidden></div>
    {
      components.map((c) => {
        const story = c.stories[0];
        return (
          <details class="cm-d-dev" data-cm-dev={c.slug} hidden>
            <summary>
              <Icon icon={siteIcon('code')} size="md" className="icon" />
              <span class="cm-d-dev-label">For developers</span>
              <span class="cm-d-dev-chev"><Icon icon={siteIcon('chevron')} size="sm" className="icon" /></span>
            </summary>
            <div class="cm-d-dev-body">
              <dl class="cm-d-dev-facts">
                <div>
                  <dt>Tokens</dt>
                  <dd>{tokenOrigin(c.tokenPaths.length, c.inherited)}</dd>
                </div>
                <div>
                  <dt>API</dt>
                  <dd>{plural(c.props.length, 'prop')}, {plural(c.stories.length, 'Storybook story', 'Storybook stories')}.</dd>
                </div>
                <div>
                  <dt>Files</dt>
                  <dd><code>{c.files.tsx.replace(/[^/]+$/, '')}</code></dd>
                </div>
              </dl>
              <ul class="cm-d-links" aria-label={`${c.name} for developers`}>
                <li>
                  <Link variant="standalone" href={sourceUrl(c.files.tsx)}>
                    <Icon icon={GitHubMark} size="xs" />
                    Code
                  </Link>
                </li>
                {story && (
                  <li>
                    <Link variant="standalone" href={`${STORYBOOK_URL}/?path=/story/${story.id}`}>
                      <Icon icon={StorybookMark} size="xs" />
                      Component sandbox
                    </Link>
                  </li>
                )}
              </ul>
            </div>
          </details>
        );
      })
    }
  </aside>

  <script type="application/json" id="bridge-branches" set:html={branchesJson} />
  <script>
    import { initComponentsStudio } from '../../../scripts/components-studio';
    initComponentsStudio();
  </script>
</Layout>
