---
// The separate Studio docs editor became the Library page's edit mode: /studio/components/docs/<slug>/ now lands on
// /components/<slug>/?edit=1, with ?pr and ?ref carried over (editing the docs of an open change).
import { docsEditHref, loadComponents } from '../../../../lib/components';
import { redirectScript } from '../../../../lib/redirects';

export function getStaticPaths() {
  return loadComponents().map((c) => ({ params: { slug: c.slug } }));
}

const to = docsEditHref(Astro.params.slug!);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to {to}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={to} />
    <Fragment set:html={redirectScript(to)} />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
  </head>
  <body>
    <a href={to}>Edit the docs on the Library page</a>
  </body>
</html>
