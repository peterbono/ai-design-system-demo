---
// Where Claude sends the person when they add the Bridge connector (api/mcp, docs/FIGMA-FIXES.md "Bridge inside your
// team's Claude"). Not in the nav. Standalone (Layout bare): the Bridge mark and one focused card, no team, no demo
// banner, no Studio nav, since the three contexts (demo, empty workspace, real team) are never mixed. The person picks
// the team; GitHub confirms who they are; they go back to Claude.
import Layout from '../../layouts/Layout.astro';
import { Card } from '@bridge-ds/react';
import ConnectClaude from '../../components/ds/studio/ConnectClaude';
import { CLAUDE_CONNECT_WORDS as W } from '../../lib/connect-claude';
---

<Layout title={W.title} description="Use Bridge inside your team's Claude." bare>
  <div class="cc">
    <Card className="cc-card" aria-labelledby="cc-title">
      <h1 id="cc-title" class="cc-title">{W.title}</h1>
      <ConnectClaude client:load />
    </Card>
  </div>
</Layout>

<style>
  .cc {
    display: grid;
    place-items: start center;
    padding: var(--space-10) var(--space-4);
  }

  .cc :global(.cc-card) {
    display: grid;
    gap: var(--space-4);
    width: 100%;
    max-width: var(--size-120);
    padding: var(--space-7);
  }

  .cc-title {
    margin: 0;
    font-family: var(--typography-h2-family);
    font-size: var(--typography-h2-size);
    font-weight: var(--typography-h2-weight);
    letter-spacing: var(--typography-h2-tracking);
    line-height: var(--typography-h2-line-height);
  }

  .cc :global(.cc-step) {
    display: grid;
    gap: var(--space-4);
  }

  .cc :global(.cc-step p) {
    margin: 0;
  }

  .cc :global(.cc-lede) {
    font-weight: var(--font-weight-semibold);
  }

  .cc :global(.cc-gets) {
    display: grid;
    gap: var(--space-2);
  }

  .cc :global(.cc-gets ul) {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cc :global(.cc-gets li) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .cc :global(.cc-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 640px) {
    .cc {
      padding: var(--space-5) var(--space-4);
    }

    .cc :global(.cc-card) {
      padding: var(--space-5);
    }
  }
</style>
