---
// Studio Overview, in the order a designer reads it (Linear home: my queue, then what moves):
//   1. One sentence and one primary action, "Start a change". The Harbor zone opens only when something needs the
//      viewer, and then holds the Needs you list: every designer decision in one list, one row component.
//   2. In flight: a board in four columns, Exploring, In review, Ready to ship, Next release, blockers written on
//      the cards (lib/overview-board.ts).
//   3. Library health: three figures, each a door to Quality.
import '../../styles/overview.css';
import Layout from '../../layouts/Layout.astro';
import Illustration from '../../components/Illustration.astro';
import ButtonLink from '../../components/ds/ButtonLink';
import StartChange from '../../components/ds/studio/StartChange';
import { Button, Card, CardBody, Link, Skeleton } from '@bridge-ds/react';
import { releases } from '../../lib/changelog';
import { docsEditHref, guidanceState, loadComponents } from '../../lib/components';
import { git } from '../../lib/repo';
import { PAGE_SOURCES, freshness } from '../../lib/sources';
import { dashboard } from '../../lib/stats';
import { groupByApp, loadAudits } from '../../lib/audits';
import { healthFigures, type BoardRelease } from '../../lib/overview-board';

const s = dashboard();
const comps = loadComponents();

// Usage guidance, from the repo at build time: one Needs you row for what Claude drafted, one for what is missing.
const item = (c: (typeof comps)[number]) => ({ name: c.name, href: docsEditHref(c.slug) });
const guidance = {
  drafted: comps.filter((c) => guidanceState(c) === 'review').map(item),
  missing: comps.filter((c) => guidanceState(c) === 'missing').map(item),
};

// Next release: changes shipped since the last release (pending changesets). The board keeps the design system ones.
// Who wrote each: the GitHub login of the commit that added it, only when its email names one.
const loginOf = (ref: string): string | null => {
  const email = git(['log', '--diff-filter=A', '--format=%ae', '-1', '--', ref]);
  return email.match(/^\d+\+([\w-]+)@users\.noreply\.github\.com$/)?.[1] ?? null;
};
const release: BoardRelease[] = releases()
  .filter((r) => r.pending)
  .flatMap((r) => r.entries)
  .filter((e) => e.source === 'changeset')
  .map((e) => ({ ref: e.ref ?? e.title, title: e.title, packages: e.packages, bump: e.bump, author: e.ref ? loginOf(e.ref) : null }));

// Library health, from the same data as Quality: the contrast gate, the adoption reports, the guidance state.
const appGroups = groupByApp(loadAudits()).apps;
const figures = healthFigures({
  contrast: { total: s.contrast.total, fail: s.contrast.fail, brands: s.brands },
  adoption: appGroups
    .filter((g) => g.after ?? g.before)
    .map((g) => ({ now: (g.after ?? g.before)!.report.metrics, before: g.after ? g.before?.report.metrics : null })),
  guidance: {
    total: comps.length,
    reviewed: comps.filter((c) => guidanceState(c) === 'ok').length,
    drafted: guidance.drafted.length,
    missing: guidance.missing.length,
  },
});

const pickable = comps.map((c) => ({ name: c.name, slug: c.slug, family: c.category })).sort((a, b) => a.name.localeCompare(b.name));
const COLUMNS = ['Exploring', 'In review', 'Ready to ship', 'Next release'];
---

<Layout
  title="Overview"
  description="What needs you, what is in flight and how the library is doing: the Studio's starting point."
  sources={PAGE_SOURCES.home}
  updated={freshness(PAGE_SOURCES.home)}
  wide
>
  <div class="ov">
    <section class="ov-greet zone" data-greet aria-labelledby="ov-hello">
      <div class="ov-greet-head">
        <h1 id="ov-hello" class="ov-hello">
          <span data-hello>Hello.</span>
          <span data-todo-headline>Checking what needs you.</span>
        </h1>
        <div class="ov-start"><StartChange client:load components={pickable} /></div>
      </div>
      <p class="t-body ov-note" data-todo-note hidden></p>
      <ul class="ov-todo" data-todo-list aria-label="Needs you" aria-busy="true">
        <li class="ov-todo-row" aria-hidden="true"><Skeleton variant="text" /></li>
      </ul>
      <p class="ov-todo-more" data-todo-more hidden>
        <Button variant="ghost" size="sm" data-todo-more-btn>Show all</Button>
      </p>
      <Illustration name="review" width={112} class="ov-greet-art" />
    </section>

    <template data-todo-row>
      <li class="ov-todo-row">
        <span class="ov-todo-text"><b class="t-body" data-title></b><span class="t-ui t-muted" data-why></span></span>
        <ButtonLink variant="secondary" href="/studio/changes/" data-act>Open change</ButtonLink>
      </li>
    </template>

    <section class="ov-section" aria-labelledby="ov-flight-title">
      <header class="ov-section-head">
        <h2 id="ov-flight-title" class="t-body ov-section-title">In flight</h2>
        <p class="t-ui t-muted ov-section-line" data-flight-line>Reading changes from GitHub.</p>
        <Link variant="standalone" href="/studio/changes/" className="t-ui ov-section-link">Open Changes</Link>
      </header>
      <div data-board>
        <div class="ov-board" aria-busy="true">
          {
            COLUMNS.map((c) => (
              <section class="ov-col" aria-label={c}>
                <h3 class="t-ui ov-col-head">
                  <span>{c}</span>
                </h3>
                <Skeleton variant="rect" className="ov-col-skel" />
              </section>
            ))
          }
        </div>
      </div>
      <script type="application/json" id="ov-release" set:html={JSON.stringify(release)} />
    </section>

    <section class="ov-section" aria-labelledby="ov-health-title">
      <header class="ov-section-head">
        <h2 id="ov-health-title" class="t-body ov-section-title">Library health</h2>
        <Link variant="standalone" href="/studio/quality/" className="t-ui ov-section-link">Open Quality</Link>
      </header>
      <ul class="ov-health">
        {
          figures.map((f) => (
            <li>
              <Card interactive>
                <CardBody className={f.tone === 'fail' ? 'ov-fig is-fail' : 'ov-fig'}>
                  <p class="ov-fig-value">{f.value}</p>
                  <p class="t-body ov-fig-label">
                    <Link href={f.href} variant="subtle" data-card-primary>
                      {f.label}
                    </Link>
                  </p>
                  {f.detail && <p class="t-ui t-muted ov-fig-detail">{f.detail}</p>}
                </CardBody>
              </Card>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <script>
    import { entryLabel, loadProtection } from '@bridge-ds/core';
    import type { Root } from 'react-dom/client';
    import { currentViewer, ghGet, hasWorkingToken, initGitHubConnect, readRepo, RateLimitError, studioClient } from '../../scripts/github-session';
    import { loadStatuses, owners, shippers, teamPeople, type PullForStatus, type PullStatus } from '../../scripts/pr-status';
    import { loadTeams } from '../../scripts/teams';
    import { oneLineTitle } from '../../lib/markdown';
    import { byUrgency, needFromStatus, whoActs, type WhoActs } from '../../lib/changes';
    import { reviewQueue } from '../../lib/review-queue';
    import { humanTitle } from '../../lib/pr-title';
    import { overviewProtectionLine } from '../../lib/protection-view';
    import { isGuidanceChange, NEEDS_MAX, moreLabel, overviewTodo, type GuidanceItem, type TodoRequest, type TodoRow } from '../../lib/overview-todo';
    import { boardColumns, inFlightLine, type BoardRelease } from '../../lib/overview-board';
    import { explorationRows, type ExplorationPullLike } from '../../lib/explorations-view';
    import { manifestPublished } from '../../scripts/reviews/visual-impact';
    import type { PullLike } from '../../lib/requests-view';
    import { loadRequestRows } from '../../scripts/requests';
    import { paintOverviewBoard } from '../../components/ds/studio/OverviewBoard';

    interface Pull extends PullForStatus {
      state: string;
      title: string;
      updated_at: string;
      labels?: { name?: string }[];
      html_url: string;
    }

    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel);
    const greet = $('[data-greet]');
    const hello = $('[data-hello]');
    const headline = $('[data-todo-headline]');
    const note = $('[data-todo-note]');
    const todoList = $('[data-todo-list]');
    const more = $('[data-todo-more]');
    const moreBtn = $<HTMLButtonElement>('[data-todo-more-btn]');
    const boardEl = $('[data-board]');
    const flightLine = $('[data-flight-line]');

    const readJson = <T,>(id: string, fallback: T): T => {
      try {
        return JSON.parse(document.getElementById(id)?.textContent || '') as T;
      } catch {
        return fallback;
      }
    };
    const release = readJson<BoardRelease[]>('ov-release', []);
    const guidance = readJson<{ drafted: GuidanceItem[]; missing: GuidanceItem[] }>('ov-guidance', { drafted: [], missing: [] });

    // Everything the page is made of. Each source fills its part and repaints.
    const state = {
      all: [] as Pull[],
      open: [] as Pull[],
      statuses: new Map<number, PullStatus | null>(),
      loaded: false,
      done: false,
      failed: false,
      requests: [] as TodoRequest[],
      unprotected: false,
      /** Before and after published for the head commit of a change that waits for the viewer's design review. */
      visual: new Map<number, 'ready' | null>(),
      expanded: false,
    };
    let boardRoot: Root | null = null;

    const siteOwners = () => {
      const o = owners();
      return [...new Set([...o.design, ...o.tech])];
    };
    // The owners as the config names them: a GitHub team reads "@acme/design (4 people)".
    const ownerNames = () => {
      const { entries, teams } = teamPeople();
      return [...new Set([...entries.design, ...entries.tech].map((e) => entryLabel(e, teams)))];
    };
    const overrideBy = (): string[] => {
      try {
        return (JSON.parse(document.getElementById('bridge-repo')?.textContent || '{}') as { override?: { allowed?: string[] } }).override?.allowed ?? [];
      } catch {
        return [];
      }
    };

    /** Who acts now on a change, for the connected viewer (same rules as the change detail). */
    const whoFor = (p: Pull, st: PullStatus | null | undefined): WhoActs | null =>
      st
        ? whoActs(needFromStatus(st.kind, { failing: st.failing, changesRequestedBy: st.changesRequested }), {
            owners: owners(),
            shippers: shippers(),
            ...teamPeople(),
            overrideBy: overrideBy(),
            author: p.user.login,
            viewer: currentViewer()?.login ?? null,
            approvers: st.approvers,
          })
        : null;

    const urgent = () => {
      const byNum = new Map(state.open.map((p) => [p.number, p]));
      return byUrgency(state.open.map((p) => ({ number: p.number, kind: state.statuses.get(p.number)?.kind ?? null, updated_at: p.updated_at }))).map((o) => byNum.get(o.number)!);
    };

    /** One Needs you row: what, why, and the task on a DS button, on the same line. */
    function rowEl(r: TodoRow): HTMLElement {
      const tpl = document.querySelector<HTMLTemplateElement>('template[data-todo-row]')!;
      const li = (tpl.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
      li.dataset.key = r.key;
      li.querySelector('[data-title]')!.textContent = r.title;
      li.querySelector('[data-why]')!.textContent = r.why;
      const a = li.querySelector<HTMLAnchorElement>('[data-act]')!;
      a.href = r.href;
      a.textContent = r.action;
      a.setAttribute('aria-label', `${r.action}: ${r.title}`);
      return li;
    }

    function changesNow() {
      return urgent().map((p) => {
        const st = state.statuses.get(p.number);
        const visual = st?.touchesVisuals === false ? ('none' as const) : (state.visual.get(p.number) ?? null);
        return {
          number: p.number,
          author: p.user.login,
          title: oneLineTitle(humanTitle(p.title)),
          who: whoFor(p, st),
          failing: st?.failing,
          failingChecks: st?.failingChecks,
          changesBy: st?.changesRequested,
          visual,
          guidance: isGuidanceChange(p.head.ref, st?.guidanceOnly),
        };
      });
    }

    function paint() {
      if (!headline || !todoList) return;
      const viewer = currentViewer()?.login ?? null;
      const changes = changesNow();
      const t = overviewTodo({ changes, requests: state.requests, viewer, owners: siteOwners(), ownerNames: ownerNames(), unprotected: state.unprotected, loading: !state.done, guidance });
      // Statuses still loading: the sentence waits for them rather than promising "all caught up".
      const checking = !state.failed && (!state.loaded || (viewer && !state.done && state.open.length > 0));
      const mine = t.mine;
      headline.textContent = checking && !mine.length ? 'Checking what needs you.' : t.headline;
      // The Harbor zone opens only when something needs the viewer; otherwise one quiet line.
      greet?.classList.toggle('zone', Boolean(mine.length) || Boolean(checking));
      greet?.classList.toggle('is-quiet', !mine.length && !checking);
      todoList.removeAttribute('aria-busy');
      const shown = state.expanded ? mine : mine.slice(0, NEEDS_MAX);
      todoList.replaceChildren(...shown.map(rowEl));
      todoList.hidden = mine.length === 0;
      if (more && moreBtn) {
        const label = state.expanded ? '' : moreLabel(mine.length);
        more.hidden = !label;
        moreBtn.textContent = label;
      }
      if (note && !state.failed) {
        note.textContent = !viewer && mine.length ? 'Connect GitHub to see what waits for you.' : '';
        note.hidden = !note.textContent;
      }
      paintBoard(changes, viewer);
    }

    function paintBoard(changes: ReturnType<typeof changesNow>, viewer: string | null) {
      if (!boardEl || state.failed) return;
      const { owner, repo, defaultBranch } = readRepo();
      const explorations = state.loaded
        ? explorationRows(state.all as unknown as ExplorationPullLike[], { owner, repo, defaultBranch, apps: {}, packages: [] })
            .filter((r) => r.status === 'active')
            .map((r) => ({ number: r.number, name: r.name, author: r.author }))
        : [];
      const cols = boardColumns({ explorations, changes: state.loaded ? changes : [], release, viewer, loading: !state.done });
      if (!state.loaded) return;
      boardRoot = paintOverviewBoard(boardEl, cols, boardRoot);
      if (flightLine) flightLine.textContent = inFlightLine(cols);
    }

    moreBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      state.expanded = true;
      paint();
    });

    /**
     * Whether the visual impact run published before and after images for the changes that wait for the viewer's
     * design review, so their row can say so. Connected only (a few reads per change), never for a change that
     * touches nothing visual.
     */
    async function loadVisuals() {
      const viewer = currentViewer()?.login ?? null;
      if (!viewer || !hasWorkingToken()) return;
      const { owner, repo } = readRepo();
      const review = state.open.filter((p) => {
        const st = state.statuses.get(p.number);
        const who = whoFor(p, st);
        return st?.touchesVisuals !== false && who && ['approve-design', 'approve', 'override'].includes(who.action) && (who.yourTurn || who.logins.includes(viewer));
      });
      for (const p of review) {
        const ready = await manifestPublished(owner, repo, p.number, p.head.sha).catch(() => false);
        state.visual.set(p.number, ready ? 'ready' : null);
      }
      if (review.length) paint();
    }

    // "Hello Florian." only when a GitHub login is known (first word of the profile name, else the login).
    initGitHubConnect(async (v) => {
      const viewer = v ?? currentViewer();
      if (hello) {
        const name = viewer ? (viewer.name?.trim().split(/\s+/)[0] ?? viewer.login) : '';
        hello.textContent = name ? `Hello ${name}.` : 'Hello.';
      }
      paint();
      // Owners only: a setup row when nothing protects the library.
      // GitHub teams in the owner lists count as their members (no request without teams).
      await loadTeams();
      const o = owners();
      const isOwner = Boolean(v && [...o.design, ...o.tech].includes(v.login));
      if (!isOwner || !hasWorkingToken()) {
        state.unprotected = false;
      } else {
        const r = readRepo();
        state.unprotected = Boolean(overviewProtectionLine(await loadProtection(studioClient(`${r.owner}/${r.repo}`), r.defaultBranch), isOwner));
      }
      paint();
    });

    const r = readRepo();
    ghGet<Pull[]>(`/repos/${r.owner}/${r.repo}/pulls?state=open&per_page=100`)
      .then((f) => {
        state.all = f.data;
        // The review queue: the same list, and so the same count, as the nav badge and the In review tab.
        state.open = reviewQueue(f.data).sort((a, b) => b.updated_at.localeCompare(a.updated_at));
        state.statuses = new Map(state.open.map((p) => [p.number, null]));
        state.loaded = true;
        paint();
        // Component change requests: from the open pull requests read above plus one cached issues list.
        void loadRequestRows({ openPulls: f.data as unknown as PullLike[], closed: false })
          .then((rows) => {
            state.requests = rows;
            paint();
          })
          .catch(() => undefined);
        void loadStatuses(state.open, (p, st) => {
          state.statuses.set(p.number, st);
          paint();
        }).then(async () => {
          state.done = true;
          paint();
          await loadVisuals();
        });
      })
      .catch((err) => {
        state.failed = true;
        // What the repo knows still shows (guidance); what GitHub holds says how to get it back.
        state.done = true;
        state.loaded = false;
        paint();
        if (note) {
          note.hidden = false;
          note.textContent =
            err instanceof RateLimitError
              ? 'GitHub limits anonymous reads to 60 an hour and this browser has used them. Connect GitHub, or try again later.'
              : 'GitHub could not be reached. Open Changes to retry.';
        }
        if (flightLine) flightLine.textContent = 'Changes are out of reach for now.';
        boardEl?.replaceChildren();
      });
  </script>
  <script type="application/json" id="ov-guidance" set:html={JSON.stringify(guidance)} />
</Layout>
