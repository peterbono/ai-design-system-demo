---
import '../../styles/dashboard.css';
import '../../styles/reviews.css';
import '../../styles/studio.css';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Donut from '../../components/charts/Donut.astro';
import StackedBars from '../../components/charts/StackedBars.astro';
import ContrastWaffle from '../../components/charts/ContrastWaffle.astro';
import { releases } from '../../lib/changelog';
import { GITHUB_URL } from '../../lib/repo';
import { PAGE_SOURCES, freshness } from '../../lib/sources';
import { dashboard, humanDate, repoStatus } from '../../lib/stats';
import type { IconName } from '../../brand/icons';

const s = dashboard();
const repo = repoStatus();
const failing = s.contrast.fail;
const ratePct = Math.round(s.contrast.rate * 1000) / 10;

const recent = releases()
  .flatMap((r) => r.entries.map((e) => ({ ...e, release: r.name, pending: r.pending, date: e.date ?? r.date })))
  .slice(0, 6);
const kindTone: Record<string, string> = { Breaking: 'is-fail', New: 'is-info', Fix: 'is-pass', Docs: 'is-accent' };

const flow: { icon: IconName; title: string; text: string }[] = [
  { icon: 'figma', title: 'Propose in Figma', text: 'DS Bridge turns a variable or component change into a pull request.' },
  { icon: 'pr', title: 'Pull request', text: 'A diff on a branch, with a risk tier and a changelog entry.' },
  { icon: 'ci', title: 'CI guardrails', text: 'Tokens build, types check, no raw colors, Storybook builds.' },
  { icon: 'review', title: 'Design and tech review', text: 'Both themes, contrast and focus checked. Token changes need both owners.' },
  { icon: 'merge', title: 'Merge', text: 'A person who owns the area merges. Agents never do.' },
  { icon: 'doc', title: 'Docs update', text: 'This app, llms.txt and Figma variables rebuild from the same files.' },
];

---

<Layout
  title="Overview"
  description="What waits for review, the health of the design system and recent activity: the Studio's starting point."
  sources={PAGE_SOURCES.home}
  updated={freshness(PAGE_SOURCES.home)}
  wide
>
  <header class="page-head">
    <div>
      <h1>Overview</h1>
      <p class="lead">What waits for a decision, how healthy the system is, and what changed lately. Every number comes from the repository as it was built, plus open pull requests read live from GitHub.</p>
    </div>
    <div class="page-head-actions">
      <a class="btn btn-secondary" href="/studio/drafts/" data-keep-branch><Icon name="draft" size={16} />Drafts</a>
      <a class="btn btn-primary" href="/studio/tokens/" data-keep-branch><Icon name="edit" size={16} />Edit tokens</a>
    </div>
  </header>

  <section class="panel st-review" aria-labelledby="st-review-title">
    <header class="panel-head">
      <h3 id="st-review-title">To review</h3>
      <a href="/studio/reviews/" class="panel-link" data-keep-branch>All reviews</a>
    </header>
    <ul class="st-review-list" id="st-review-list" aria-busy="true">
      <li class="rv-skel" aria-hidden="true"></li>
      <li class="rv-skel" aria-hidden="true"></li>
    </ul>
    <p class="st-review-foot muted small" id="st-drafts-line">
      <Icon name="draft" size={14} />
      <span><a href="/studio/drafts/" data-keep-branch>Drafts in this browser</a>: <strong class="num" data-drafts-count>0</strong></span>
    </p>
  </section>

  <section class="kpis" aria-label="System at a glance">
    <a class="kpi" href="/studio/tokens/" data-keep-branch>
      <span class="kpi-label">Tokens</span>
      <strong class="kpi-value num">{s.total}</strong>
      <span class="kpi-sub num">{s.primitives} primitive, {s.brandTokens} brand, {s.semantic} semantic, {s.componentTokens} component</span>
    </a>
    <a class="kpi" href="/playground/">
      <span class="kpi-label">Modes</span>
      <strong class="kpi-value num">{s.brands * s.themes * s.densities}</strong>
      <span class="kpi-sub num">{s.brands} brands x {s.themes} themes x {s.densities} densities</span>
    </a>
    <a class="kpi" href="/studio/components/" data-keep-branch>
      <span class="kpi-label">Components</span>
      <strong class="kpi-value num">{s.components}</strong>
      <span class="kpi-sub num">{s.documented} with usage guidance</span>
    </a>
    <a class="kpi" href="/studio/checks/" data-keep-branch>
      <span class="kpi-label">Contrast AA</span>
      <strong class="kpi-value num">{ratePct}<small>%</small></strong>
      <span class:list={['kpi-sub', 'num', { 'is-fail': failing > 0 }]}>
        {failing > 0 ? `${failing} failing of ${s.contrast.total} checks` : `All ${s.contrast.total} checks pass`}
      </span>
    </a>
    <a class="kpi" href="/studio/reviews/" data-open-reviews data-keep-branch>
      <span class="kpi-label">Open reviews</span>
      <strong class="kpi-value num" data-open-count>&nbsp;</strong>
      <span class="kpi-sub num" data-open-sub>
        Last change {humanDate(repo.lastChange)}, <span class="mono">{repo.sha}</span>
      </span>
    </a>
  </section>

  <section class="charts" aria-labelledby="charts-title">
    <h2 id="charts-title" class="sr-only">Token and contrast charts</h2>
    <article class="panel chart-panel">
      <header class="panel-head">
        <h3>Tokens by type</h3>
        <a href="/tokens/" class="panel-link">Explorer</a>
      </header>
      <Donut data={s.byType} total={s.total} centerLabel="tokens" label="Tokens by type" />
    </article>
    <article class="panel chart-panel">
      <header class="panel-head">
        <h3>Categories and layers</h3>
        <a href="/foundations/color/" class="panel-link">Foundations</a>
      </header>
      <StackedBars rows={s.byCategory} />
    </article>
    <article class="panel chart-panel">
      <header class="panel-head">
        <h3>Contrast checks</h3>
        <a href="/studio/checks/" class="panel-link" data-keep-branch>Checks</a>
      </header>
      <ContrastWaffle />
    </article>
  </section>

  <section class="duo">
    <article class="panel health" aria-labelledby="health-title">
      <header class="panel-head">
        <h3 id="health-title">Health</h3>
        <span class="muted small num">{s.issues.length} {s.issues.length === 1 ? 'item' : 'items'}</span>
      </header>
      {
        s.issues.length === 0 ? (
          <p class="empty">
            <Icon name="check" /> Nothing to fix. Every contrast pair passes, every token is used and nothing is deprecated.
          </p>
        ) : (
          <ul class="issues">
            {s.issues.map((i) => (
              <li class={`issue is-${i.severity}`}>
                <span class="issue-icon">
                  <Icon name={i.severity === 'fail' ? 'x' : i.severity === 'warn' ? 'alert' : 'info'} size={18} />
                </span>
                <span class="issue-body">
                  <a href={i.href} class="issue-title">
                    {i.title}
                  </a>
                  <span class="issue-detail">{i.detail}</span>
                </span>
                <span class={`pill is-${i.severity === 'fail' ? 'fail' : i.severity === 'warn' ? 'warn' : 'info'}`}>
                  {i.severity === 'fail' ? 'Fix' : i.severity === 'warn' ? 'Review' : 'Note'}
                </span>
              </li>
            ))}
          </ul>
        )
      }
      <p class="health-foot muted small">
        {s.deprecated.length === 0 ? 'No deprecated tokens.' : `${s.deprecated.length} deprecated tokens.`} Checked on every build from the
        token files, component CSS and contrast pairs.
      </p>
    </article>

    <article class="panel recent" aria-labelledby="recent-title">
      <header class="panel-head">
        <h3 id="recent-title">Activity</h3>
        <a href="/studio/versions/" class="panel-link" data-keep-branch>Versions</a>
      </header>
      {
        recent.length === 0 ? (
          <p class="empty">No changes recorded yet.</p>
        ) : (
          <ol class="timeline">
            {recent.map((e) => (
              <li>
                <span class="tl-node" aria-hidden="true" />
                <div class="tl-head">
                  <span class={`pill ${kindTone[e.kind] ?? ''}`}>{e.kind}</span>
                  <span class="tl-date num">{e.date ? humanDate(e.date) : e.pending ? 'Pending' : ''}</span>
                </div>
                <p class="tl-title">{e.title}</p>
                <p class="tl-ref">
                  {e.source === 'commit' ? (
                    <a href={`${GITHUB_URL}/commit/${e.ref}`} class="mono">
                      {e.ref}
                    </a>
                  ) : (
                    <span class="mono">{e.ref}</span>
                  )}
                </p>
              </li>
            ))}
          </ol>
        )
      }
    </article>
  </section>

  <section class="flow-band" aria-labelledby="flow-title">
    <div class="section-head">
      <div>
        <h2 id="flow-title">How a change travels</h2>
        <p>The same path for every change, whoever writes it: a designer in Figma, an engineer, or an AI agent.</p>
      </div>
      <a href="/studio/settings/governance/" class="btn btn-secondary btn-sm" data-keep-branch>Read the governance</a>
    </div>
    <ol class="flow">
      {
        flow.map((step, i) => (
          <li class="flow-step">
            <span class="flow-icon">
              <Icon name={step.icon} size={22} />
            </span>
            <span class="flow-num num">{i + 1}</span>
            <strong>{step.title}</strong>
            <span class="flow-text">{step.text}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <script>
    import { esc, ghGet, readRepo, relativeTime, RateLimitError } from '../../scripts/github-session';
    import { draftCount } from '../../scripts/shell';

    interface Pull {
      number: number;
      title: string;
      draft?: boolean;
      updated_at: string;
      user: { login: string };
      head: { ref: string };
    }

    const drafts = document.querySelector<HTMLElement>('[data-drafts-count]');
    const paintDrafts = () => {
      if (drafts) drafts.textContent = String(draftCount());
    };
    paintDrafts();
    document.addEventListener('bridge:draft', paintDrafts);

    // Open pull requests: the "To review" panel and the KPI tile. Same request as the nav count, so one fetch is
    // cached for both; a rate-limited visitor still sees the last list.
    const r = readRepo();
    const list = document.getElementById('st-review-list');
    const tile = document.querySelector<HTMLElement>('[data-open-reviews]');
    const out = tile?.querySelector<HTMLElement>('[data-open-count]');
    ghGet<Pull[]>(`/repos/${r.owner}/${r.repo}/pulls?state=open&per_page=100`)
      .then((f) => {
        if (out) out.textContent = String(f.data.length);
        if (f.stale && tile) tile.title = "From this browser's cache: GitHub rate limit reached.";
        if (!list) return;
        const pulls = [...f.data].sort((a, b) => b.updated_at.localeCompare(a.updated_at)).slice(0, 5);
        list.innerHTML = pulls.length
          ? pulls
              .map(
                (p) => `<li><a class="st-review-row" href="/studio/reviews/?pr=${p.number}">
                  <span class="st-review-main"><span class="st-review-title">${esc(p.title)}</span>
                  <span class="st-review-meta"><span class="mono">#${p.number}</span><span>${esc(p.user.login)}</span><span>updated ${esc(relativeTime(p.updated_at))}</span></span></span>
                  ${p.draft ? '<span class="pill">Draft</span>' : '<span class="pill is-info">Ready</span>'}
                </a></li>`,
              )
              .join('') + (f.data.length > 5 ? `<li class="st-review-more"><a href="/studio/reviews/">${f.data.length - 5} more open</a></li>` : '')
          : '<li class="st-review-empty"><span>Nothing waiting for review.</span></li>';
      })
      .catch((err) => {
        if (out) out.textContent = '?';
        if (tile) tile.title = 'GitHub could not be reached. Open Reviews to retry.';
        if (list)
          list.innerHTML = `<li class="st-review-empty is-fail"><span>${
            err instanceof RateLimitError
              ? 'GitHub limits anonymous reads to 60 an hour and this browser has used them. Connect GitHub, or try again later.'
              : 'Could not reach GitHub. Open Reviews to retry.'
          }</span></li>`;
      })
      .finally(() => list?.removeAttribute('aria-busy'));
  </script>
</Layout>
