---
import '../../styles/reviews.css';
import '../../styles/overview.css';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Illustration from '../../components/Illustration.astro';
import ButtonLink from '../../components/ds/ButtonLink';
import { Link } from '@bridge-ds/react';
import { releases } from '../../lib/changelog';
import { docsEditHref, guidanceState, loadComponents } from '../../lib/components';
import { mdTitleText, oneLineTitle } from '../../lib/markdown';
import { PAGE_SOURCES, freshness } from '../../lib/sources';
import { dashboard } from '../../lib/stats';
import { adoptionRows } from '../../lib/quality';
import { formatPct, groupByApp, loadAudits } from '../../lib/audits';
import { splitActivity } from '../../lib/release-view';

const s = dashboard();
const failing = s.contrast.fail;
const health =
  failing === 0
    ? `All ${s.contrast.total} contrast checks pass across ${s.brands} brands.`
    : `${failing} of ${s.contrast.total} contrast checks fail. The token build is blocked until they pass.`;

// Second suggestion, from the repo at build time: components without usage guidance (or with a Claude draft that
// waits for a review), else the first health item.
const comps = loadComponents();
const undocumented = comps.filter((c) => guidanceState(c) === 'missing');
const drafted = comps.filter((c) => guidanceState(c) === 'review');
const names = (list: { name: string }[]) =>
  list.length <= 2 ? list.map((c) => c.name).join(' and ') : `${list.slice(0, 2).map((c) => c.name).join(', ')} and ${list.length - 2} more`;
const guide = undocumented.length
  ? {
      title: 'Add usage guidance',
      text: `${names(undocumented)} ${undocumented.length === 1 ? 'has' : 'have'} no usage guidance yet. Start from what the code tells: props, tokens and anatomy.`,
      cta: 'Write guidance',
      href: docsEditHref(undocumented[0]!.slug),
    }
  : drafted.length
    ? {
        title: 'Review usage guidance',
        text: `Claude drafted the guidance of ${names(drafted)} from the code. Read it, fix it, then mark it reviewed.`,
        cta: 'Review guidance',
        href: docsEditHref(drafted[0]!.slug),
      }
    : s.issues[0]
    ? { title: s.issues[0].title, text: s.issues[0].detail, cta: 'Open', href: s.issues[0].href }
    : { title: 'Check visual impact', text: 'Every change gets screenshots of the examples and screens it touches. Look before you approve.', cta: 'Open Changes', href: '/studio/changes/' };

// Shipped, not released yet. Open changes are not repeated here: the greeting lists them, as to-dos. Only
// changesets say which packages a change touches: the design system ones (components, tokens) are listed, Bridge's
// own app updates (Studio, plugin, CLI, Claude connector) fold into one labelled row.
const pending = releases()
  .filter((r) => r.pending)
  .flatMap((r) => r.entries)
  .filter((e) => e.source === 'changeset');
const activity = splitActivity(pending);
const merged = activity.ds.slice(0, 3);
const appUpdates = activity.app.length;

// Adoption (loop 2), from the same audit reports as Quality: never a number the reports do not hold.
const adoption = adoptionRows(groupByApp(loadAudits()).apps).filter((a) => a.component.to !== null || a.token.to !== null);
---

<Layout
  title="Overview"
  description="What waits for review, what to do next and recent activity: the Studio's starting point."
  sources={PAGE_SOURCES.home}
  updated={freshness(PAGE_SOURCES.home)}
  wide
>
  <div class="ov">
    <div class="ov-top">
      <section class="zone ov-greet" aria-labelledby="ov-hello">
        <div class="ov-greet-copy">
          <h1 id="ov-hello" class="ov-hello">
            <span data-hello>Hello.</span>
            <span class="ov-hello-line" data-todo-headline>Here is what waits for you.</span>
          </h1>
          <p class="t-body ov-note" data-todo-note>Changes in review load from GitHub.</p>
          <ul class="ov-todo" data-todo-list aria-label="Waiting for you" aria-busy="true">
            <li class="ov-todo-row ov-skel" aria-hidden="true"></li>
          </ul>
          <p class="t-ui ov-todo-all" data-todo-all hidden>
            <Link href="/studio/changes/" data-todo-all-link>Show all</Link>
          </p>
          <details class="ov-others" data-todo-dev hidden>
            <summary class="t-ui ov-others-sum"><span data-todo-dev-line></span><span class="ov-chev" aria-hidden="true"></span></summary>
            <ul class="ov-todo" data-todo-dev-list aria-label="Waiting on a developer"></ul>
          </details>
          <details class="ov-others" data-todo-others hidden>
            <summary class="t-ui ov-others-sum"><span data-todo-others-line></span><span class="ov-chev" aria-hidden="true"></span></summary>
            <ul class="ov-todo" data-todo-others-list aria-label="Waiting on someone else"></ul>
          </details>
          <p class="ov-todo-empty" data-todo-empty hidden>
            <ButtonLink variant="primary" href="/studio/tokens/" data-keep-branch>Edit tokens</ButtonLink>
          </p>
        </div>
        <Illustration name="review" class="ov-greet-art" />
      </section>

      <section class="ov-sugg" aria-label="Suggested next steps">
        <article class="fg-card ov-card">
          <div>
            <h2 class="t-h3">{guide.title}</h2>
            <p class="t-body t-muted">{guide.text}</p>
            <ButtonLink size="sm" href={guide.href} data-keep-branch>{guide.cta}</ButtonLink>
          </div>
          <Illustration name="guide" width={96} />
        </article>
        <article class="fg-card ov-card ov-quality">
          <div>
            <h2 class="t-h3">Quality</h2>
            <p class="t-body t-muted ov-health">
              <span class:list={['ov-dot', { 'is-fail': failing > 0 }]} aria-hidden="true"></span>
              {health}
            </p>
            {
              adoption.length > 0 && (
                <ul class="t-body t-muted ov-adopt-list">
                  {adoption.map((a) => (
                    <li>
                      {a.label}: <strong class="num">{formatPct(a.component.to)}</strong> components, <strong class="num">{formatPct(a.token.to)}</strong> tokens
                    </li>
                  ))}
                </ul>
              )
            }
            <ButtonLink size="sm" href={failing > 0 ? '/studio/quality/' : adoption.length ? '/studio/quality/#ql-adoption' : '/studio/quality/'} data-keep-branch>
              {failing > 0 ? 'Fix contrast' : 'See quality'}
            </ButtonLink>
          </div>
          <Illustration name="components" width={96} />
        </article>
      </section>
    </div>

    <template data-todo-row="primary">
      <li class="ov-todo-row">
        <span class="ov-todo-text"><b class="t-body" data-title></b><span class="t-ui t-muted" data-why></span></span>
        <ButtonLink variant="primary" href="/studio/changes/" data-act>Open change</ButtonLink>
      </li>
    </template>
    <template data-todo-row="secondary">
      <li class="ov-todo-row">
        <span class="ov-todo-text"><b class="t-body" data-title></b><span class="t-ui t-muted" data-why></span></span>
        <ButtonLink variant="secondary" href="/studio/changes/" data-act>Open change</ButtonLink>
      </li>
    </template>
    <template data-todo-row="link">
      <li class="ov-todo-row">
        <span class="ov-todo-text"><b class="t-body" data-title></b><span class="t-ui t-muted" data-why></span></span>
        <Link href="/studio/changes/" data-act>Open change</Link>
      </li>
    </template>

    {(merged.length > 0 || appUpdates > 0) && (
    <section class="ov-activity" aria-labelledby="ov-activity-title">
      <header class="ov-activity-head">
        <h2 id="ov-activity-title" class="t-h3">Recently shipped</h2>
        <a href="/studio/changes/?view=history" class="fg-link" data-keep-branch>See all</a>
      </header>
      <ul class="fg-card ov-list">
        {
          merged.map((e) => (
            <li class="ov-row">
              <span class="t-body ov-row-title">
                <b title={mdTitleText(e.title)}>{oneLineTitle(e.title)}</b> <span class="t-muted">Shipped</span>
              </span>
              <span class="pill">Next release</span>
              <span class="t-ui t-muted ov-row-date">{e.date ? new Date(`${e.date}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }) : ''}</span>
            </li>
          ))
        }
        {
          appUpdates > 0 && (
            <li class="ov-row">
              <a class="ov-row-link" href="/changelog/">
                <span class="t-body ov-row-title">
                  <b>
                    {appUpdates} Bridge app {appUpdates === 1 ? 'update' : 'updates'}
                  </b>{' '}
                  <span class="t-muted">Studio, Figma plugin and tools</span>
                </span>
                <span class="pill">Bridge app</span>
                <span class="t-ui t-muted ov-row-date" />
              </a>
            </li>
          )
        }
      </ul>
    </section>
    )}
  </div>

  <script>
    import { loadProtection } from '@bridge-ds/core';
    import { currentViewer, ghGet, hasWorkingToken, initGitHubConnect, readRepo, RateLimitError, studioClient } from '../../scripts/github-session';
    import { loadStatuses, owners, shippers, type PullForStatus, type PullStatus } from '../../scripts/pr-status';
    import { oneLineTitle } from '../../lib/markdown';
    import { byUrgency, needFromStatus, whoActs, type WhoActs } from '../../lib/changes';
    import { reviewQueue } from '../../lib/review-queue';
    import { humanTitle } from '../../lib/pr-title';
    import { overviewProtectionLine } from '../../lib/protection-view';
    import { developerLine, isGuidanceChange, othersLine, overviewTodo, showAllLabel, TODO_MAX, type TodoRequest, type TodoRow } from '../../lib/overview-todo';
    import { manifestPublished } from '../../scripts/reviews/visual-impact';
    import type { PullLike } from '../../lib/requests-view';
    import { loadRequestRows } from '../../scripts/requests';

    interface Pull extends PullForStatus {
      state: string;
      title: string;
      updated_at: string;
      labels?: { name?: string }[];
      html_url: string;
    }

    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel);
    const hello = $('[data-hello]');
    const headline = $('[data-todo-headline]');
    const note = $('[data-todo-note]');
    const todoList = $('[data-todo-list]');
    const all = $('[data-todo-all]');
    const allLink = $<HTMLAnchorElement>('[data-todo-all-link]');
    const othersBox = $('[data-todo-others]');
    const othersText = $('[data-todo-others-line]');
    const othersList = $('[data-todo-others-list]');
    const devBox = $('[data-todo-dev]');
    const devText = $('[data-todo-dev-line]');
    const devList = $('[data-todo-dev-list]');
    const empty = $('[data-todo-empty]');

    // Everything the to-do list is made of. Each source fills its part and repaints.
    const state = {
      open: [] as Pull[],
      statuses: new Map<number, PullStatus | null>(),
      loaded: false,
      done: false,
      requests: [] as TodoRequest[],
      unprotected: false,
      /** Before and after published for the head commit of a change that waits for the viewer's design review. */
      visual: new Map<number, 'ready' | null>(),
    };

    const siteOwners = () => {
      const o = owners();
      return [...new Set([...o.design, ...o.tech])];
    };
    const overrideBy = (): string[] => {
      try {
        return (JSON.parse(document.getElementById('bridge-repo')?.textContent || '{}') as { override?: { allowed?: string[] } }).override?.allowed ?? [];
      } catch {
        return [];
      }
    };

    /** Who acts now on a change, for the connected viewer (same rules as the change detail). */
    const whoFor = (p: Pull, st: PullStatus | null | undefined): WhoActs | null =>
      st
        ? whoActs(needFromStatus(st.kind, { failing: st.failing, changesRequestedBy: st.changesRequested }), {
            owners: owners(),
            shippers: shippers(),
            overrideBy: overrideBy(),
            author: p.user.login,
            viewer: currentViewer()?.login ?? null,
            approvers: st.approvers,
          })
        : null;

    const urgent = () => {
      const byNum = new Map(state.open.map((p) => [p.number, p]));
      return byUrgency(state.open.map((p) => ({ number: p.number, kind: state.statuses.get(p.number)?.kind ?? null, updated_at: p.updated_at }))).map((o) => byNum.get(o.number)!);
    };

    /**
     * One row: what, why, and the task on a DS button. The first row of the list carries the one primary action.
     * Developer rows carry a link only: there is nothing for a designer to do there.
     */
    function rowEl(r: TodoRow, look: 'primary' | 'secondary' | 'link'): HTMLElement {
      const tpl = document.querySelector<HTMLTemplateElement>(`template[data-todo-row="${look}"]`)!;
      const li = (tpl.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
      li.dataset.key = r.key;
      li.querySelector('[data-title]')!.textContent = r.title;
      li.querySelector('[data-why]')!.textContent = r.why;
      const a = li.querySelector<HTMLAnchorElement>('[data-act]')!;
      a.href = r.href;
      a.textContent = r.action;
      a.setAttribute('aria-label', `${r.action}: ${r.title}`);
      return li;
    }

    function paintTodo() {
      if (!headline || !todoList) return;
      const viewer = currentViewer()?.login ?? null;
      const changes = urgent().map((p) => {
        const st = state.statuses.get(p.number);
        const visual = st?.touchesVisuals === false ? ('none' as const) : (state.visual.get(p.number) ?? null);
        return {
          number: p.number,
          title: oneLineTitle(humanTitle(p.title)),
          who: whoFor(p, st),
          failing: st?.failing,
          failingChecks: st?.failingChecks,
          changesBy: st?.changesRequested,
          visual,
          guidance: isGuidanceChange(p.head.ref, st?.guidanceOnly),
        };
      });
      const t = overviewTodo({ changes, requests: state.requests, viewer, owners: siteOwners(), unprotected: state.unprotected, loading: !state.done });
      // Statuses still loading and nothing yours yet: say so rather than "Nothing waits for you".
      const checking = viewer && !state.done && !t.mine.length && state.open.length > 0;
      headline.textContent = checking ? 'Checking what waits for you.' : t.headline;
      todoList.removeAttribute('aria-busy');
      todoList.replaceChildren(...(checking ? [] : t.mine.slice(0, TODO_MAX).map((r, i) => rowEl(r, viewer && i === 0 ? 'primary' : 'secondary'))));
      todoList.hidden = checking || t.mine.length === 0;
      const more = showAllLabel(t.mine.length);
      if (all && allLink) {
        all.hidden = !more;
        allLink.textContent = more;
      }
      if (devBox && devText && devList) {
        const text = checking ? '' : developerLine(t.developer.length);
        devBox.hidden = !text;
        devText.textContent = text;
        devList.replaceChildren(...t.developer.map((r) => rowEl(r, 'link')));
      }
      if (othersBox && othersText && othersList) {
        const text = checking ? '' : othersLine(t.others, t.mine.length);
        othersBox.hidden = !text;
        othersText.textContent = text;
        othersList.replaceChildren(...t.others.map((r) => rowEl(r, 'secondary')));
      }
      if (note) {
        const nothing = !t.mine.length && !t.others.length && !t.developer.length;
        note.textContent = !viewer && t.mine.length ? 'Connect GitHub to see what waits for you.' : nothing && !checking ? 'Every change is shipped. Start the next one from Tokens.' : '';
        note.hidden = !note.textContent;
      }
      if (empty) empty.hidden = Boolean(checking || t.mine.length || t.others.length || t.developer.length);
    }

    /**
     * Whether the visual impact run published before and after images for the changes that wait for the viewer's
     * design review, so their row can say so. Connected only (a few reads per change), never for a change that
     * touches nothing visual.
     */
    async function loadVisuals() {
      const viewer = currentViewer()?.login ?? null;
      if (!viewer || !hasWorkingToken()) return;
      const { owner, repo } = readRepo();
      const review = state.open.filter((p) => {
        const st = state.statuses.get(p.number);
        const who = whoFor(p, st);
        return st?.touchesVisuals !== false && who && ['approve-design', 'approve', 'override'].includes(who.action) && (who.yourTurn || who.logins.includes(viewer));
      });
      for (const p of review) {
        const ready = await manifestPublished(owner, repo, p.number, p.head.sha).catch(() => false);
        state.visual.set(p.number, ready ? 'ready' : null);
      }
      if (review.length) paintTodo();
    }

    // "Hello Florian." only when a GitHub login is known (first word of the profile name, else the login).
    initGitHubConnect(async (v) => {
      const viewer = v ?? currentViewer();
      if (hello) {
        const name = viewer ? (viewer.name?.trim().split(/\s+/)[0] ?? viewer.login) : '';
        hello.textContent = name ? `Hello ${name}.` : 'Hello.';
      }
      if (state.loaded) paintTodo();
      // Owners only: a setup row when nothing protects the library.
      const o = owners();
      const isOwner = Boolean(v && [...o.design, ...o.tech].includes(v.login));
      if (!isOwner || !hasWorkingToken()) {
        state.unprotected = false;
      } else {
        const r = readRepo();
        state.unprotected = Boolean(overviewProtectionLine(await loadProtection(studioClient(`${r.owner}/${r.repo}`), r.defaultBranch), isOwner));
      }
      if (state.loaded) paintTodo();
    });

    const r = readRepo();
    ghGet<Pull[]>(`/repos/${r.owner}/${r.repo}/pulls?state=open&per_page=100`)
      .then((f) => {
        // The review queue: the same list, and so the same count, as the nav badge and the In review tab.
        state.open = reviewQueue(f.data).sort((a, b) => b.updated_at.localeCompare(a.updated_at));
        state.statuses = new Map(state.open.map((p) => [p.number, null]));
        state.loaded = true;
        paintTodo();
        // Component change requests: from the open pull requests read above plus one cached issues list.
        void loadRequestRows({ openPulls: f.data as unknown as PullLike[], closed: false })
          .then((rows) => {
            state.requests = rows;
            paintTodo();
          })
          .catch(() => undefined);
        void loadStatuses(state.open, (p, st) => {
          state.statuses.set(p.number, st);
        }).then(async () => {
          state.done = true;
          paintTodo();
          await loadVisuals();
        });
      })
      .catch((err) => {
        if (todoList) todoList.hidden = true;
        if (headline) headline.textContent = 'Reviews are out of reach for now.';
        if (note) {
          note.hidden = false;
          note.textContent =
            err instanceof RateLimitError
              ? 'GitHub limits anonymous reads to 60 an hour and this browser has used them. Connect GitHub, or try again later.'
              : 'GitHub could not be reached. Open Changes to retry.';
        }
      });
  </script>
</Layout>
