---
import '../../styles/studio.css';
import Layout from '../../layouts/Layout.astro';
import StudioHeader from '../../components/StudioHeader.astro';
import ComponentsTable from '../../components/ds/studio/ComponentsTable';
import { editTokensHref, loadComponents, type ComponentInfo } from '../../lib/components';
import { sourceUrl, STORYBOOK_URL } from '../../lib/repo';
import { PAGE_SOURCES, freshness } from '../../lib/sources';

const components = loadComponents();
const updated = freshness(PAGE_SOURCES.components);
const families = [...new Set(components.map((c) => c.category))];
const statusOf = (c: ComponentInfo) => c.docs?.status ?? 'stable';
const documented = components.filter((c) => c.docs).length;
const count = (s: string) => components.filter((c) => statusOf(c) === s).length;
const rows = components.map((c) => ({
  slug: c.slug,
  name: c.name,
  status: statusOf(c),
  category: c.category,
  documented: Boolean(c.docs),
  // Same set as the Studio Tokens ?component= filter the Edit tokens link opens, so the numbers match.
  tokens: c.tokenPaths.length,
  props: c.props.length,
  stories: c.stories.length,
  editHref: editTokensHref(c),
  codeHref: sourceUrl(c.files.tsx),
  storyHref: c.stories[0] ? `${STORYBOOK_URL}/?path=/story/${c.stories[0].id}` : undefined,
}));
---

<Layout
  title="Components"
  description="Every component with its status, guidance, tokens and links to the code, the workbench and its tokens in the editor."
  sources={PAGE_SOURCES.components}
  updated={updated}
  wide
>
  <StudioHeader title="Components" subtitle="Status, guidance, tokens and code of every component. Their look changes through their tokens." />

  <ul class="st-summary" aria-label="Summary">
    <li><strong class="num">{components.length}</strong> components</li>
    <li><strong class="num">{families.length}</strong> families</li>
    <li><strong class="num">{count('stable')}</strong> stable</li>
    <li><strong class="num">{count('beta')}</strong> beta</li>
    <li><strong class="num">{count('deprecated')}</strong> deprecated</li>
    <li><strong class="num">{documented}</strong> with guidance</li>
  </ul>

  <ComponentsTable rows={rows} />
  <p class="small muted">
    No Figma links yet: component docs do not record a Figma node. Push and pull of variables goes through the DS Bridge plugin, see
    <a href="/studio/settings/integrations/" data-keep-branch>Integrations</a>.
  </p>

  <script>
    // Door target from a Library component page: /studio/components/?c=button highlights that row.
    const slug = new URLSearchParams(location.search).get('c');
    const row = slug ? document.getElementById(`c-${CSS.escape(slug)}`) : null;
    if (row) {
      // DS TableRow draws its selected fill from data-selected.
      row.setAttribute('data-selected', '');
      row.setAttribute('aria-current', 'true');
      row.scrollIntoView({ block: 'center' });
    }
  </script>
</Layout>
