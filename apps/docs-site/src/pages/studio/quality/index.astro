---
// Studio Quality: one page for the checks and the adoption of the system (it replaced Checks and Adoption, which
// redirect here). One story first: the title with Share as a quiet action, then the verdict in the page's one Harbor
// zone next to the lighthouse drawing whose weather follows it, with an action only when something needs the viewer.
// Then the three pillars (accessibility, adoption, documentation) as one group of identical cards, and one section
// each in the same order, tokens last as a calm note. The body is shared with the team page
// (components/ds/studio/QualityView.tsx); the numbers come from lib/stats.ts, lib/audits.ts and lib/quality-view.ts.
import '../../../styles/quality.css';
import Layout from '../../../layouts/Layout.astro';
import StudioHeader from '../../../components/StudioHeader.astro';
import ButtonLink from '../../../components/ds/ButtonLink';
import { QualityView } from '../../../components/ds/studio/QualityView';
import { docsEditHref, guidanceState, loadComponents } from '../../../lib/components';
import { CONTRAST_FILE } from '../../../lib/contrast';
import { groupByApp, loadAudits } from '../../../lib/audits';
import { APP_SHORT, auditHref, qualityModel, type ComboResult } from '../../../lib/quality';
import { adoptionFigureInput, adoptionView, qualityPillars, qualityVerdict, type AdoptionRun } from '../../../lib/quality-view';
import { guidanceLead } from '../../../lib/team-quality';
import { PAGE_SOURCES, freshness } from '../../../lib/sources';
import { QUALITY_IN_CHECKS, QUALITY_IN_CHECKS_BODY, QUALITY_TOGETHER, QUALITY_TOGETHER_BODY } from '../../../lib/view-scope';
import { QualityShare } from '../../../components/ds/studio/QualityShare';
import { combinedAdoption, healthFigures, healthSentence } from '../../../lib/library-health';
import { EmptyState } from '@bridge-ds/react';
import { ShieldCheck } from 'lucide-react';
import { dashboard } from '../../../lib/stats';
import { BRAND_LABEL, TOKEN_SOURCE_FILES, type Brand } from '../../../lib/tokens';
import { studioHref } from '../../../lib/team-path';

const s = dashboard();
const combos: ComboResult[] = s.contrast.byCombo.map((c) => ({ label: `${BRAND_LABEL[c.brand as Brand]} ${c.mode}`, pass: c.pass, total: c.total }));
const contrast = { total: s.contrast.total, fail: s.contrast.fail, combos };
const components = loadComponents().map((c) => ({ name: c.name, slug: c.slug, state: guidanceState(c), docsPath: c.files.docs }));
const { findings } = qualityModel({ contrast, components, issues: s.issues, editHref: docsEditHref });
const guidance = {
  total: components.length,
  reviewed: components.filter((c) => c.state === 'ok').length,
  drafted: components.filter((c) => c.state === 'review').length,
  missing: components.filter((c) => c.state === 'missing').length,
};
// Adoption: every committed report as a run of its product (the app it belongs to); the latest run of each product
// leads, the run before the move to Bridge waits under Earlier runs and gives the trend.
const runs: AdoptionRun[] = groupByApp(loadAudits()).apps.flatMap((g) =>
  g.reports.map((e) => ({
    id: e.id,
    label: e.report.label ?? e.file,
    product: g.app.id,
    productName: APP_SHORT[g.app.id] ?? g.app.title,
    generatedAt: e.report.generatedAt,
    token: e.report.metrics.tokenAdoption,
    component: e.report.metrics.componentAdoption,
    ds: e.report.metrics.dsComponentInstances,
    ui: e.report.metrics.uiComponentInstances,
    href: auditHref(e.id),
    baseline: e === g.before && g.after !== undefined,
  })),
);
const adoption = runs.length ? adoptionView(runs) : null;
const figures = healthFigures({
  contrast: { total: s.contrast.total, fail: s.contrast.fail, brands: s.brands },
  adoption: adoption ? adoptionFigureInput(adoption) : [],
  guidance,
});
const verdict = qualityVerdict({ contrastFail: contrast.fail, findings });
const pillars = qualityPillars({ figures, contrast, adoption: adoption ? (combinedAdoption(adoptionFigureInput(adoption))?.now ?? null) : null, guidance });
// The shared summary (Share): the verdict line without the figures, then one sentence per figure.
const openFindings = findings.filter((f) => f.severity === 'fail' || f.severity === 'warn');
const sentence = healthSentence(contrast.fail, openFindings.length, openFindings.length === 1 ? openFindings[0]!.title : undefined);
const gate = findings.find((f) => f.kind === 'contrast')!;
// The real number of unused tokens, not the number of groups.
const unusedTotal = s.unusedSemantic.length + s.orphanPrimitives.length;
const sources = [CONTRAST_FILE, ...TOKEN_SOURCE_FILES(), ...PAGE_SOURCES.components, ...PAGE_SOURCES.adoption];
const updated = freshness(sources);
// Failing pairs, one row per pair and brand/theme, shown open in the accessibility section when the gate blocks.
const failRows = s.contrast.failing.map(({ pair: p, brand, mode, result: r }) => ({
  id: `fail-${p.fg}-${p.bg}-${brand}-${mode}`.replace(/[^a-z0-9-]+/gi, '-'),
  fg: p.fg,
  bg: p.bg,
  where: `${BRAND_LABEL[brand as Brand]} ${mode}`,
  ratio: `${r.ratio.toFixed(2)}:1`,
  hexes: `${r.fgHex} / ${r.bgHex}`,
  needs: `${p.min}:1 (${p.usage === 'text' ? 'text' : 'UI'})`,
}));
---

<Layout title="Quality" description="Is the library healthy, and does anything need you: accessibility, adoption in products and documentation." sources={sources} updated={updated} wide>
  <div class="ql">
    <StudioHeader title="Quality">
      <div slot="actions" data-latest-only>
        <QualityShare client:load figures={figures} sentence={sentence} path={studioHref('quality/')} />
      </div>
    </StudioHeader>
    <div class="view-banner" data-view-banner hidden></div>

    {/* Showing an open branch (?change=N, lib/view-scope): these numbers are main's, so they give way to
        one line that points to the branch's own checks (html[data-view-change], set before the page paints). */}
    <section class="ql-view" data-change-only aria-label="Quality of this change">
      <EmptyState icon={ShieldCheck} title={QUALITY_IN_CHECKS} description={QUALITY_IN_CHECKS_BODY} headingLevel={2} align="start">
        <ButtonLink slot="actions" variant="primary" href={studioHref('changes/')} data-change-href>See its checks</ButtonLink>
      </EmptyState>
    </section>
    <section class="ql-view" data-together-only aria-label="Quality of these changes together">
      <EmptyState icon={ShieldCheck} title={QUALITY_TOGETHER} description={QUALITY_TOGETHER_BODY} headingLevel={2} align="start">
        <ButtonLink slot="actions" variant="primary" href={studioHref('changes/')}>Go to Changes</ButtonLink>
      </EmptyState>
    </section>

    <div data-latest-only>
      <QualityView
        client:load
        verdict={verdict}
        pillars={pillars}
        contrast={{ hasChecks: true, gate, combos, failRows }}
        adoption={adoption}
        guidance={{ lead: guidanceLead(guidance), findings: findings.filter((f) => f.kind === 'guidance') }}
        tokens={{ findings: findings.filter((f) => f.kind === 'validation'), unusedTotal, unusedHref: studioHref('tokens/?usage=unused') }}
      />
    </div>
  </div>
</Layout>
