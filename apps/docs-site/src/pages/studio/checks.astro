---
import '../../styles/foundations.css';
import '../../styles/dashboard.css';
import '../../styles/process.css';
import '../../styles/studio.css';
import Layout from '../../layouts/Layout.astro';
import StudioHeader from '../../components/StudioHeader.astro';
import Icon from '../../components/Icon.astro';
import ButtonLink from '../../components/ds/ButtonLink';
import ContrastFailTable from '../../components/ds/studio/ContrastFailTable';
import { Badge, type BadgeTone } from '@bridge-ds/react';
import { Contrast } from 'lucide-react';
import { CONTRAST_FILE, contrastPairs } from '../../lib/contrast';
import { PAGE_SOURCES, freshness } from '../../lib/sources';
import { dashboard } from '../../lib/stats';
import { BRAND_LABEL, BRANDS, MODES, TOKEN_SOURCE_FILES, type Brand, type Mode } from '../../lib/tokens';

const pairs = contrastPairs();
const s = dashboard();
const sources = [CONTRAST_FILE, ...TOKEN_SOURCE_FILES()];
const updated = freshness(PAGE_SOURCES.color);
const COMBOS = BRANDS.flatMap((b) => MODES.map((m) => ({ b, m }))) as { b: Brand; m: Mode }[];
const comboLabel = (c: { b: Brand; m: Mode }) => `${BRAND_LABEL[c.b]} ${c.m}`;
const res = (p: (typeof pairs)[number], c: (typeof COMBOS)[number]) => p.brands[c.b][c.m];
const total = pairs.length * COMBOS.length;
const failures = pairs.flatMap((p) => COMBOS.filter((c) => !res(p, c).aa).map((c) => ({ p, c, r: res(p, c) })));
const passing = total - failures.length;
const rate = total ? Math.floor((passing / total) * 1000) / 10 : 100;
const perCombo = COMBOS.map((c) => ({ c, pass: pairs.filter((p) => res(p, c).aa).length }));
const validation = s.issues.filter((i) => !i.href.startsWith('/studio/checks/'));
const tone = (sev: string): BadgeTone => (sev === 'fail' ? 'danger' : sev === 'warn' ? 'warning' : 'info');
const failRows = failures.map(({ p, c, r }) => ({
  id: `fail-${p.fg}-${p.bg}-${c.b}-${c.m}`.replace(/[^a-z0-9-]+/gi, '-'),
  fg: p.fg,
  bg: p.bg,
  where: comboLabel(c),
  ratio: `${r.ratio.toFixed(2)}:1`,
  hexes: `${r.fgHex} / ${r.bgHex}`,
  needs: `${p.min}:1 (${p.usage === 'text' ? 'text' : 'UI'})`,
}));
const validationTone: BadgeTone = validation.some((i) => i.severity === 'fail') ? 'danger' : validation.length ? 'warning' : 'success';
const sevLabel = (sev: string) => (sev === 'fail' ? 'Fix' : sev === 'warn' ? 'Review' : 'Note');
const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
---

<Layout
  title="Checks"
  description="The gates every change passes: the contrast gate in every brand and theme, and token validation."
  sources={sources}
  updated={updated}
  wide
>
  <StudioHeader title="Checks" subtitle="Contrast blocks the token build; validation findings do not block, but reviewers read them.">
    <Fragment slot="actions"><ButtonLink variant="secondary" size="sm" iconStart={Contrast} href="/foundations/accessibility/">Full contrast grid</ButtonLink></Fragment>
  </StudioHeader>

  <section class="st-gates" aria-label="Gate status">
    <article class:list={['panel', 'st-gate', failures.length ? 'is-fail' : 'is-pass']}>
      <p class="st-gate-label">Contrast gate</p>
      <p class="st-gate-value num">{rate}%</p>
      <p class="st-gate-sub">
        <Badge size="sm" tone={failures.length ? 'danger' : 'success'}>{failures.length ? 'Blocking' : 'Passing'}</Badge>
        <span class="muted small num">{passing} of {total} checks, {pairs.length} pairs in {COMBOS.length} brand and theme combinations</span>
      </p>
    </article>
    <article class:list={['panel', 'st-gate', validation.some((i) => i.severity === 'fail') ? 'is-fail' : validation.length ? 'is-warn' : 'is-pass']}>
      <p class="st-gate-label">Token validation</p>
      <p class="st-gate-value num">{validation.length}</p>
      <p class="st-gate-sub">
        <Badge size="sm" tone={validationTone}>{validation.length ? plural(validation.length, 'finding') : 'Clean'}</Badge>
        <span class="muted small">Unknown references, deprecated and unused tokens, missing guidance</span>
      </p>
    </article>
  </section>

  <section aria-labelledby="contrast">
    <h2 id="contrast" class="st-h2">Contrast gate</h2>
    <p class="muted">
      Pairs listed in <code>{CONTRAST_FILE}</code>, resolved for every brand and theme. Text needs 4.5:1, UI edges and focus rings 3:1.
    </p>
    <ul class="st-combos" aria-label="Passing pairs per brand and theme">
      {
        perCombo.map((x) => (
          <li>
            <span>{comboLabel(x.c)}</span>
            <strong class="num">
              {x.pass}/{pairs.length}
            </strong>
            <Badge size="sm" tone={x.pass === pairs.length ? 'success' : 'danger'}>{x.pass === pairs.length ? 'Pass' : 'Fail'}</Badge>
          </li>
        ))
      }
    </ul>
    {
      failures.length === 0 ? (
        <p class="empty">
          <Icon name="check" /> Every pair passes AA in every brand and theme.
        </p>
      ) : (
        <ContrastFailTable rows={failRows} />
      )
    }
  </section>

  <section aria-labelledby="validation">
    <h2 id="validation" class="st-h2">Token validation</h2>
    <p class="muted">Read from the token files, the component CSS and the docs at build time.</p>
    {
      validation.length === 0 ? (
        <p class="empty">
          <Icon name="check" /> Nothing to report: every reference resolves, nothing is deprecated and every component has guidance.
        </p>
      ) : (
        <ul class="issues st-issues">
          {validation.map((i) => (
            <li class={`issue is-${i.severity}`}>
              <span class="issue-icon">
                <Icon name={i.severity === 'fail' ? 'x' : i.severity === 'warn' ? 'alert' : 'info'} size={18} />
              </span>
              <span class="issue-body">
                <a href={i.href} class="issue-title">
                  {i.title}
                </a>
                <span class="issue-detail">{i.detail}</span>
              </span>
              <Badge size="sm" tone={tone(i.severity)}>{sevLabel(i.severity)}</Badge>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section aria-labelledby="local">
    <h2 id="local" class="st-h2">Run the same checks locally</h2>
    <p class="muted">CI runs these on every pull request. Run them before you push to see the same result.</p>
    <div class="terminal">
      <div class="terminal-bar">
        <span class="terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="terminal-title"><Icon name="terminal" size={15} /> <span>Terminal</span></span>
        <span class="terminal-actions">
          <button type="button" class="copy copy-ui" data-copy={'npm run bridge -- check\nnpm run tokens:build'}><Icon name="copy" size={15} /><span data-copy-label>Copy</span></button>
        </span>
      </div>
      <pre class="terminal-body" tabindex="0" aria-label="Commands">npm run bridge -- check    # config, token validation, contrast gate
npm run tokens:build       # DTCG to CSS and TS, fails on contrast</pre>
    </div>
  </section>
</Layout>
