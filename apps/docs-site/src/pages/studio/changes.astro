---
// Studio Changes: one page, three views. "In review": the open pull requests, most urgent first, with the local draft
// and the branches without a pull request. "History": merged token changes by release, with undo. A pull request
// opens in place (?pr=N). "Requests": component change requests (GitHub issues labeled component-change) that a pull
// request implements, opened in place (?request=N). "Explorations": draft pull requests labeled exploration on
// explore/<slug> branches, tried in a product staging branch and never merged as is, opened in place (?exploration=N). Replaces Drafts, Branches, Reviews, Versions and Visual impact (lib/redirects.ts).
import '../../styles/reviews.css';
import '../../styles/history.css';
import '../../styles/changes.css';
import '../../styles/requests.css';
import '../../styles/explorations.css';
import Layout from '../../layouts/Layout.astro';
import StudioHeader from '../../components/StudioHeader.astro';
import HistoryPlanner from '../../components/HistoryPlanner.astro';
import Illustration from '../../components/Illustration.astro';
import Icon from '../../components/Icon.astro';
import ButtonLink from '../../components/ds/ButtonLink';
import { Alert, Button, Link, SegmentedControl } from '@bridge-ds/react';
import { WORK_FILTERS } from '../../lib/work-nature';
import { STATUS_FILTERS } from '../../lib/change-status';
import { siteRepo } from '../../lib/config';
import { EXPLORATION_USE_CASES } from '@bridge-ds/core';
import { lastUpdated, PREVIEW_APPS, PREVIEW_PACKAGES, PRODUCTION_APPS, readText } from '../../lib/repo';
import { CONTRAST_FILE } from '../../lib/contrast';
import { pendingChangesets, versionInfo } from '../../lib/changelog';
import { waitingLine } from '../../lib/release-view';
import { loadComponents } from '../../lib/components';
import Example from '../../components/Example';
import PromoteToReview from '../../components/ds/studio/PromoteToReview';
import RequestDecide from '../../components/ds/studio/RequestDecide';
import StatusFilterSelect from '../../components/ds/studio/StatusFilterSelect';
import type { BranchesConfig } from '../../lib/branches';
import { ghAction, ghButton } from '../../lib/gh-wording';
import { signInConfig } from '../../lib/signin-config';

const r = siteRepo();
const checks = readText(CONTRAST_FILE).replace(/</g, '\\u003c');
const cfg: BranchesConfig = { owner: r.owner, repo: r.repo, defaultBranch: r.defaultBranch, apps: PREVIEW_APPS, packages: PREVIEW_PACKAGES };
const cfgJson = JSON.stringify(cfg).replace(/</g, '\\u003c');
const version = versionInfo();
// The preview of each component (its docs.json preview, rendered with the real components): a request row without
// an image of its own shows it as its thumbnail.
const previews = loadComponents().filter((c) => c.docs?.preview);
// Changes that wait for the next release = changesets on main, the unit the release pull request counts too, so the
// line and the "Next release" card (filled in the browser from that pull request) never disagree.
const historyLine = waitingLine(version.current, pendingChangesets().length);
const repoUrl = `https://github.com/${r.owner}/${r.repo}`;
// Fixture history is a development aid: production builds never show the switch.
const demoHistory = import.meta.env.DEV;
// Developer work (code only, lib/work-nature) is tagged in each list; this filter shows when a list holds some.
const workItems = WORK_FILTERS.map((f) => ({ value: f.value, label: f.label }));
// The lifecycle of a change (lib/change-status): Open by default, one state at a time, in the address as ?status=.
const statusItems = STATUS_FILTERS.map((f) => ({ value: f.value, label: f.label }));
const sources = ['docs/GOVERNANCE.md', '.github/CODEOWNERS', 'docs/PREVIEWS.md', 'docs/EXPLORATIONS.md', '.changeset'];
const signIn = Boolean(signInConfig());
---

<Layout
  title="Changes"
  description="Changes to review, most urgent first, the local draft, and the history of shipped token changes with the next release and a safe undo."
  sources={sources}
  updated={lastUpdated(sources)}
  wide
>
  <div class="rv cg">
    <p class="rv-notice" id="rv-notice" role="status" hidden></p>
    <div id="cg-main">
      <StudioHeader title="Changes" />
      <div class="page-tabs cg-tabs" role="tablist" aria-label="Changes">
        <a role="tab" id="cg-tab-review" href="/studio/changes/" aria-controls="cg-review" aria-selected="true" tabindex="0" data-cg-view="review">
          In review <span class="cg-tab-n num" id="rv-count" hidden></span>
        </a>
        <a role="tab" id="cg-tab-requests" href="/studio/changes/?view=requests" aria-controls="cg-requests" aria-selected="false" tabindex="-1" data-cg-view="requests">
          Requests <span class="cg-tab-n num" id="rq-count" hidden></span>
        </a>
        <a role="tab" id="cg-tab-explore" href="/studio/changes/?view=explorations" aria-controls="cg-explore" aria-selected="false" tabindex="-1" data-cg-view="explorations">
          Explorations <span class="cg-tab-n num" id="ex-count" hidden></span>
        </a>
        <a role="tab" id="cg-tab-history" href="/studio/changes/?view=history" aria-controls="cg-history" aria-selected="false" tabindex="-1" data-cg-view="history">History</a>
      </div>

      <section class="cg-panel" id="cg-review" role="tabpanel" aria-labelledby="cg-tab-review">
        <section class="zone cg-open" id="cg-opener" aria-live="polite">
          <p class="cg-open-sentence" id="cg-open-sentence">Open pull requests load from GitHub.</p>
          <p class="cg-asof" id="cg-asof" hidden></p>
          <ButtonLink variant="primary" href="/studio/changes/" id="cg-open-cta" hidden>Review</ButtonLink>
        </section>

        <div class="cg-draft" id="cg-draft" hidden>
          <Icon name="draft" size={20} />
          <p><strong>Your draft:</strong> <span id="cg-draft-n">token edits</span>, only in this browser. <span id="cg-draft-dest"></span></p>
          <ButtonLink size="sm" href="/studio/tokens/#review" data-keep-branch>Review and propose</ButtonLink>
        </div>

        <div class="cg-status-bar">
          <div class="cg-status-seg"><SegmentedControl label="Status" data-vanilla data-status-filter defaultValue="open" items={statusItems} /></div>
          <div class="cg-status-select"><StatusFilterSelect client:media="(max-width: 760px)" /></div>
        </div>

<div class="cg-work" data-work-bar hidden>
          <span class="t-ui t-muted" aria-hidden="true">Show</span>
          <SegmentedControl label="Show" data-vanilla data-work-filter size="sm" defaultValue="all" items={workItems} />
        </div>
        <p class="cg-muted cg-filter" id="cg-tier-filter" hidden>Showing <span data-tier-label>one kind of change</span> only. <a href="/studio/changes/">Show all</a></p>

        <div class="fg-card cg-card" id="cg-table">
          <ul class="cg-list" id="rv-list" aria-label="Changes in review" aria-busy="true">
            <li class="cg-row cg-skel" aria-hidden="true"></li>
            <li class="cg-row cg-skel" aria-hidden="true"></li>
            <li class="cg-row cg-skel" aria-hidden="true"></li>
          </ul>
          {/* Try several changes together (components/ds/studio/CombineChanges): the selection bar of this list. */}
          <div class="cg-together" id="cg-together" data-admin={PRODUCTION_APPS.admin ?? ''}></div>
        </div>

        <p class="cg-muted cg-work-none" data-work-none hidden></p>

        <div class="cg-empty" id="cg-empty" hidden>
          <Illustration name="review" width={200} />
          <p class="cg-empty-title">Nothing to review.</p>
          <p class="cg-muted">Changes proposed from <a href="/studio/tokens/" data-keep-branch>Tokens</a> land here.</p>
        </div>

        <details class="cg-sec cg-dev cg-dev-page" id="other-branches">
          <summary class="cg-sec-head"><span class="cg-sec-title">For developers</span><span class="cg-sec-meta">Branches and automation on GitHub</span><span class="cg-sec-chev" aria-hidden="true"></span></summary>
          <div class="cg-sec-body">
            <p class="cg-muted">This list holds the changes people review. Branches without a pull request, and the release pull request the changesets action opens, live on GitHub. The release shows as the next release in History.</p>
            <p class="cg-links"><a href={`${repoUrl}/branches`} target="_blank" rel="noopener">Branches on GitHub</a><a href={`${repoUrl}/pulls`} target="_blank" rel="noopener">All pull requests on GitHub</a></p>
          </div>
        </details>
      </section>

      <section class="cg-panel" id="cg-requests" role="tabpanel" aria-labelledby="cg-tab-requests" hidden>
        <section class="zone cg-open" id="rq-opener" aria-live="polite">
          <p class="cg-open-sentence" id="rq-sentence">Component change requests load from GitHub.</p>
          <p class="cg-asof rq-rule">Each request is someone who wants to change a component. Start an exploration and Claude builds it, or assign someone.</p>
        </section>

<div class="cg-work" data-work-bar hidden>
          <span class="t-ui t-muted" aria-hidden="true">Show</span>
          <SegmentedControl label="Show" data-vanilla data-work-filter size="sm" defaultValue="all" items={workItems} />
        </div>
        <div class="fg-card cg-card" id="rq-table">
          <ul class="cg-list" id="rq-list" aria-label="Component change requests" aria-busy="true">
            <li class="cg-row cg-skel" aria-hidden="true"></li>
            <li class="cg-row cg-skel" aria-hidden="true"></li>
          </ul>
        </div>

        <p class="cg-muted cg-work-none" data-work-none hidden></p>

        <details class="cg-other" id="rq-closed" hidden>
          <summary class="cg-sec-head"><span class="cg-sec-title">Done and declined</span><span class="cg-sec-meta" id="rq-closed-n"></span><span class="cg-sec-chev" aria-hidden="true"></span></summary>
          <ul class="fg-card cg-list" id="rq-closed-list" aria-label="Closed component change requests"></ul>
        </details>

        <div hidden id="rq-previews">
          {previews.map((c) => <template data-component={c.name}><Example node={c.docs!.preview!} /></template>)}
        </div>

        <div class="cg-empty" id="rq-empty" hidden>
          <Illustration name="guide" width={200} />
          <p class="cg-empty-title">No component change request yet.</p>
          <p class="cg-muted rq-empty-text">
            Designers ask for a new component or a change from the Push tab of the DS Bridge Figma plugin, or from a component in <a href="/studio/components/">Components</a>.
            Developers see each request where they work, on GitHub.
          </p>
        </div>
      </section>

      <section class="cg-panel" id="cg-explore" role="tabpanel" aria-labelledby="cg-tab-explore" hidden>
        <section class="zone cg-open" id="ex-opener" aria-live="polite">
          <p class="cg-open-sentence" id="ex-sentence">Explorations load from GitHub.</p>
          <p class="cg-asof ex-rule">Try token and component ideas in a safe copy, test them in staging, then send the good ones for review.</p>
          <Button variant="primary" id="ex-start-open" aria-expanded="false" aria-controls="ex-start">Start an exploration</Button>
        </section>

        <form class="fg-card rq-form ex-form" id="ex-start" aria-label="Start an exploration" novalidate hidden>
          <p class="ex-for" id="ex-for" hidden></p>
          <label class="rq-field">Name
            <input name="name" autocomplete="off" maxlength="60" placeholder="Pill buttons" aria-describedby="ex-name-hint" />
            <span class="rq-hint" id="ex-name-hint">Teammates see this name in Changes and in the Figma plugin.</span>
          </label>
          <label class="rq-field">What do you want to learn?
            <textarea name="purpose" rows="2" placeholder="Do rounder buttons read as friendlier in checkout?"></textarea>
          </label>
          <label class="rq-field">Use case
            <select name="useCase" aria-describedby="ex-uc-hint">
              <option value="">Not set</option>
              {EXPLORATION_USE_CASES.map((u) => <option value={u.value}>{u.label}</option>)}
            </select>
            <span class="rq-hint" id="ex-uc-hint"></span>
          </label>
          <p class="gh-error" id="ex-start-error" role="alert" hidden></p>
          <p class="rq-hint ex-no-gh" data-no-gh>{ghAction('start it here', signIn)}.</p>
          <p class="ex-actions">
            <Button type="submit" variant="primary" id="ex-start-submit" data-gh-only hidden>Start exploration</Button>
            <Button variant="secondary" data-no-gh data-gh-open>{ghButton(signIn)}</Button>
            <Button variant="ghost" data-ex-cancel>Cancel</Button>
          </p>
          <details class="cg-sec cg-dev ex-dev">
            <summary class="cg-sec-head"><span class="cg-sec-title">For developers</span><span class="cg-sec-meta">CLI and GitHub</span><span class="cg-sec-chev" aria-hidden="true"></span></summary>
            <div class="cg-sec-body">
              <p class="rq-hint" id="ex-branch"></p>
              <div class="rq-cmd-row"><code class="cg-cmd rq-cmd" id="ex-start-cmd"></code><Button variant="secondary" size="sm" data-copy data-copy-from="ex-start-cmd"><span data-copy-label>Copy command</span></Button></div>
            </div>
          </details>
        </form>
        <div class="ex-done" id="ex-done" role="status" hidden></div>

<div class="cg-work" data-work-bar hidden>
          <span class="t-ui t-muted" aria-hidden="true">Show</span>
          <SegmentedControl label="Show" data-vanilla data-work-filter size="sm" defaultValue="all" items={workItems} />
        </div>
        <div class="fg-card cg-card" id="ex-table">
          <ul class="cg-list" id="ex-list" aria-label="Explorations" aria-busy="true">
            <li class="cg-row cg-skel" aria-hidden="true"></li>
            <li class="cg-row cg-skel" aria-hidden="true"></li>
          </ul>
        </div>

        <p class="cg-muted cg-work-none" data-work-none hidden></p>

        <div class="cg-empty" id="ex-empty" hidden>
          <Illustration name="guide" width={200} />
          <p class="cg-empty-title">No exploration running.</p>
          <p class="cg-muted ex-rule">Start one when an idea needs real screens before it becomes a change:</p>
          <ul class="ex-uses">
            <li>A coded prototype for a user test, in staging.</li>
            <li>A stakeholder demo of a new look, with real components.</li>
            <li>An A/B idea, next to what ships today.</li>
            <li>Exploring with Claude Code, in a safe copy of the library.</li>
          </ul>
        </div>
      </section>

      <section class="cg-panel" id="cg-history" role="tabpanel" aria-labelledby="cg-tab-history" hidden>
        <section class="zone cg-open hs-next" id="hs-next" aria-live="polite" aria-labelledby="hs-next-title">
          <p class="cg-open-sentence" id="hs-next-title">{historyLine}</p>
          <ul class="hs-next-lines" id="hs-next-lines" hidden></ul>
          <p class="cg-asof" id="hs-next-who" hidden></p>
          <ButtonLink variant="primary" href="/studio/changes/" id="hs-next-cta" hidden>Review and publish</ButtonLink>
        </section>
        <div class="cg-hs-head">
          <p class="cg-hs-line">Token changes, by release</p>
          <Button variant="secondary" size="sm" id="hs-filter-toggle" aria-expanded="false" aria-controls="hs-filters">Filter</Button>
        </div>
        <form class="hs-filters" id="hs-filters" role="search" aria-label="Filter history" hidden>
          <label class="gh-field"><span>Token</span><input id="hs-token" list="hs-paths" placeholder="color.text.muted or color.text" autocomplete="off" spellcheck="false" /></label>
          <datalist id="hs-paths"></datalist>
          <label class="gh-field"><span>Author</span><select id="hs-author"><option value="">Anyone</option></select></label>
          <label class="gh-field"><span>Kind of change</span><select id="hs-tier"><option value="">Any change</option><option value="3">Token changes, design + tech approval</option><option value="2">Component changes, design + tech approval</option><option value="1">Docs fixes, one approval</option></select></label>
          <Button type="reset" variant="secondary" size="sm" id="hs-clear">Clear filters</Button>
        </form>
        <Alert tone="warning" announce="off" title="Demo data: fixture changes, not this repository's history." className="st-hideable st-hs-banner" id="hs-banner" hidden>Nothing here can be proposed.</Alert>

        <div id="hs-list-view">
          <div class="cg-timeline" id="hs-timeline" aria-busy="true">
            <div class="fg-card cg-card"><ul class="cg-list"><li class="cg-row cg-skel" aria-hidden="true"></li></ul></div>
          </div>
          <p class="hs-none" id="hs-none" hidden>No change matches these filters. <Button variant="ghost" size="sm" data-hs-clear>Clear filters</Button></p>
        </div>
        <div id="hs-detail" class="hs-detail" hidden></div>

        <div class="hs-bar cg-hs-foot">
          {
            demoHistory && (
              <>
                <button type="button" class="hs-switch" id="hs-demo" role="switch" aria-checked="false">
                  <span class="hs-switch-track" aria-hidden="true"><span class="hs-switch-thumb"></span></span>
                  <span>Show demo history</span>
                </button>
                <span class="cg-muted">Development only: fixture changes, to try the timeline and undo.</span>
              </>
            )
          }
          <a class="cg-hs-log" href="/changelog/">Library changelog</a>
        </div>
      </section>
    </div>
    <div id="rv-detail" class="rv-detail" hidden></div>
  </div>

  <HistoryPlanner />
  <PromoteToReview client:only="react" />
  <RequestDecide client:only="react" />
  <script type="application/json" id="bridge-contrast" set:html={checks} />
  <script type="application/json" id="bridge-branches" set:html={cfgJson} />
  <script>
    import { initChanges } from '../../scripts/changes';
    initChanges();
  </script>
</Layout>
