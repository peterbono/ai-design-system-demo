---
// The review queue, reached from "Review all" on the Studio home. Everything that waits on the viewer on the left, each
// row marked with what the viewer did to it (components/ds/studio/ReviewQueue, rows read by scripts/home-data.ts), the
// selected item in the main area, and one bar about that item: comment, Suggest changes, Approve, More actions. A branch opens
// in place with the branch review of Branches (scripts/reviews.ts openPr into #rv-detail), so this page carries what
// that review needs: the notice, the owner override dialog, the promote dialog and the contrast and branches data.
// A suggestion row (a change a developer applies once owners approve it) opens the suggestion review in place
// (components/ds/studio/SuggestionReview), with its own Approve and Suggest changes; Decline uses RequestDecide.
// Usage guidance drafts, library health and setup rows show a short card with the link that handles them.
// Script: scripts/review-queue-page.ts. Moves: lib/queue-nav.ts.
import '../../styles/reviews.css';
import '../../styles/branch-review.css';
import '../../styles/product-branch.css';
import '../../styles/motion-changes.css';
import '../../styles/history.css';
import '../../styles/changes.css';
import '../../styles/studio-home.css';
import '../../styles/branch-thumb.css';
import '../../styles/review-queue.css';
import '../../styles/suggestion-review.css';
import Layout from '../../layouts/Layout.astro';
import ScriptDialog from '../../components/ds/ScriptDialog.astro';
import PromoteToReview from '../../components/ds/studio/PromoteToReview';
import RequestDecide from '../../components/ds/studio/RequestDecide';
import { Alert, Button, ButtonGroup, Skeleton, Textarea } from '@bridge-ds/react';
import { docsEditHref, guidanceState, loadComponents } from '../../lib/components';
import { git, PREVIEW_APPS, PREVIEW_PACKAGES, readText } from '../../lib/repo';
import { CONTRAST_FILE } from '../../lib/contrast';
import { siteRepo } from '../../lib/config';
import { PAGE_SOURCES, freshness } from '../../lib/sources';
import { dashboard } from '../../lib/stats';
import type { BranchesConfig } from '../../lib/branches';

// The same build-time facts as the home (pages/studio/index.astro), so the queue lists the same rows.
const s = dashboard();
const comps = loadComponents();
/** When a file last changed on main (ISO), null when git has no answer (a shallow clone). */
const changedAt = (path: string): string | null => git(['log', '-1', '--format=%cI', '--', path]) || null;
const guidance = comps.filter((c) => guidanceState(c) === 'review').map((c) => ({ name: c.name, href: docsEditHref(c.slug), since: changedAt(c.files.docs) }));
const homeStatic = { contrastFail: s.contrast.fail };

// What the branch review needs (pages/studio/changes.astro).
const r = siteRepo();
const checks = readText(CONTRAST_FILE).replace(/</g, '\\u003c');
const cfg: BranchesConfig = { owner: r.owner, repo: r.repo, defaultBranch: r.defaultBranch, apps: PREVIEW_APPS, packages: PREVIEW_PACKAGES };
---

<Layout
  title="Review queue"
  description="Everything that waits on you, one after the other: the branch review in place, approve and go to the next."
  sources={PAGE_SOURCES.home}
  updated={freshness(PAGE_SOURCES.home)}
  wide
>
  <div class="rv rq" data-review-queue>
    <h1 class="sr-only">Review queue</h1>
    <p class="rv-notice" id="rv-notice" role="status" hidden></p>
    <div class="rq-layout" data-rq-layout>
      <div class="rq-side" data-rq-side>
        <Skeleton variant="rect" className="sh-skel" />
      </div>
      <div class="rq-pick" data-rq-pick></div>
      <section class="rq-main" aria-label="Selected item">
        <div class="rq-card" data-rq-card></div>
        <div class="rq-sg" data-rq-sg hidden></div>
        <div id="rv-detail" class="rv-detail rq-detail" hidden></div>
        <div class="rq-foot" data-rq-foot hidden></div>
      </section>
    </div>
    <div class="rq-empty" data-rq-empty hidden></div>
    <div data-rq-toasts></div>
  </div>

  {/* The owner override confirmation, as on Branches (scripts/reviews.ts wireOverride fills and opens it). */}
  <ScriptDialog id="rv-ov" title="Merge as owner override?" closeLabel="Close" disablePointerDismissal popup={{ role: 'alertdialog', 'aria-describedby': 'rv-ov-desc' }}>
    <div class="gh-dialog-body">
      <div id="rv-ov-desc" class="rv-ov-desc">
        <p>This merges the branch into main without:</p>
        <ul class="rv-ov-missing" data-rv-ov="missing"></ul>
        <p>Your reason is posted on the branch and shown in History.</p>
      </div>
      <Textarea label="Reason" data-rv-ov="reason" rows={3} hint="Shown on the branch." placeholder="Solo maintainer, tests pass, I reviewed the token diff and contrast." />
      <Alert tone="danger" className="st-hideable" data-rv-ov="error" hidden><span data-rv-ov="error-text"></span></Alert>
    </div>
    <Fragment slot="footer">
      <ButtonGroup align="end">
        <Button variant="secondary" data-dialog-close>Cancel</Button>
        <Button variant="primary" data-rv-ov="go">Post reason and merge</Button>
      </ButtonGroup>
    </Fragment>
  </ScriptDialog>
  <PromoteToReview client:only="react" />
  <RequestDecide client:only="react" />
  <script type="application/json" id="home-static" set:html={JSON.stringify(homeStatic)} />
  <script type="application/json" id="home-guidance" set:html={JSON.stringify({ drafted: guidance }).replace(/</g, '\\u003c')} />
  <script type="application/json" id="bridge-contrast" set:html={checks} />
  <script type="application/json" id="bridge-branches" set:html={JSON.stringify(cfg).replace(/</g, '\\u003c')} />
  <script>
    import { initReviewQueue } from '../../scripts/review-queue-page';
    initReviewQueue();
  </script>
</Layout>
