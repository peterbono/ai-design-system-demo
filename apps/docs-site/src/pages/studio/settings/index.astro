---
// Studio Settings: one page for designers and design system owners. Each section is a band: on wide screens its
// title and one sentence sit in a left column, its rows in a DS Card on the right, with every value close to its
// label; the page stops at 1200px so nothing stretches across a wide monitor. In order:
//   Account       the GitHub connection: a compact row once connected, the page's one Harbor zone (with a Field
//                 Guide drawing and Connect GitHub) while Studio is read only.
//   Review rules  who the design and tech owners are (people or GitHub teams, read from GitHub), who approves design,
//                 who approves tech and who ships (edited in place, sent for review as a change to bridge.config.json), what each kind of change needs (plain rules from docs/GOVERNANCE.md, no
//                 tier numbers) and the owner override as a fold.
//   Safety        protection of the library and when the visual before and after runs, each with its action.
//   Figma and Claude, Integrations (Jira), then one collapsed "For developers" section: repository sources, tiers
//   and modes, previews and snapshot packages, the tier table, MCP details, Jira secrets and workflow.
// The old Repository, Governance and Integrations pages redirect to these anchors (lib/redirects.ts); an anchor inside
// the developer section opens it.
import '../../../styles/settings.css';
import '../../../styles/requests.css';
import Layout from '../../../layouts/Layout.astro';
import StudioHeader from '../../../components/StudioHeader.astro';
import ButtonLink from '../../../components/ds/ButtonLink';
import ApprovalsTable from '../../../components/ds/studio/ApprovalsTable';
import ProtectionRow from '../../../components/ds/studio/ProtectionRow';
import ChangeRules from '../../../components/ds/studio/ChangeRules';
import SettingsAccount from '../../../components/ds/studio/SettingsAccount';
import { signInConfig } from '../../../lib/signin-config';
import Illustration from '../../../components/Illustration.astro';
import { GitHubMark } from '../../../components/ds/studio/brand-icons';
import { Badge, Button, Card, CodeBlock, CardBody, CardHeader, Input, Link, SegmentedControl } from '@bridge-ds/react';
import { siteRepo } from '../../../lib/config';
import { GOVERNANCE_FILE, pluginListing, tierSummaries } from '../../../lib/governance';
import { inline } from '../../../lib/markdown';
import { mcpTools } from '../../../lib/mcp';
import { HOW_REVIEW_WORKS } from '../../../lib/nav';
import { exists, GITHUB_URL, lastUpdated, readText } from '../../../lib/repo';
import { CHOICE_LABEL, OWNER_GROUP_HELP, OWNER_GROUP_LABEL, roleRows, VISUAL_MODE_HELP, VISUAL_MODE_LABEL, type RightChoice } from '../../../lib/roles-view';
import OwnersField from '../../../components/ds/studio/OwnersField';
import { repoStatus } from '../../../lib/stats';
import { approvalRules, mcpAddCommand, overrideText } from '../../../lib/settings-view';
import { REQUEST_LABEL } from '@bridge-ds/core';

const r = siteRepo();
const repoName = `${r.owner}/${r.repo}`;
const build = repoStatus();
const file = 'bridge.config.json';
const pluginReadme = 'apps/figma-plugin/README.md';
const sources = [file, GOVERNANCE_FILE, pluginReadme];

let config: Record<string, any> = {};
try {
  config = exists(file) ? JSON.parse(readText(file)) : {};
} catch {
  config = {};
}
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const list = (xs: string[]) => (xs.length ? xs.join(', ') : 'none');

// Repository: one mono style for every value; "(default)" is plain muted text.
type Row = { label: string; value: string; defaultValue?: string; values?: string[] };
const source: Row[] = [
  { label: 'Config', value: file },
  { label: 'Token root', value: r.tokensRoot },
  { label: 'Contrast gate', value: config.contrast?.path ?? 'not configured' },
  { label: 'Components', value: config.components?.dir ?? 'not configured' },
  { label: 'Changesets', value: config.changesets?.dir ?? '.changeset' },
];
const tiersAndModes: Row[] = [
  ...Object.entries((config.tokens?.tiers ?? {}) as Record<string, string[]>).map(([tier, folders]) => ({ label: cap(tier), value: folders.join(', ') })),
  ...Object.entries((config.modes ?? {}) as Record<string, { values: string[]; default?: string }>).map(([axis, m]) => ({
    label: `${cap(axis)} modes`,
    value: '',
    values: m.values,
    defaultValue: m.default,
  })),
];
const previewApps = Object.keys(config.previews?.apps ?? {});
const owners: Row[] = [
  { label: 'Preview deploys', value: list(previewApps) },
  { label: 'Snapshot packages', value: list(config.previews?.packages ?? []) },
];

// Review rules: who approves design, who approves tech, who ships. Safety: when the visual before and after runs.
const roles = roleRows(r.owners, r.rights);
const mode = r.visualImpact.mode;
const choices = (['design', 'tech', 'both'] as RightChoice[]).map((c) => ({ value: c, label: CHOICE_LABEL[c] }));
const rolesData = JSON.stringify({
  prefix: config.governance?.branchPrefix ?? '',
  protectedBranches: config.governance?.protectedBranches ?? ['main', 'master'],
  owners: r.owners,
}).replace(/</g, '\\u003c');

// Figma and Claude rows.
const plugin = pluginListing(exists(pluginReadme) ? readText(pluginReadme) : '');
const tools = mcpTools().length;

// Approvals: plain rules first (no tier numbers), the tier table under "For developers". One source: docs/GOVERNANCE.md.
const tierRows = tierSummaries();
const rules = approvalRules(tierRows);
const tiers = tierRows.map((t) => ({ ...t, approvalsHtml: inline(t.approvals), href: `/studio/changes/?tier=${t.tier}` }));
// Connect your Claude: the one command, repository from bridge.config.json, the token left as a placeholder.
const claudeCommand = mcpAddCommand(repoName);
const override = overrideText(r.override);

// Integrations: GitHub issues always; Jira when bridge.config.json says so (the bridge-jira workflow does the sync).
const jira = r.integrations.jira;
const reqCfg = r.integrations.requests ?? {};
const ghRepo = `https://github.com/${r.owner}/${r.repo}`;
const secretsUrl = `${ghRepo}/settings/secrets/actions`;
const workflowFile = '.github/workflows/bridge-jira.yml';
const workflowUrl = `${ghRepo}/blob/${r.defaultBranch}/${workflowFile}`;
const issuesUrl = `${ghRepo}/issues?q=${encodeURIComponent(`is:issue label:${REQUEST_LABEL}`)}`;
const intData = JSON.stringify({
  prefix: config.governance?.branchPrefix ?? '',
  protectedBranches: config.governance?.protectedBranches ?? ['main', 'master'],
  workflowUrl,
  secretsUrl,
}).replace(/</g, '\\u003c');
const signIn = Boolean(signInConfig());
---

<Layout title="Settings" description="Your GitHub connection, who approves what, how the library stays safe, and the tools that work on it." sources={sources} updated={lastUpdated(sources)} wide>
  <div class="set-page">
    <StudioHeader title="Settings" />

    <section class="set-band" id="connection" aria-labelledby="set-account">
      <div class="set-band-intro">
        <h2 id="set-account" class="set-h">Account</h2>
        <p class="set-intro">{signIn ? 'Studio acts on GitHub as you, once you sign in. Your sign-in stays in this browser.' : 'Studio acts on GitHub with your own token. It stays in this browser.'}</p>
      </div>
      <div class="set-band-body">
        <SettingsAccount client:load repo={repoName} signIn={signIn}>
          <Illustration name="review" width={132} />
        </SettingsAccount>
      </div>
    </section>

    <section class="set-band" id="roles" aria-labelledby="set-rules">
      <div class="set-band-intro">
        <h2 id="set-rules" class="set-h">Review rules</h2>
        <p class="set-intro">Who approves a change before it ships, and what each kind of change needs. <Link href={HOW_REVIEW_WORKS}>How review works</Link></p>
      </div>
      <div class="set-band-body">
        <Card aria-labelledby="set-roles-title">
          <CardHeader>
            <h3 id="set-roles-title" class="set-card-title">Who approves and ships</h3>
            <Button variant="secondary" data-density="compact" data-roles-edit aria-controls="set-roles-form" data-gh-gate="edit the roles">Edit</Button>
          </CardHeader>
          <CardBody>
            <form class="set-form" id="set-roles-form" data-roles-form data-editing="false" novalidate>
              <div class="set-rows">
                {
                  (['design', 'tech'] as const).map((g) => (
                    <div class="set-row">
                      <div>
                        <p class="set-row-label" id={`set-owners-${g}`}>
                          {OWNER_GROUP_LABEL[g]}
                        </p>
                        <p class="set-row-help">{OWNER_GROUP_HELP[g]}</p>
                      </div>
                      <div class="set-row-value">
                        <OwnersField client:load group={g} org={r.owner} initial={r.owners[g]} />
                      </div>
                    </div>
                  ))
                }
                {
                  roles.map((x) => (
                    <div class="set-row">
                      <div>
                        <p class="set-row-label" id={`set-role-${x.right}`}>
                          {x.label}
                        </p>
                        <p class="set-row-help">{x.help}</p>
                      </div>
                      <div class="set-row-value">
                        <p class="set-who" data-view>{x.who}</p>
                        <SegmentedControl data-edit aria-labelledby={`set-role-${x.right}`} data-vanilla data-right={x.right} data-initial={x.choice ?? ''} defaultValue={x.choice ?? undefined} items={choices} />
                      </div>
                    </div>
                  ))
                }
              </div>
              <div class="set-savebar" data-edit>
                <div class="rq-actions">
                  <Button variant="primary" type="submit" data-roles-submit disabled>Send for review</Button>
                  <Button variant="secondary" data-roles-cancel>Cancel</Button>
                  <span class="set-muted">Your team approves it before it applies.</span>
                </div>
                <p class="rq-error" role="alert" data-roles-error hidden></p>
              </div>
              <div class="rq-done" role="status" data-roles-done hidden></div>
            </form>
          </CardBody>
        </Card>
        <div id="approvals">
          <ChangeRules client:visible rules={rules.map((x) => ({ what: x.what, who: cap(x.who) }))} override={override} />
        </div>
      </div>
    </section>

    <section class="set-band" id="safety" aria-labelledby="set-safety">
      <div class="set-band-intro">
        <h2 id="set-safety" class="set-h">Safety</h2>
        <p class="set-intro">What keeps unreviewed changes out of the library, and when the visual before and after runs.</p>
      </div>
      <div class="set-band-body">
        <Card>
          <CardBody>
            <div class="set-rows">
              <div>
                <ProtectionRow client:load />
              </div>
              <form class="set-row set-form" id="set-visual-form" data-roles-form data-editing="false" novalidate>
                <p class="set-row-label" id="set-role-visual">Visual before and after</p>
                <div class="set-row-value">
                  <p class="set-who" data-view>{VISUAL_MODE_LABEL[mode]}</p>
                  <SegmentedControl
                    data-edit
                    aria-labelledby="set-role-visual"
                    data-vanilla
                    data-visual-mode
                    data-initial={mode}
                    defaultValue={mode}
                    items={[
                      { value: 'auto', label: VISUAL_MODE_LABEL.auto },
                      { value: 'on-demand', label: VISUAL_MODE_LABEL['on-demand'] },
                    ]}
                  />
                  <p class="set-row-help" data-visual-help data-auto={VISUAL_MODE_HELP.auto} data-on-demand={VISUAL_MODE_HELP['on-demand']}>{VISUAL_MODE_HELP[mode]}</p>
                </div>
                <div class="set-row-action" data-view>
                  <Button variant="secondary" data-density="compact" data-roles-edit data-visual-edit aria-controls="set-visual-form" data-gh-gate="change when it runs">Change</Button>
                </div>
                <div class="set-savebar set-row-full" data-edit>
                  <div class="rq-actions">
                    <Button variant="primary" type="submit" data-roles-submit disabled>Send for review</Button>
                    <Button variant="secondary" data-roles-cancel>Cancel</Button>
                    <span class="set-muted">Your team approves it before it applies.</span>
                  </div>
                  <p class="rq-error" role="alert" data-roles-error hidden></p>
                </div>
                <div class="rq-done set-row-full" role="status" data-roles-done hidden></div>
              </form>
            </div>
          </CardBody>
        </Card>
      </div>
    </section>

    <section class="set-band" id="tools" aria-labelledby="set-tools">
      <div class="set-band-intro">
        <h2 id="set-tools" class="set-h">Figma and Claude</h2>
        <p class="set-intro">Work on the library from Figma or from your own Claude. Both send their changes for review.</p>
      </div>
      <div class="set-band-body">
        <Card>
          <CardBody>
            <div class="set-rows">
              <div class="set-row">
                <p class="set-row-label">Figma plugin</p>
                <p class="set-row-value">Pull tokens into Figma Variables and send variable edits back for review.</p>
                <p class="set-row-action">
                  {
                    plugin.url ? (
                      <>
                        <Link href={plugin.url}>Community page</Link>
                        {plugin.inReview && <span class="set-quiet">in review</span>}
                      </>
                    ) : (
                      <Link href="/install/#figma-plugin">Install it</Link>
                    )
                  }
                </p>
              </div>
              <div class="set-row" id="claude">
                <p class="set-row-label">Your own Claude</p>
                <div class="set-row-value set-row-span">
                  <p>
                    Gives your Claude {tools} tools on this design system. It sends changes for review and never ships them on its own. Run this once in a terminal, with your
                    GitHub token in place of <span class="mono">&lt;your token&gt;</span>.
                  </p>
                  <CodeBlock className="set-cmd" code={claudeCommand} label="Command to run once" />
                </div>
              </div>
            </div>
          </CardBody>
        </Card>
      </div>
    </section>

    <section class="set-band" id="integrations" aria-labelledby="set-integrations">
      <div class="set-band-intro">
        <h2 id="set-integrations" class="set-h">Integrations</h2>
        <p class="set-intro">Component change requests live in GitHub. Mirror them to Jira if your team plans there.</p>
      </div>
      <div class="set-band-body">
        <Card data-set-jira>
          <CardBody>
            <div class="set-rows">
              <div class="set-row">
                <p class="set-row-label">
                  Jira
                  {
                    jira ? (
                      <Badge tone="success" size="sm" dot>
                        Connected
                      </Badge>
                    ) : (
                      <Badge size="sm">Not set up</Badge>
                    )
                  }
                </p>
                <p class="set-row-value set-row-span">
                  {
                    jira
                      ? `Each new request becomes a ${jira.issueType ?? 'Task'} in ${jira.project} on ${jira.baseUrl.replace(/^https:\/\//, '')}, with a link back to GitHub.`
                      : 'Each new request becomes a Jira issue in your project, with a link back to GitHub. Optional: skip it if your team follows requests in GitHub.'
                  }
                </p>
              </div>
            </div>
            <details class="set-more set-jira-setup" id="jira-setup">
              <summary><span class="set-more-title">{jira ? 'Change Jira settings' : 'Set up Jira'}</span><span class="set-chev" aria-hidden="true"></span></summary>
              <form class="rq-form" data-int-form novalidate>
                <div class="rq-pair">
                  <Input label="Jira site" name="baseUrl" type="url" inputMode="url" autoComplete="off" placeholder="https://acme.atlassian.net" defaultValue={jira?.baseUrl ?? ''} />
                  <Input label="Project key" name="project" autoComplete="off" placeholder="DS" defaultValue={jira?.project ?? ''} />
                </div>
                <div class="rq-pair">
                  <Input label="Issue type" name="issueType" autoComplete="off" defaultValue={jira?.issueType ?? 'Task'} />
                  <Input label="Jira labels" name="jiraLabels" autoComplete="off" placeholder="design-system" defaultValue={(jira?.labels ?? []).join(', ')} />
                </div>
                <p class="set-int-group">Every request, in GitHub</p>
                <div class="rq-pair">
                  <Input label="Labels" name="requestLabels" autoComplete="off" placeholder="design" defaultValue={(reqCfg.labels ?? []).join(', ')} />
                  <Input label="Assignees" name="assignees" autoComplete="off" placeholder="@login" defaultValue={(reqCfg.assignees ?? []).map((a) => `@${a}`).join(', ')} />
                </div>
                <p class="rq-error" role="alert" data-int-error hidden></p>
                <div class="rq-actions">
                  <Button variant="secondary" type="submit" data-int-submit data-gh-gate="propose integrations">Send for review</Button>
                  <span class="set-muted">Nothing changes until it ships. A developer then adds the Jira secrets once (For developers, below).</span>
                </div>
                <div class="rq-done" role="status" data-int-done hidden></div>
              </form>
            </details>
          </CardBody>
        </Card>
      </div>
    </section>

    <section class="set-dev-block" id="developer" aria-label="For developers">
      <details class="set-more set-dev" id="for-developers" data-dev-fold>
        <summary>
          <span class="set-more-title">For developers</span>
          <span class="set-more-n">Repository, tiers and modes, previews, MCP, Jira workflow</span>
          <span class="set-chev" aria-hidden="true"></span>
        </summary>

        <h3 class="set-group" id="repository">Repository</h3>
        <div class="set-lead">
          <p>
            Reading <span class="mono">{repoName}</span>, <span class="mono">{r.defaultBranch}</span>, built at <span class="mono">{build.sha}</span>.
          </p>
          <ButtonLink variant="secondary" size="sm" iconStart={GitHubMark} href={GITHUB_URL}>Open on GitHub</ButtonLink>
        </div>
        <dl class="set-dl set-dl-after">
          {
            source.map((x) => (
              <div>
                <dt>{x.label}</dt>
                <dd class="mono">{x.value}</dd>
              </div>
            ))
          }
        </dl>

        <h3 class="set-group" id="tiers-and-modes">Tiers and modes</h3>
        <dl class="set-dl">
          {
            tiersAndModes.map((x) => (
              <div>
                <dt>{x.label}</dt>
                <dd class="mono">
                  {x.values
                    ? x.values.map((v, i) => (
                        <>
                          {i > 0 && ', '}
                          {v}
                          {v === x.defaultValue && <span class="set-default"> (default)</span>}
                        </>
                      ))
                    : x.value}
                </dd>
              </div>
            ))
          }
        </dl>

        <h3 class="set-group" id="owners-and-previews">Previews</h3>
        <dl class="set-dl">
          {
            owners.map((x) => (
              <div>
                <dt>{x.label}</dt>
                <dd class="mono">{x.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="set-muted">Change these in a pull request on <span class="mono">{file}</span>: it is a guarded file, reviewed at the highest tier.</p>

        <h3 class="set-group" id="approval-tiers">Approvals by risk tier</h3>
        <ApprovalsTable rows={tiers} />

        <h3 class="set-group" id="mcp">MCP server</h3>
        <p class="set-muted">
          {tools} tools. Claude works on a <span class="mono">{config.governance?.branchPrefix ?? ''}*</span> branch and opens a pull request, never commits to
          <span class="mono">{r.defaultBranch}</span>. Clients, local setup and the full tool list: <a href="/agents/#mcp">Agents page</a>.
        </p>

        <h3 class="set-group" id="jira-workflow">Jira workflow</h3>
        <ol class="set-checklist">
          <li>Merge the pull request that changes <span class="mono">{file}</span>. It is a guarded file, so it gets the highest review tier.</li>
          <li>
            Add the repository secrets <span class="mono">JIRA_EMAIL</span> and <span class="mono">JIRA_API_TOKEN</span> in <a href={secretsUrl}>Settings, Secrets and variables, Actions</a>.
          </li>
          <li>The <a href={workflowUrl} class="mono">{workflowFile}</a> workflow creates the Jira issue for each new request and labels the GitHub issue with its key.</li>
        </ol>
        <p class="set-muted">
          Requests are GitHub issues labeled <span class="mono">{REQUEST_LABEL}</span>, closed by the pull request that implements them. Follow them by
          <a href={issuesUrl}>filtering issues by that label</a>, or link GitHub and Jira with Atlassian's <a href="https://github.com/marketplace/jira-software-github">GitHub for Jira</a> app.
        </p>
      </details>
    </section>
  </div>

  <script type="application/json" id="set-int-data" set:html={intData} />
  <script type="application/json" id="set-roles-data" set:html={rolesData} />
  <script>
    // An anchor inside "For developers" (#repository, #tiers-and-modes, #mcp...) opens it, then scrolls there.
    const revealHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const el = id ? document.getElementById(id) : null;
      const fold = el?.closest<HTMLDetailsElement>('[data-dev-fold]');
      if (!el || !fold) return;
      fold.open = true;
      el.scrollIntoView();
    };
    revealHash();
    window.addEventListener('hashchange', revealHash);
  </script>
  <script>
    import { initRoles } from '../../../scripts/roles';
    initRoles();
  </script>
  <script>
    import { initIntegrations } from '../../../scripts/integrations';
    initIntegrations();
  </script>
</Layout>
