---
import Layout from '../../layouts/Layout.astro';
import StudioHeader from '../../components/StudioHeader.astro';
import DraftTray from '../../components/DraftTray.astro';
import ButtonLink from '../../components/ds/ButtonLink';
import { Pencil } from 'lucide-react';
import TokenEditorData from '../../components/TokenEditorData.astro';
import '../../styles/editor.css';
import '../../styles/reviews.css';
---

<Layout title="Drafts" description="Token edits waiting in this browser: before and after values, contrast moves and the guardrails, ready to propose as a pull request." wide>
  <StudioHeader title="Drafts" subtitle="Token edits waiting in this browser. Nobody else sees them until you propose them.">
    <Fragment slot="actions"><ButtonLink variant="secondary" size="sm" iconStart={Pencil} href="/studio/tokens/" data-keep-branch>Keep editing</ButtonLink></Fragment>
  </StudioHeader>
  <DraftTray variant="page" />
  <p class="rv-foot-note">
    Proposing creates a <code>tokens/*</code> branch with a changeset and opens a Tier 3 pull request in <a href="/studio/reviews/" data-keep-branch>Reviews</a>. Without GitHub, export the draft as JSON.
  </p>
  <TokenEditorData />
  <script>
    import { initTokenEditor } from '../../scripts/token-editor';
    initTokenEditor();
  </script>
</Layout>
