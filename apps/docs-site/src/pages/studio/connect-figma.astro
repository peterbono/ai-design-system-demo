---
// Where the Figma plugin's "Sign in with Bridge" opens (api/plugin-link, docs/SIGN-IN.md "The Figma plugin"). Not in the
// nav. The person picks the team whose design system the Figma file uses; the plugin receives it, with no token pasted.
import Layout from '../../layouts/Layout.astro';
import Illustration from '../../components/Illustration.astro';
import ConnectFigma from '../../components/ds/studio/ConnectFigma';
import { CONNECT_WORDS as W } from '../../lib/connect-figma';
import { lastUpdated } from '../../lib/repo';

const updated = lastUpdated(['apps/docs-site/src/pages/studio/connect-figma.astro', 'apps/docs-site/src/components/ds/studio/ConnectFigma.tsx', 'apps/docs-site/api/plugin-link/index.ts']);
---

<Layout title={W.title} description="Connect the Bridge plugin in Figma to your team's design system." crumbs={false} updated={updated}>
  <section class="zone cf" aria-labelledby="cf-title">
    <div class="cf-art" aria-hidden="true"><Illustration name="components" width={132} /></div>
    <div class="cf-text">
      <h1 id="cf-title" class="cf-title">{W.title}</h1>
      <p class="cf-sub">{W.lede}</p>
      <ConnectFigma client:load />
    </div>
  </section>
</Layout>

<style>
  .cf {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    max-width: calc(var(--size-64) * 3);
    margin: var(--space-10) auto;
    padding: var(--space-6) var(--space-7);
  }

  .cf-art {
    display: flex;
    flex: none;
    color: var(--color-text-default);
  }

  .cf-text {
    display: grid;
    flex: 1 1 var(--size-60);
    gap: var(--space-4);
    min-width: 0;
  }

  .cf-title {
    margin: 0;
    font-family: var(--typography-h2-family);
    font-size: var(--typography-h2-size);
    font-weight: var(--typography-h2-weight);
    letter-spacing: var(--typography-h2-tracking);
    line-height: var(--typography-h2-line-height);
  }

  .cf-sub {
    margin: 0;
    font-size: var(--typography-ui-size);
    line-height: var(--typography-ui-line-height);
  }

  .cf-text :global(.cf-step) {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .cf-text :global(.cf-step p) {
    margin: 0;
  }

  @media (max-width: 640px) {
    .cf {
      margin: var(--space-6) 0;
      padding: var(--space-5);
    }

    .cf-art {
      display: none;
    }
  }
</style>
