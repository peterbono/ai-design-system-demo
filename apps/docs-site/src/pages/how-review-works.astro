---
// Library > Use > How review works: the shared view (components/ds/library/views/ReviewView.tsx), rendered at build
// time from docs/GOVERNANCE.md and AGENTS.md, so the page never drifts from the rules people and agents follow.
import '../styles/library.css';
import '../styles/review-guide.css';
import Layout from '../layouts/Layout.astro';
import ReviewView from '../components/ds/library/views/ReviewView';
import { siteLibraryData } from '../lib/library-site';
import { siteUseExtras } from '../lib/library-use';
import { PAGE_SOURCES, freshness } from '../lib/sources';

const sources = PAGE_SOURCES.governance;
const updated = freshness(sources);
---

<Layout title="How review works" description="Risk tiers, review gates, the owner override and the rules the AI agent follows. Same gates for every change, whoever writes it." sources={sources} updated={updated}>
  <ReviewView data={siteLibraryData({ use: siteUseExtras() })} />
  <script>
    import { initReviewPage } from '../scripts/use-pages';
    initReviewPage();
  </script>
</Layout>
