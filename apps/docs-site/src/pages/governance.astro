---
import { Badge } from '@demo-ds/react';
import Layout from '../layouts/Layout.astro';
import Updated from '../components/Updated.astro';
import { agentRules, approvals, reviewGates, reviewingAgentPrs, riskTiers } from '../lib/governance';
import { inline } from '../lib/markdown';
import { PAGE_SOURCES, freshness } from '../lib/sources';

const updated = freshness(PAGE_SOURCES.governance);
const tiers = riskTiers();
const who = approvals();
const gates = reviewGates();
const agentChecks = reviewingAgentPrs();
const rules = agentRules();

const journey = [
  { title: 'Explore in Figma', text: 'A designer tries the change on real screens. Nothing in Figma reaches the product by itself.' },
  { title: 'Propose with DS Bridge', text: 'The DS Bridge plugin turns the proposal into a pull request against the token files. An issue works too; then the AI agent or a maintainer writes the pull request.' },
  { title: 'Pull request', text: 'The change is a diff on a branch, with a risk tier, a changelog entry and a note on what to review.' },
  { title: 'CI guardrails', text: 'Automated checks run on every pull request: tokens build, types check, no raw colors or shadows in components, Storybook builds, a changelog entry exists.' },
  { title: 'Design and tech review', text: 'The design owner checks both themes, contrast and keyboard focus in Storybook. The tech owner checks naming, API and version bump. Token changes need both.' },
  { title: 'Merge', text: 'A person who owns that area merges. The AI agent never merges.' },
  { title: 'Release', text: 'Changesets bumps the version and writes the changelog from the entries collected in each pull request.' },
  { title: 'Docs update themselves', text: 'This site rebuilds from the repo: color tables, contrast checks, component pages, the changelog and llms.txt all reflect the change. Figma variables are re-imported from the same files.' },
];

const tierTone = (cell: string) => (cell.startsWith('3') ? 'danger' : cell.startsWith('2') ? 'warning' : 'success');
const ruleTone = { Always: 'success', 'Ask before': 'warning', Never: 'danger' } as const;
const ruleIntro = {
  Always: 'Things the agent does on every change.',
  'Ask before': 'The agent stops and asks a person first, and the pull request gets the higher review tier.',
  Never: 'Hard limits. Most are also blocked by CI, so breaking them fails the build.',
} as const;
---

<Layout title="Governance" description="Who approves what, how a token change travels, and how the AI agent is constrained." sources={PAGE_SOURCES.governance} updated={updated}>
  <h1>Governance</h1>
  <p class="lead">
    Every change goes through the same gates, whoever writes it: a designer, an engineer or the AI agent. How much review a change gets depends on
    how risky it is.
  </p>
  <Updated date={updated} />

  <h2 id="tiers">Who approves what</h2>
  <p>Risk tiers, from <code>docs/GOVERNANCE.md</code>. If a change spans tiers, the highest one applies.</p>
  {
    tiers && (
      <div class="table-wrap">
        <table>
          <thead>
            <tr>{tiers.head.map((h) => <th scope="col">{h}</th>)}</tr>
          </thead>
          <tbody>
            {tiers.rows.map((row) => (
              <tr>
                {row.map((cell, i) =>
                  i === 0 ? (
                    <th scope="row">
                      <Badge tone={tierTone(cell)}>Tier {cell}</Badge>
                    </th>
                  ) : (
                    <td set:html={inline(cell)} />
                  ),
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
  {
    who && (
      <>
        <h3>By area</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>{who.head.map((h) => <th scope="col">{h}</th>)}</tr>
            </thead>
            <tbody>
              {who.rows.map((row) => (
                <tr>
                  {row.map((cell, i) => (i === 0 ? <th scope="row" set:html={inline(cell)} /> : <td>{cell === 'Approves' ? <strong>Approves</strong> : cell}</td>))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }

  <h2 id="journey">How a token change travels</h2>
  <ol class="steps">
    {
      journey.map((s) => (
        <li>
          <strong>{s.title}</strong>
          {s.text}
        </li>
      ))
    }
  </ol>

  <h3>The review gates, as written for reviewers</h3>
  <ol>{gates.map((g) => <li set:html={inline(g)} />)}</ol>

  <h2 id="agent">How the AI agent is constrained</h2>
  <p>
    The agent reads <code>AGENTS.md</code> before every task. Here are its rules in plain language; expand a rule to see the exact wording it
    follows. Rules marked "original wording" changed recently and have no plain-language version yet.
  </p>
  <div class="rules">
    {
      rules.map((group) => (
        <section class="panel" aria-labelledby={`rules-${group.heading}`}>
          <h3 id={`rules-${group.heading}`}>
            <Badge tone={ruleTone[group.heading]}>{group.heading}</Badge>
          </h3>
          <p class="muted small">{ruleIntro[group.heading]}</p>
          <ul>
            {group.rules.map((r) => (
              <li>
                {r.plain === r.original ? <span set:html={inline(r.original)} /> : r.plain}
                {!r.rewritten && <span class="muted"> (original wording)</span>}
                {r.rewritten && (
                  <details>
                    <summary>Exact rule</summary>
                    <span set:html={inline(r.original)} />
                  </details>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <h3>What reviewers check on an agent's pull request</h3>
  <ul>{agentChecks.map((c) => <li set:html={inline(c)} />)}</ul>
</Layout>
