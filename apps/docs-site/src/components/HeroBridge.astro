---
// The one memorable moment: a suspension bridge between Figma and Git. The main cable draws once on load
// (skipped with reduced motion). Chips on the deck are real semantic tokens, swatches use the DS variables.
import Icon from './Icon.astro';
import { loadTokens } from '../lib/tokens';
import { dashboard } from '../lib/stats';

const { semantic } = loadTokens();
const wanted = ['color.action.primary.bg', 'color.feedback.success.solid', 'color.feedback.warning.solid'];
const picks = wanted.map((p) => semantic.find((s) => s.path === p)).filter((s) => s !== undefined);
const chips = (picks.length ? picks : semantic.filter((s) => s.type === 'color').slice(0, 3)).slice(0, 3);
const stats = dashboard();

// Suspension cables: verticals from the main cable down to the deck.
const cable = (x: number) => {
  // Quadratic Bezier from (70,64) via (280,-46) to (490,64): y(t) = (1-t)^2*64 + 2(1-t)t*(-46) + t^2*64
  const t = (x - 70) / 420;
  return (1 - t) ** 2 * 64 + 2 * (1 - t) * t * -46 + t ** 2 * 64;
};
const hangers = Array.from({ length: 13 }, (_, i) => 100 + i * 30);
---

<div class="bridge" aria-hidden="true">
  <svg class="bridge-svg" viewBox="0 0 560 300" preserveAspectRatio="xMidYMid meet">
    <defs>
      <pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="2" height="6" class="hatch" />
      </pattern>
    </defs>
    <rect x="0" y="236" width="560" height="64" fill="url(#hatch)" class="water" />
    {hangers.map((x) => <line x1={x} x2={x} y1={cable(x) + 3} y2="176" class="hanger" />)}
    <path d="M10 112 Q 40 70 70 64" class="cable side" />
    <path d="M490 64 Q 520 70 550 112" class="cable side" />
    <path d="M70 64 Q 280 -46 490 64" class="cable main" pathLength="1" />
    <rect x="58" y="52" width="24" height="200" rx="4" class="pillar" />
    <rect x="478" y="52" width="24" height="200" rx="4" class="pillar" />
    <rect x="62" y="96" width="16" height="6" rx="2" class="pillar-cut" />
    <rect x="482" y="96" width="16" height="6" rx="2" class="pillar-cut" />
    <rect x="0" y="176" width="560" height="14" rx="3" class="deck" />
  </svg>

  <div class="bank bank-left">
    <span class="bank-icon"><Icon name="figma" size={18} /></span>
    <span><strong>Figma</strong><small>variables and components</small></span>
  </div>
  <div class="bank bank-right">
    <span class="bank-icon"><Icon name="github" size={18} /></span>
    <span><strong>Git</strong><small class="num">{stats.total} tokens, {stats.components} components</small></span>
  </div>

  <ul class="deck-chips">
    {
      chips.map((s, i) => (
        <li class={`deck-chip chip-${i + 1}`}>
          <span class="deck-swatch" data-theme="light" style={`background-color: var(${s.cssVar})`} />
          <code>{s.path}</code>
        </li>
      ))
    }
  </ul>
  <div class="bank bank-docs">
    <span class="bank-icon"><Icon name="doc" size={18} /></span>
    <span><strong>Docs</strong><small>for humans, and llms.txt for agents</small></span>
  </div>
</div>
