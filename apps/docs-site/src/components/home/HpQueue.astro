---
// The design system lead's queue, played on the homepage: pick a change, Approve it (with Undo), or Suggest changes
// (a note to its author). Every state is in the markup; scripts/homepage.ts shows one at a time. DS Buttons and the
// DS Textarea, rendered statically.
import { Button, Textarea } from '@bridge-ds/react';
import HpProfile from './HpProfile.astro';
import { QUEUE } from '../../lib/homepage';
---

<div class="hp-card hp-queue" data-queue>
  <div class="hp-qside">
    <strong class="hp-qhead">Waiting on you<span class="hp-qcnt" data-q-count>{QUEUE.length}</span></strong>
    <div class="hp-qlist" role="list">
      {
        QUEUE.map((q) => (
          <div role="listitem" data-q-row={q.id}>
            <Button variant="ghost" size="sm" fullWidth className="hp-qrow" pressed={q.id === 'ph'} data-q-pick={q.id}>
              {q.title}
            </Button>
          </div>
        ))
      }
      <p class="hp-qempty" data-q-empty hidden>Nothing waiting on you.</p>
    </div>
  </div>
  <div class="hp-qmain" aria-live="polite">
    {
      QUEUE.map((q) => (
        <div class="hp-qpane" data-q-pane={q.id} hidden={q.id !== 'ph'}>
          <p class="hp-ask">
            {q.who === 'Claude AI' ? (
              <span class="hp-ai hp-ai-md" aria-hidden="true">
                <svg><use href="#hp-robot" /></svg>
              </span>
            ) : (
              <span class="hp-av hp-av-xs" aria-hidden="true">A</span>
            )}
            {q.who} asks for your review
          </p>
          <div class="hp-qitem">
            {q.id === 'ph' ? (
              <span class="hp-qthumb hp-qthumb-mini" aria-hidden="true">
                <HpProfile card />
              </span>
            ) : (
              <span class="hp-qthumb" aria-hidden="true">
                <i />
                <span>
                  <u />
                  <u />
                </span>
              </span>
            )}
            <span>
              {q.kind}: {q.title}
            </span>
          </div>
          <p class="hp-qpass">
            <svg aria-hidden="true"><use href="#hp-check" /></svg>All contrast checks pass
          </p>
          <div class="hp-qact">
            <Button variant="secondary" data-q-suggest aria-expanded="false" aria-controls={`hp-qn-${q.id}`}>Suggest changes</Button>
            <Button variant="primary" data-q-approve={q.id}>Approve</Button>
          </div>
          <div class="hp-qnote" id={`hp-qn-${q.id}`} hidden>
            <Textarea label={`Your suggestion to ${q.who}`} placeholder="What should change?" rows={2} />
            <div class="hp-qsend">
              <Button variant="primary" size="sm" data-q-send={q.who}>Send</Button>
            </div>
          </div>
        </div>
      ))
    }
    <div class="hp-qpane" data-q-pane="done" hidden>
      <p class="hp-qpass"><svg aria-hidden="true"><use href="#hp-check" /></svg>All caught up.</p>
      <p class="hp-qsub">New changes from designers and Claude AI land here.</p>
    </div>
  </div>
  <div class="hp-note hp-qtoast" role="status" data-q-toast>
    <svg aria-hidden="true"><use href="#hp-check" /></svg><span data-q-toast-text>Approved</span>
    <Button variant="inverse" size="sm" data-q-undo>Undo</Button>
  </div>
</div>
