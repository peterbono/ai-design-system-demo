---
// "Decide in seconds.": the design system lead's board, ported from the owner-validated test page (hp-run/parts/lead.html).
// One picture (role img): Ann's review card in front, the next changes stacked behind; a 9 s loop where the next change
// joins the stack, the After pane wipes in and Approve pulses (styles/home-illus.css, ldec). No live controls.
import { Kbd } from '@bridge-ds/react';
---

<section class="hp-ldec" aria-labelledby="hp-lead-t">
  <div class="hp-wrap hp-ldec-g">
    <div class="hp-ldec-t">
      <p class="hp-ldec-who"><span class="hp-ldec-dana" aria-hidden="true" focusable="false"><svg width="34" height="34" viewBox="55 100 30 30" fill="none"><g stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M58 131Q60 124 70 123.5Q80 124 82 131" data-f="zone" /><path d="M78.2 115C78.2 116.6 77.7 118.6 76.8 119.9C75.8 121.3 74.2 122.5 72.6 123.1C71.1 123.6 68.9 123.8 67.3 123.3C65.7 122.8 64.1 121.4 63.1 120C62.1 118.7 61.3 116.7 61.3 115C61.2 113.3 61.8 111.2 62.8 109.8C63.8 108.4 65.7 107.1 67.3 106.6C68.9 106.2 71 106.5 72.6 107.1C74.1 107.7 75.7 108.8 76.7 110.2C77.6 111.5 78.2 113.4 78.2 115Z" data-f="page" /><path d="M61 115Q61 104 70 105Q79 105 79 114Q71 110 61 115Z" data-f="ink" /><path d="M77.5 106.5Q81.5 104.5 81 101.5" stroke-width="3" /><circle cx="67" cy="116" r=".9" data-f="ink" stroke="none" /><circle cx="73" cy="116" r=".9" data-f="ink" stroke="none" /></g></svg></span><span class="hp-ldec-wl"><span>For the design system lead</span><span class="hp-ldec-wn">Dana, who leads this design system</span></span></p>
      <h2 id="hp-lead-t" class="hp-st-h hp-ldec-h">Decide in seconds.</h2>
      <p class="hp-ldec-p">Each change shows itself, checks already run. Look, approve, next. The rest of the team's queue waits its turn, one by one.</p>
    </div>

    <div class="hp-ldec-stack" role="img" aria-label="A review card: Ann Leroy asks for your review of the profile header, follow button and avatar. Before and after previews side by side, with design system checks, contrast in light and dark, and usage in Admin demo and Docs site already passed. Approve and Suggest changes buttons, with keyboard shortcuts A, S and J. Behind it, the next changes wait their turn: from Leo, from Claude AI and from Dana's team.">
      <div class="hp-ldec-back hp-ldec-join"><div class="hp-ldec-bl"><svg class="hp-ldec-mini" width="14" height="14" viewBox="55 100 30 30" fill="none"><rect x="55" y="100" width="30" height="30" data-f="page" /><g stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M58 131Q60 124 70 123.5Q80 124 82 131" data-f="zone" /><circle cx="69.75" cy="115" r="8.4" data-f="page" /><path d="M61 115Q61 104 70 105Q79 105 79 114Q71 110 61 115Z" data-f="ink" /><path d="M77.5 106.5Q81.5 104.5 81 101.5" stroke-width="3" /></g></svg><span>Card spacing · Dana's team</span></div></div>
      <div class="hp-ldec-back hp-ldec-b2"><div class="hp-ldec-bl"><span class="hp-ldec-bot"><svg width="9" height="9" viewBox="0 0 24 24" fill="none"><path d="M12 2.6v2.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /><circle cx="12" cy="2.4" r="1.3" data-f="ink" /><path d="M6.2 6.4C9.6 5.9 14.6 6 17.9 6.5C19.1 6.7 19.6 7.6 19.6 8.9L19.4 15.6C19.3 17 18.6 17.7 17.3 17.8C13.9 18.1 9.8 18.1 6.6 17.8C5.3 17.7 4.6 17 4.5 15.6L4.4 8.9C4.4 7.5 5 6.6 6.2 6.4Z" data-f="page" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><circle cx="9.2" cy="11.2" r="1.35" data-f="ink" /><circle cx="14.8" cy="11.2" r="1.35" data-f="ink" /><path d="M9.6 14.6Q12 15.8 14.4 14.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none" /><path d="M4.4 10.6H2.9M19.6 10.6h1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /><path d="M8.6 18v2.6M15.4 18v2.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg></span><span>Focus ring offset · Claude AI</span></div></div>
      <div class="hp-ldec-back hp-ldec-b1"><div class="hp-ldec-bl"><span class="hp-ldec-leo">L</span><span>Darker default background · Leo</span></div></div>

      <div class="hp-ldec-card">
        <div class="hp-ldec-hd">
          <span class="hp-ldec-ann"><svg width="36" height="36" viewBox="55 100 30 30" fill="none"><g stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M60.6 124.5Q58.8 106 70 104.8Q81.2 106 79.4 124.5Z" data-f="ink" /><path d="M58 131Q60 124 70 123.5Q80 124 82 131" data-f="page" /><path d="M78.2 115C78.2 116.6 77.7 118.6 76.8 119.9C75.8 121.3 74.2 122.5 72.6 123.1C71.1 123.6 68.9 123.8 67.3 123.3C65.7 122.8 64.1 121.4 63.1 120C62.1 118.7 61.3 116.7 61.3 115C61.2 113.3 61.8 111.2 62.8 109.8C63.8 108.4 65.7 107.1 67.3 106.6C68.9 106.2 71 106.5 72.6 107.1C74.1 107.7 75.7 108.8 76.7 110.2C77.6 111.5 78.2 113.4 78.2 115Z" data-f="page" /><path d="M61.4 113.6Q62.6 106 70 105.8Q77.4 106 78.6 113.6Q74 109.6 67.4 110.6Q64 111.2 61.4 113.6Z" data-f="ink" /><circle cx="67" cy="116.4" r=".9" data-f="ink" stroke="none" /><circle cx="73" cy="116.4" r=".9" data-f="ink" stroke="none" /><path d="M68.4 119.6Q70 120.5 71.6 119.6" stroke-width="1.2" /></g></svg></span>
          <span class="hp-ldec-ask"><span class="hp-ldec-l1"><b>Ann Leroy</b> <span class="hp-ldec-mut">asks for your review</span></span><span class="hp-ldec-l2">Profile header, follow button and avatar</span></span>
          <span class="hp-ldec-keys"><span class="hp-ldec-k"><Kbd keys="A" size="sm" />approve</span><span class="hp-ldec-dot">·</span><span class="hp-ldec-k"><Kbd keys="S" size="sm" />suggest</span><span class="hp-ldec-dot">·</span><span class="hp-ldec-k"><Kbd keys="J" size="sm" />next</span></span>
        </div>
        <div class="hp-ldec-ba">
          <div class="hp-ldec-col"><span class="hp-ldec-lab">Before</span><div class="hp-ldec-pane"><div class="hp-ldec-pc"><span class="hp-ldec-pav">AL</span><span class="hp-ldec-pt"><b>Ann Leroy</b><small>Product designer</small><span class="hp-ldec-fol">Follow</span></span></div></div></div>
          <div class="hp-ldec-col"><span class="hp-ldec-lab">After</span><div class="hp-ldec-pane hp-ldec-wipe"><div class="hp-ldec-pc hp-ldec-new"><span class="hp-ldec-pav">AL</span><span class="hp-ldec-pt"><b>Ann Leroy</b><small>Product designer</small><span class="hp-ldec-fol">Follow</span></span></div></div></div>
        </div>
        <div class="hp-ldec-chips"><span class="hp-ldec-chip"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>Design system checks</span><span class="hp-ldec-chip"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>Contrast light and dark</span><span class="hp-ldec-chip"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>Used in Admin demo and Docs site</span></div>
        <div class="hp-ldec-ft"><span class="hp-ldec-bs">Suggest changes</span><span class="hp-ldec-bp hp-ldec-ring">Approve<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span></div>
      </div>
    </div>
  </div>
</section>
