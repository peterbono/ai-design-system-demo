---
// Bridge mark (Field Guide): a hand-set arch over a plank deck on three posts, with a Harbor strip of water below.
// Ink strokes follow the text color; the strip uses the zone color. Wordmark in the display face.
import Illustration from './Illustration.astro';

interface Props {
  wordmark?: boolean;
}
const { wordmark = true } = Astro.props;
---

<span class="logo">
  <Illustration name="logo" class="logo-mark" />
  {wordmark && <span class="logo-word">Bridge</span>}
</span>
