---
// GitHub status for the whole Studio, at the bottom of the Studio side nav (and in the phone menu sheet): "Connect
// GitHub" with "Read only until connected" until a token is checked, then the avatar, login and repository, opening
// the account menu (repository, access, dark theme, change token, disconnect). The header slot switches space instead.
// In Studio the theme lives here once connected (the side nav foot shows it until then), so the top bar stays lean.
// When GitHub refuses the saved token (revoked, regenerated or expired), the block says so with a Reconnect button
// instead of the account. Painted by scripts/github-session.ts (every [data-gh-connect] block gets data-state
// readonly|checking|connected|rejected).
// With a GitHub App (docs/SIGN-IN.md) the button is "Sign in" with a neutral sign-in icon, since a team may also let
// people in with their email: on such a team it opens the team's sign-in screen (both ways in, components/ds/studio/
// NoAccess.tsx), elsewhere (the sample team, a site without email sign-in) it goes straight to GitHub. The menu has
// no "Change token" then: the designer UI never offers a token paste. The rejected and menu wording follows the
// session kind. An email contributor (lib/contribute.ts, real teams only) gets the same account row, never a sign-in
// button: the DS drawn face (never initials), their name, their email as the second line, and the menu with Sign out. The block is the same on every Studio page: one full-width DS Button, the read-only line under it as
// its description.
import { Avatar, Button, Icon, Link } from '@bridge-ds/react';
import { siteIcon } from '../brand/site-icons';
import ButtonLink from './ds/ButtonLink';
import { GitHubMark } from './ds/studio/brand-icons';
import { LogIn, LogOut, Pencil, Settings } from 'lucide-react';
import { siteRepo } from '../lib/config';
import { teamDisplayName } from '../lib/demo';
import { signInConfig } from '../lib/signin-config';
import { ghVerb } from '../lib/gh-wording';
import { studioHref } from '../lib/team-path';

interface Props {
  /** The browser workspace (pages/studio/workspace.astro): no repository yet, and it signs in like a team page. */
  workspace?: boolean;
}

const { workspace = false } = Astro.props;
const r = siteRepo();
const signIn = Boolean(signInConfig(workspace));
---

<div class="gh-acct" data-gh-connect data-gh-acct data-state="checking">
  <div class="gh-acct-connect">
    <Button variant="primary" iconStart={signIn ? LogIn : GitHubMark} fullWidth data-gh-open data-gh-signin={signIn ? '' : undefined} data-gh-signin-screen={signIn ? '' : undefined} aria-describedby="gh-acct-note">
      {ghVerb(signIn)}
    </Button>
    <p class="gh-acct-note" id="gh-acct-note">{signIn ? 'Read only until you sign in' : 'Read only until connected'}</p>
  </div>
  <div class="gh-acct-rejected" role="status">
    <p class="gh-acct-rejected-text">
      <Icon icon={siteIcon('alert')} size="sm" className="icon" />
      <span data-gh-rejected-text>Your GitHub token stopped working</span>
    </p>
    <Button variant="primary" iconStart={GitHubMark} fullWidth data-gh-open data-gh-signin>
      <span data-gh-reconnect-label>{signIn ? 'Sign in with GitHub' : 'Reconnect'}</span>
    </Button>
  </div>
  <details class="menu gh-acct-menu" data-menu>
    <summary class="gh-acct-who" aria-label="GitHub account">
      <Avatar name="GitHub" size="md" decorative className="gh-acct-avatar" data-gh-avatar hidden />
      <span class="gh-acct-text">
        <span class="gh-acct-login" data-gh-login></span>
        {workspace ? <span class="gh-acct-repo">No repository yet</span> : <span class="gh-acct-repo" data-team-display>{teamDisplayName(`${r.owner}/${r.repo}`, r)}</span>}
      </span>
      <span class="scope-pick-chev" aria-hidden="true"><Icon icon={siteIcon('chevron')} size="xs" className="icon" /></span>
    </summary>
    <div class="menu-panel" role="group" aria-label="GitHub account">
      <p class="menu-title" data-gh-menu-title>GitHub</p>
      <dl class="gh-facts">
        <dt>Signed in</dt>
        <dd data-gh-login-full></dd>
        <dt>Repository</dt>
        <dd>{workspace ? 'None yet' : <Link href={`https://github.com/${r.owner}/${r.repo}`} className="mono" data-team-github><span data-team-name>{r.owner}/{r.repo}</span></Link>}</dd>
        <dt>Access</dt>
        <dd><span class="gh-perm" data-gh-perm>Checking</span></dd>
      </dl>
      <p class="menu-help" data-gh-perm-help hidden>This token can read but not write. Reviews and token proposals need Contents and Pull requests write access.</p>
      <div class="menu-actions">
        {!signIn && <Button variant="ghost" size="sm" iconStart={Pencil} className="st-hideable" data-gh-open data-gh-token-only>Reconnect GitHub</Button>}
        <ButtonLink variant="ghost" size="sm" iconStart={Settings} href={studioHref('settings/#connection')} data-keep-branch>Settings</ButtonLink>
        <Button variant="ghost" size="sm" iconStart={LogOut} data-gh-forget><span data-gh-forget-label>Disconnect</span></Button>
      </div>
    </div>
  </details>
</div>
