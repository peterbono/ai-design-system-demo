---
// The undo and restore planner, as a side panel the width of the token review sheet. Include once per page that
// offers "Undo this change" or "Restore this value". A native modal <dialog> (focus trap, Escape) driven by
// scripts/history/planner.ts: one sentence on top, the edits, contrast pairs collapsed with their count, and one
// primary action pinned in the footer.
import { Alert, Button, IconButton } from '@bridge-ds/react';
import { X } from 'lucide-react';
import { ghAction } from '../lib/gh-wording';
import { signInConfig } from '../lib/signin-config';

const signIn = Boolean(signInConfig());
---

<!-- bridge-audit-ignore-next-line: Undo planner, a native modal <dialog> opened by a plain script (showModal, focus trap, Escape); the DS Dialog is a React island, so moving it is a rewrite of the script. Follow-up: DS Dialog with a static open/close contract -->
<dialog class="hp-panel" id="hp-dialog" aria-labelledby="hp-title">
  <div class="hp-box">
    <header class="hp-head">
      <h2 id="hp-title" class="hp-title">Undo this change</h2>
      <IconButton icon={X} label="Close the planner" size="sm" id="hp-close" />
    </header>
    <div class="hp-scroll">
      <Alert tone="warning" announce="off" className="st-hideable" id="hp-demo-flag" hidden>Demo data: this plan runs on a fixture change, not on this repository's history.</Alert>
      <div id="hp-body" class="hp-body" aria-live="polite"></div>
    </div>
    <footer class="hp-foot">
      <p class="hp-status" id="hp-status" role="status" aria-live="polite"></p>
      <Button variant="primary" className="st-hideable" data-gh-open id="hp-connect" hidden>{ghAction('propose', signIn)}</Button>
      <Button variant="primary" className="st-hideable" id="hp-propose">Propose undo</Button>
    </footer>
  </div>
</dialog>
