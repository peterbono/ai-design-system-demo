---
// The revert and restore planner. Include once per page that offers "Undo this change" or "Restore this value".
// Native <dialog> driven by scripts/history/planner.ts; the controls inside are DS components.
import { Alert, Button, IconButton } from '@bridge-ds/react';
import { X } from 'lucide-react';
---

<dialog class="gh-dialog hp-dialog" id="hp-dialog" aria-labelledby="hp-title">
  <div class="gh-dialog-box hp-box">
    <header class="gh-dialog-head">
      <h2 id="hp-title">Plan a revert</h2>
      <IconButton icon={X} label="Close the planner" size="sm" id="hp-close" />
    </header>
    <Alert tone="warning" announce="off" className="st-hideable" id="hp-demo-flag" hidden>Demo data: this plan runs on a fixture change, not on this repository's history.</Alert>
    <div id="hp-body" class="hp-body" aria-live="polite"></div>
    <p class="small" id="hp-status" role="status" aria-live="polite"></p>
    <footer class="gh-dialog-foot hp-foot">
      <Button variant="secondary" size="sm" id="hp-download-json">Download patch</Button>
      <Button variant="secondary" size="sm" id="hp-download-md">Download PR text</Button>
      <span class="gh-spacer"></span>
      <Button variant="secondary" size="sm" className="st-hideable" data-gh-open id="hp-connect" hidden>Connect GitHub</Button>
      <Button variant="primary" size="sm" className="st-hideable" id="hp-propose">Propose revert</Button>
    </footer>
  </div>
</dialog>
