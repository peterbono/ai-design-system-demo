import '../../styles/foundations.css';
import TokenDetailDrawer from '../explorer/TokenDetailDrawer.astro';
---

<div class="fd-toast" id="fd-toast" role="status" aria-live="polite" hidden></div>
<TokenDetailDrawer />

<script>
  import { initFoundations } from '../../scripts/foundations';
  initFoundations();
</script>
