---
// Compact brand or density switch in a specimen header, only on specimens it changes: a static DS SegmentedControl
// (data-vanilla). The preview scope is one state for the site: scripts/shell.ts sets it from the switch's
// bridge:segment event and selects the matching segment in every [data-scope-switch] on the page.
// The label sits outside the track, as a caption to its left: inside the same pill it would read as one more option.
// The track holds the options only and takes its accessible name from the label (aria-labelledby).
import { SegmentedControl } from '@bridge-ds/react';
import { BRANDS, BRAND_LABEL, DENSITIES, DENSITY_LABEL } from '../../lib/tokens';

interface Props {
  axis: 'brand' | 'density';
}
const { axis } = Astro.props;
const options = axis === 'brand' ? BRANDS.map((b) => ({ value: b, label: BRAND_LABEL[b] })) : DENSITIES.map((d) => ({ value: d, label: DENSITY_LABEL[d] }));
const name = axis === 'brand' ? 'Preview brand' : 'Preview density';
// Several switches can share a page (one per color group): each label needs its own id.
// One brand (or density) in the repo: nothing to compare, so no switch.
const show = options.length > 1;
const labelId = `fd-scope-${axis}-${Math.random().toString(36).slice(2, 8)}`;
---

{show && (<div class="fd-scope-field">
  <span class="fd-scope-label" id={labelId}>{name}</span>
  <SegmentedControl aria-labelledby={labelId} data-vanilla data-scope-switch={axis} defaultValue={options[0]!.value} items={options} />
</div>)}
