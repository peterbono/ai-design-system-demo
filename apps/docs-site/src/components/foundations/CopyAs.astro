---
// Page-level "Copy as" switch of the Library foundation pages: what a click on a token name copies. Remembered per
// browser (scripts/foundations.ts). A DS SegmentedControl rendered statically; scripts/shell.ts drives it
// (data-vanilla) and scripts/foundations.ts follows its bridge:segment events.
import { SegmentedControl } from '@bridge-ds/react';
import { COPY_FORMATS, COPY_LABEL } from '../../lib/library-rows';
---

<div class="fd-copyas">
  <span class="fd-copyas-label" id="fd-copyas-label">Copy names as</span>
  <SegmentedControl
    aria-labelledby="fd-copyas-label"
    size="sm"
    defaultValue={COPY_FORMATS[0]}
    items={COPY_FORMATS.map((f) => ({ value: f, label: COPY_LABEL[f] }))}
    data-vanilla
    data-fd-formats
  />
</div>
