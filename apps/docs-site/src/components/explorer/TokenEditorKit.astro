---
// Everything token editing needs besides the explorer itself: the draft tray, the add and propose dialogs, the full
// editor drawer (live component preview, rename, delete), the GitHub and revert dialogs. TokenExplorer includes it in
// mode="edit"; a page that switches the explorer into edit mode at runtime (the token explorer page) includes it once.
import Icon from '../Icon.astro';
import { Alert, Button, IconButton, Input, Textarea } from '@bridge-ds/react';
import { X } from 'lucide-react';
import GitHubDialog from '../GitHubDialog.astro';
import HistoryPlanner from '../HistoryPlanner.astro';
import EditorPreview from '../EditorPreview.tsx';
import { explorerTokens } from '../../lib/explorer';

const palette = explorerTokens()
  .filter((t) => t.layer === 'brand' && t.type === 'color')
  .map((t) => t.path);
---

<div class="xp-kit" data-xp-kit>
  <template id="ed-preview-tpl"><EditorPreview theme="light" /></template>

  <div class="ed-sheet-scrim" data-ed-sheet-scrim hidden></div>
  <section class="ed-tray" id="ed-tray" data-open="false" aria-label="Draft changes" hidden>
    <div class="ed-tray-bar">
      <button type="button" class="ed-tray-toggle" id="ed-tray-toggle" aria-expanded="false" aria-controls="ed-tray-panel">
        <span class="ed-tray-count" id="ed-tray-count">No draft changes yet</span>
        <span class="ed-tray-status" id="ed-tray-status"></span>
        <Icon name="chevron" size={14} />
      </button>
      <div class="ed-tray-actions">
        <Button variant="secondary" size="sm" id="ed-export">Export JSON</Button>
        <Button variant="primary" size="sm" id="ed-propose" data-gh-gate="open a pull request" disabled>Propose change</Button>
        <IconButton icon={X} label="Close drafts" size="sm" className="st-hideable" data-ed-sheet-close hidden />
      </div>
    </div>
    <div class="ed-tray-panel" id="ed-tray-panel">
      <ul class="ed-tray-list" id="ed-tray-list"></ul>
      <div class="ed-tray-foot">
        <p class="small muted">Saved in this browser only, no GitHub needed. Proposing opens a Tier 3 pull request labeled <code>source: bridge-web</code> and needs GitHub.</p>
        <Button variant="danger" size="sm" id="ed-discard">Discard draft</Button>
      </div>
    </div>
  </section>

  <dialog class="gh-dialog" id="ed-add-dialog" aria-labelledby="ed-add-title">
    <form method="dialog" class="gh-dialog-box">
      <header class="gh-dialog-head">
        <h2 id="ed-add-title">New semantic color</h2>
        <IconButton icon={X} label="Close" size="sm" type="submit" value="cancel" />
      </header>
      <p>A semantic token names a job, like <code>color.bg.canvas</code>. Point each theme at a palette role so brands can re-theme it. It stays a draft in this browser until you propose it; proposing a new token is Tier 3.</p>
      <Input label="Name" data-ed-field="add-path" placeholder="color.bg.canvas" spellCheck={false} autoComplete="off" />
      <Input label="Light points to" data-ed-field="add-light" list="ed-palette" placeholder="palette.neutral.50" spellCheck={false} autoComplete="off" />
      <Input label="Dark points to" data-ed-field="add-dark" list="ed-palette" placeholder="palette.neutral.950" spellCheck={false} autoComplete="off" />
      <datalist id="ed-palette">{palette.map((p) => <option value={p} />)}</datalist>
      <Alert tone="danger" className="st-hideable" data-ed-field="add-error" hidden><span data-ed-error-text></span></Alert>
      <footer class="gh-dialog-foot">
        <span class="gh-spacer"></span>
        <Button variant="secondary" size="sm" type="submit" value="cancel">Cancel</Button>
        <Button variant="primary" size="sm" id="ed-add-save">Add to draft</Button>
      </footer>
    </form>
  </dialog>

  <dialog class="gh-dialog" id="ed-propose-dialog" aria-labelledby="ed-propose-h">
    <form method="dialog" class="gh-dialog-box">
      <header class="gh-dialog-head">
        <h2 id="ed-propose-h">Propose change</h2>
        <IconButton icon={X} label="Close" size="sm" type="submit" value="cancel" />
      </header>
      <p>Bridge creates a <code>tokens/*</code> branch, commits the edited token files with minimal diffs and a changeset, and opens a pull request for design and tech review.</p>
      <Input label="Title" data-ed-field="propose-title" placeholder="tokens: soften the page background" />
      <Textarea label="Why" data-ed-field="propose-notes" rows={3} placeholder="What problem this solves, and where reviewers should look." />
      <p class="small" id="ed-propose-status" role="status" aria-live="polite"></p>
      <footer class="gh-dialog-foot">
        <span class="gh-spacer"></span>
        <Button variant="secondary" size="sm" type="submit" value="cancel">Cancel</Button>
        <Button variant="primary" size="sm" id="ed-propose-go">Open pull request</Button>
      </footer>
    </form>
  </dialog>

  <dialog class="gh-dialog xp-full-editor" id="xp-full-editor" aria-labelledby="xp-full-title">
    <div class="gh-dialog-box">
      <header class="gh-dialog-head">
        <h2 id="xp-full-title" class="mono" data-xp-full-title>Edit token</h2>
        <form method="dialog"><IconButton icon={X} label="Close the full editor" size="sm" type="submit" /></form>
      </header>
      <div data-xp-full-slot></div>
    </div>
  </dialog>

  <GitHubDialog />
  <HistoryPlanner />
</div>
