---
// Token explorer: lens and collection tree, a Figma-like grid with one column per relevant mode, and a detail panel
// with the token flow, contrast and history. Public API: { mode, focus }. Mount it once per page.
//   mode  'read' shows no edit affordances and links to Studio; 'edit' edits cells through the token editor
//         (draft, guardrails, tray, pull request) and brings its own editing kit.
//   focus token path or group to preselect (?focus= or the older ?t= in the URL wins at runtime).
import '../../styles/github.css';
import '../../styles/editor.css';
import '../../styles/reviews.css';
import '../../styles/history.css';
import '../../styles/token-explorer.css';
import Icon from '../Icon.astro';
import SummaryButton from '../ds/studio/SummaryButton';
import { Button, EmptyState, Kbd } from '@bridge-ds/react';
import { Eye, Layers, Plus, Search, SlidersHorizontal } from 'lucide-react';
import TokenEditorKit from './TokenEditorKit.astro';
import ExplorerData from './ExplorerData.astro';
import XpKeys from './XpKeys.astro';
import { CATEGORY_LABEL, CATEGORY_ORDER, SYNTAX_LABEL } from '../../lib/explorer/format';
import { TIER_NAMES, TIER_ORDER } from '@bridge-ds/core';

interface Props {
  mode: 'read' | 'edit';
  focus?: string;
}
const { mode, focus } = Astro.props;
// Studio (mode "edit") renders the explorer as the page itself: full bleed, one compact header, one toolbar row,
// compact rows. The Library (mode "read") keeps its card, heading and inline controls.
const app = mode === 'edit';
---

<div class="xp" data-xp data-mode={mode} data-surface={app ? 'app' : 'page'} data-rows={app ? 'compact' : undefined} data-focus={focus ?? ''}>
  {
    app && (
      <header class="xp-apphead st-head">
        <div class="st-head-main">
          <h1 class="st-title">Tokens</h1>
          <p class="st-sub">
            <span class="xp-crumb" id="xp-title" data-xp-title>Tokens</span>
            <span class="xp-count num" data-xp-count aria-live="polite"></span>
          </p>
        </div>
      </header>
    )
  }
  <aside class="xp-left" aria-label="Browse tokens">
    <div class="xp-lens" role="radiogroup" aria-label="Browse by" data-xp-lens>
      <button type="button" role="radio" aria-checked="true" data-lens="collections">Collections <span class="xp-lens-n" data-lens-n></span></button>
      <button type="button" role="radio" aria-checked="false" tabindex="-1" data-lens="types">By type <span class="xp-lens-n" data-lens-n></span></button>
    </div>
    <nav class="xp-tree" aria-label="Collections and groups" data-xp-tree></nav>
  </aside>

  <section class="xp-main" aria-labelledby="xp-title" data-xp-main>
    <div class="xp-toolbar">
      {
        !app && (
          <div class="xp-heading">
            <h2 class="xp-title" id="xp-title" data-xp-title>Tokens</h2>
            <span class="xp-count num" data-xp-count aria-live="polite"></span>
          </div>
        )
      }
      <div class="xp-tools">
        <div class="xp-search" role="search">
          <Icon name="search" size={16} />
          <label class="sr-only" for="xp-q">Search tokens</label>
          <input id="xp-q" type="search" placeholder="Name, CSS variable or hex" autocomplete="off" spellcheck="false" aria-keyshortcuts="F" data-xp-q />
          <Kbd keys="F" size="sm" className="xp-slash" aria-hidden="true" />
          <button type="button" class="xp-exact" aria-pressed="false" data-xp-exact title="Match the whole name, variable or hex">Exact</button>
        </div>
        <details class="xp-filters" data-xp-filters>
          <SummaryButton variant="secondary" size="sm" iconStart={SlidersHorizontal}>Filters <span class="xp-filter-n num" data-xp-filter-n hidden>0</span></SummaryButton>
          <div class="xp-filters-panel">
            <fieldset>
              <legend>Collection</legend>
              {TIER_ORDER.map((t) => <label><input type="checkbox" name="xp-ft" value={t} />{TIER_NAMES[t]}</label>)}
            </fieldset>
            <fieldset>
              <legend>Type</legend>
              {CATEGORY_ORDER.map((c) => <label><input type="checkbox" name="xp-fc" value={c} />{CATEGORY_LABEL[c]}</label>)}
            </fieldset>
            <fieldset>
              <legend>Usage</legend>
              <label><input type="radio" name="xp-usage" value="" checked />Any</label>
              <label><input type="radio" name="xp-usage" value="used" />In use</label>
              <label><input type="radio" name="xp-usage" value="unused" />Unused</label>
            </fieldset>
            <Button variant="secondary" size="sm" className="st-xp-clear-filters" data-xp-clear-filters>Clear filters</Button>
          </div>
        </details>
        {
          app ? (
            <>
              <details class="xp-menu" data-xp-modes-menu hidden>
                <SummaryButton variant="secondary" size="sm" iconStart={Layers} title="Brand, density and combinations shown in the value columns">
                  <span data-xp-modes-label>Modes</span>
                </SummaryButton>
                <div class="xp-menu-panel">
                  <div class="xp-modebar" data-xp-modebar></div>
                </div>
              </details>
              <details class="xp-menu" data-xp-view-menu>
                <SummaryButton variant="secondary" size="sm" iconStart={Eye} aria-label="View options">View</SummaryButton>
                <div class="xp-menu-panel xp-view-panel">
                  <label class="xp-menu-field">
                    <span>Code column</span>
                    <select data-xp-syntax>
                      {Object.entries(SYNTAX_LABEL).map(([k, v]) => <option value={k}>{v}</option>)}
                    </select>
                  </label>
                  <button type="button" class="xp-switch" role="switch" aria-checked="false" data-xp-desc>
                    <span class="xp-switch-track" aria-hidden="true"><span class="xp-switch-thumb"></span></span>
                    <span>Description column</span>
                  </button>
                  <div class="xp-menu-field">
                    <span id="xp-rows-label">Rows</span>
                    <div class="xp-seg" role="radiogroup" aria-labelledby="xp-rows-label" data-xp-rows>
                      <button type="button" role="radio" aria-checked="true" data-rows="compact">Compact</button>
                      <button type="button" role="radio" aria-checked="false" tabindex="-1" data-rows="comfortable">Comfortable</button>
                    </div>
                  </div>
                  <p class="xp-menu-keys small muted" aria-hidden="true"><XpKeys /></p>
                </div>
              </details>
              <Button variant="primary" size="sm" iconStart={Plus} className="xp-new has-tip" id="ed-add" data-tip="Adds a draft in this browser. No GitHub needed." aria-label="New token">New token</Button>
            </>
          ) : (
            <>
              <div class="xp-modebar" data-xp-modebar hidden></div>
              <div class="xp-view">
                <label class="xp-select"><span class="sr-only">Code syntax</span>
                  <select data-xp-syntax>
                    {Object.entries(SYNTAX_LABEL).map(([k, v]) => <option value={k}>{v}</option>)}
                  </select>
                </label>
                <button type="button" class="btn btn-secondary btn-sm xp-toggle" aria-pressed="false" data-xp-desc>Description</button>
              </div>
            </>
          )
        }
      </div>
    </div>

    <div class="xp-scroll" data-xp-scroll>
      <div class="xp-grid" role="grid" aria-labelledby="xp-title" aria-readonly="true" data-xp-grid></div>
      <EmptyState icon={Search} title="No token matches." description="Try a shorter name, a hex like #1c2735, or clear the filters." className="st-hideable st-xp-empty" data-xp-empty hidden>
        <Fragment slot="actions"><Button variant="secondary" size="sm" data-xp-clear>Clear search and filters</Button></Fragment>
      </EmptyState>
    </div>
    {!app && <p class="xp-keys small muted" aria-hidden="true"><XpKeys /></p>}
  </section>

  <div class="xp-scrim" data-xp-scrim hidden></div>
  <aside class="xp-detail" aria-labelledby="xp-d-title" data-xp-detail hidden></aside>
</div>

<ExplorerData />
{mode === 'edit' && <TokenEditorKit />}

<script>
  import { initTokenExplorer } from '../../scripts/explorer';
  initTokenExplorer();
</script>
