---
// Token explorer: lens and collection tree (Library), a Figma-like grid with one column per relevant mode, and a detail panel
// with the token flow, contrast and history. Public API: { mode, focus }. Mount it once per page.
//   mode  'read' shows no edit affordances and links to Studio; 'edit' edits cells through the token editor
//         (draft, guardrails, tray, pull request) and brings its own editing kit.
//   focus token path or group to preselect (?focus= or the older ?t= in the URL wins at runtime).
import '../../styles/github.css';
import '../../styles/editor.css';
import '../../styles/reviews.css';
import '../../styles/history.css';
import '../../styles/token-explorer.css';
import '../../styles/preview-frames.css';
import Icon from '../Icon.astro';
import SummaryButton from '../ds/studio/SummaryButton';
import ButtonLink from '../ds/ButtonLink';
import { Button, EmptyState, Kbd, SegmentedControl } from '@bridge-ds/react';
import { Plus, Search, SlidersHorizontal } from 'lucide-react';
import TokenEditorKit from './TokenEditorKit.astro';
import ExplorerData from './ExplorerData.astro';
import XpKeys from './XpKeys.astro';
import { CATEGORY_LABEL, CATEGORY_ORDER, STUDIO_TIER_NAMES, SYNTAX_LABEL, modeName } from '../../lib/explorer/format';
import { modesOf } from '../../lib/explorer/model';
import { tokenFiles } from '../../lib/explorer';
import { exists, readText } from '../../lib/repo';
import { TIER_NAMES, TIER_ORDER, buildTokenSet, layoutOptions, loadConfig } from '@bridge-ds/core';
import { Fragment as RFragment, createElement } from 'react';

interface Props {
  mode: 'read' | 'edit';
  focus?: string;
}
const { mode, focus } = Astro.props;
// Studio (mode "edit") renders the explorer as the page itself: a page header, ONE toolbar row (filter field, type
// chips with counts, one Options menu for collections, usage, brand and modes, columns; New token), then the table at
// full width with flat rows. The Library (mode "read") keeps its lens and tree, card, heading and inline controls.
const app = mode === 'edit';
// The brand and density selectors render here, statically, from the same token set the browser builds
// (scripts/explorer/data.ts); the script only shows, hides and selects them.
const modes = modesOf(buildTokenSet(tokenFiles(), layoutOptions(loadConfig(exists('bridge.config.json') ? readText('bridge.config.json') : '{}'))));
const combos = modes.brands.length * modes.themes.length;
// Lens segments carry a count the script fills in.
const lensLabel = (text: string) => createElement(RFragment, null, `${text} `, createElement('span', { className: 'xp-lens-n', 'data-lens-n': '' }));
---

<div class="xp" data-xp data-mode={mode} data-surface={app ? 'app' : 'page'} data-rows={app ? 'compact' : undefined} data-focus={focus ?? ''}>
  {
    app && (
      <header class="xp-apphead">
        <h1 class="st-title">Tokens</h1>
        <p class="xp-apphead-sub">
          <span class="xp-crumb" id="xp-title" data-xp-title>Tokens</span> <span class="xp-apphead-hint">Click a value to change it.</span><span class="sr-only" data-xp-count aria-live="polite"></span>
        </p>
        <div class="xp-scope" data-ed-scope hidden />
        <div class="xp-scope" data-view-banner hidden />
      </header>
    )
  }
  {
    !app && (
      <aside class="xp-left" aria-label="Browse tokens">
        <SegmentedControl
          label="Browse by"
          data-vanilla
          data-xp-lens
          size="md"
          fullWidth
          defaultValue="collections"
          items={[
            { value: 'collections', label: lensLabel('Collections') },
            { value: 'types', label: lensLabel('By type') },
          ]}
        />
        <nav class="xp-tree" aria-label="Collections and groups" data-xp-tree></nav>
      </aside>
    )
  }

  <section class="xp-main" aria-labelledby="xp-title" data-xp-main>
    <div class="xp-toolbar">
      {
        app ? (
          <div class="xp-tools">
            <div class="xp-search" role="search">
              <Icon name="search" size={16} />
              <label class="sr-only" for="xp-q">Filter tokens by name, CSS variable or hex</label>
              <input id="xp-q" type="search" placeholder="Filter tokens" autocomplete="off" spellcheck="false" aria-keyshortcuts="F" data-xp-q />
            </div>
            <div class="xp-chips" role="group" aria-label="Filter by type" data-xp-chips></div>
            <span class="xp-grow" aria-hidden="true"></span>
            <details class="xp-menu xp-options" data-xp-filters>
              <SummaryButton variant="secondary" size="sm" iconStart={SlidersHorizontal} title="Collections, usage, brand and modes, columns">
                Options <span class="xp-filter-n num" data-xp-filter-n hidden>0</span>
              </SummaryButton>
              <div class="xp-menu-panel xp-options-panel">
                <div class="xp-modebar" data-xp-modebar>
                  <div class="xp-menu-field" data-xp-mode-field="brand" hidden>
                    <span aria-hidden="true">Brand</span>
                    <SegmentedControl label="Brand" data-vanilla data-xp-brand size="sm" fullWidth defaultValue={modes.brands[0]} items={modes.brands.map((b) => ({ value: b, label: modeName(b) }))} />
                  </div>
                  <div class="xp-opt-newbrand">
                    <ButtonLink variant="ghost" size="sm" iconStart={Plus} href="/studio/brands/new/" title="Draft a brand in this browser. Proposing it needs GitHub.">New brand</ButtonLink>
                  </div>
                  <div class="xp-menu-field" data-xp-mode-field="density" hidden>
                    <span aria-hidden="true">Density</span>
                    <SegmentedControl label="Density" data-vanilla data-xp-density size="sm" fullWidth defaultValue={modes.densities[0]} items={modes.densities.map((x) => ({ value: x, label: modeName(x) }))} />
                  </div>
                  <button type="button" class="xp-switch" role="switch" aria-checked="false" data-combos hidden>
                    <span class="xp-switch-track" aria-hidden="true"><span class="xp-switch-thumb"></span></span>
                    <span>All {combos} combinations</span>
                  </button>
                </div>
                <label class="xp-menu-field">
                  <span>Code column</span>
                  <select data-xp-syntax>
                    <option value="">Hidden</option>
                    {Object.entries(SYNTAX_LABEL).map(([k, v]) => <option value={k}>{v}</option>)}
                  </select>
                </label>
                <button type="button" class="xp-switch" role="switch" aria-checked="false" data-xp-desc>
                  <span class="xp-switch-track" aria-hidden="true"><span class="xp-switch-thumb"></span></span>
                  <span>Description column</span>
                </button>
                <button type="button" class="xp-switch" role="switch" aria-checked="false" data-xp-exact title="Match the whole name, variable or hex">
                  <span class="xp-switch-track" aria-hidden="true"><span class="xp-switch-thumb"></span></span>
                  <span>Exact match</span>
                </button>
                <details class="xp-opt-adv" data-xp-advanced>
                  <summary><span>Advanced</span><span class="xp-opt-adv-meta">Collections and usage</span><Icon name="chevron" size={14} /></summary>
                  <fieldset class="xp-opt-set">
                    <legend>Collections</legend>
                    {TIER_ORDER.map((t) => <label><input type="checkbox" name="xp-ft" value={t} />{STUDIO_TIER_NAMES[t]}</label>)}
                  </fieldset>
                  <fieldset class="xp-opt-set">
                    <legend>Usage</legend>
                    <label><input type="radio" name="xp-usage" value="" checked />Any</label>
                    <label><input type="radio" name="xp-usage" value="used" />In use</label>
                    <label><input type="radio" name="xp-usage" value="unused" />Unused</label>
                  </fieldset>
                </details>
                <Button variant="secondary" size="sm" className="st-xp-clear-filters" data-xp-clear-filters>Reset options</Button>
                <p class="xp-menu-keys small muted"><XpKeys /></p>
              </div>
            </details>
            <Button variant="primary" size="sm" iconStart={Plus} className="xp-new" id="ed-add" data-tooltip="Adds a draft in this browser. No GitHub needed." aria-label="New token">New token</Button>
          </div>
        ) : (
          <>
            <div class="xp-heading">
              <h2 class="xp-title" id="xp-title" data-xp-title>Tokens</h2>
              <span class="xp-count num" data-xp-count aria-live="polite"></span>
            </div>
            <div class="xp-tools">
              <div class="xp-search" role="search">
                <Icon name="search" size={16} />
                <label class="sr-only" for="xp-q">Search tokens</label>
                <input id="xp-q" type="search" placeholder="Name, CSS variable or hex" autocomplete="off" spellcheck="false" aria-keyshortcuts="F" data-xp-q />
                <Kbd keys="F" size="sm" className="xp-slash" aria-hidden="true" />
                <button type="button" class="xp-exact" aria-pressed="false" data-xp-exact title="Match the whole name, variable or hex">Exact</button>
              </div>
              <details class="xp-filters" data-xp-filters>
                <SummaryButton variant="secondary" size="sm" iconStart={SlidersHorizontal}>Filters <span class="xp-filter-n num" data-xp-filter-n hidden>0</span></SummaryButton>
                <div class="xp-filters-panel">
                  <fieldset>
                    <legend>Collection</legend>
                    {TIER_ORDER.map((t) => <label><input type="checkbox" name="xp-ft" value={t} />{TIER_NAMES[t]}</label>)}
                  </fieldset>
                  <fieldset>
                    <legend>Type</legend>
                    {CATEGORY_ORDER.map((c) => <label><input type="checkbox" name="xp-fc" value={c} />{CATEGORY_LABEL[c]}</label>)}
                  </fieldset>
                  <fieldset>
                    <legend>Usage</legend>
                    <label><input type="radio" name="xp-usage" value="" checked />Any</label>
                    <label><input type="radio" name="xp-usage" value="used" />In use</label>
                    <label><input type="radio" name="xp-usage" value="unused" />Unused</label>
                  </fieldset>
                  <Button variant="secondary" size="sm" className="st-xp-clear-filters" data-xp-clear-filters>Clear filters</Button>
                </div>
              </details>
              <div class="xp-modebar" data-xp-modebar hidden>
                <div data-xp-mode-field="brand" hidden>
                  <SegmentedControl label="Brand" data-vanilla data-xp-brand size="sm" defaultValue={modes.brands[0]} items={modes.brands.map((b) => ({ value: b, label: modeName(b) }))} />
                </div>
                <div data-xp-mode-field="density" hidden>
                  <SegmentedControl label="Density" data-vanilla data-xp-density size="sm" defaultValue={modes.densities[0]} items={modes.densities.map((x) => ({ value: x, label: modeName(x) }))} />
                </div>
                <button type="button" class="xp-switch" role="switch" aria-checked="false" data-combos hidden>
                  <span class="xp-switch-track" aria-hidden="true"><span class="xp-switch-thumb"></span></span>
                  <span>All {combos} combinations</span>
                </button>
              </div>
              <div class="xp-view">
                <label class="xp-select"><span class="sr-only">Code syntax</span>
                  <select data-xp-syntax>
                    {Object.entries(SYNTAX_LABEL).map(([k, v]) => <option value={k}>{v}</option>)}
                  </select>
                </label>
                <button type="button" class="btn btn-secondary btn-sm xp-toggle" aria-pressed="false" data-xp-desc>Description</button>
              </div>
            </div>
          </>
        )
      }
    </div>

    <div class="xp-scroll" data-xp-scroll>
      <div class="xp-grid" role="grid" aria-labelledby="xp-title" aria-readonly="true" data-xp-grid></div>
      <EmptyState icon={Search} title="No token matches." description="Try a shorter name, a hex like #1c2735, or another type or collection." className="st-hideable st-xp-empty" data-xp-empty hidden>
        <Fragment slot="actions"><Button variant="secondary" size="sm" data-xp-clear>Clear search and filters</Button></Fragment>
      </EmptyState>
    </div>
    {!app && <p class="xp-keys small muted" aria-hidden="true"><XpKeys /></p>}
  </section>

  <div class="xp-scrim" data-xp-scrim hidden></div>
  <aside class="xp-detail" aria-labelledby="xp-d-title" data-xp-detail hidden></aside>
</div>

<ExplorerData />
{mode === 'edit' && <TokenEditorKit />}

<script>
  import { initTokenExplorer } from '../../scripts/explorer';
  initTokenExplorer();
</script>
