---
// Keyboard legend of the token explorer: under the grid in the Library, inside the View menu in the Studio.
import { Kbd } from '@bridge-ds/react';
---

<Kbd keys="F" size="sm" /> search tokens <Kbd keys="/" size="sm" /> search the site <Kbd keys="↑" size="sm" /><Kbd keys="↓" size="sm" /><Kbd keys="←" size="sm" /><Kbd keys="→" size="sm" /> move <Kbd keys="Enter" size="sm" /> open <span class="xp-edit-only">or edit</span> <Kbd keys="C" size="sm" /> copy <Kbd keys="Esc" size="sm" /> close
