---
// The single mount point for the token explorer, in the Library (mode "read") and in Studio Tokens (mode "edit").
// Mount it once per page. Mode "edit" brings its own editing kit (tray, dialogs, full editor), so a page never adds
// a second one. Deep links: ?focus=<token path or group> and the older ?t=<token path> both select on load.
import TokenExplorer from './explorer/TokenExplorer.astro';

interface Props {
  mode: 'read' | 'edit';
  /** Token path (or group, like "color.text") to open on load. ?focus= or ?t= in the URL wins. */
  focus?: string;
  /** A team shell: the team's tokens are read in the browser (TokenExplorer hosted). */
  hosted?: boolean;
}

const { mode, focus, hosted } = Astro.props;
---

<TokenExplorer mode={mode} focus={focus} hosted={hosted} />
