---
import { humanDate } from '../lib/stats';
import Icon from './Icon.astro';

interface Props {
  date: string | null;
}
const { date } = Astro.props;
---

<p class="updated" title="From the git history of this page's source files">
  <Icon name="clock" size={14} />
  <span>Updated {humanDate(date)}</span>
</p>
