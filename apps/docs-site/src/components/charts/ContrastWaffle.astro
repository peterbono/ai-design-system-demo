---
// One square per contrast check (pair x brand x theme). Failing squares are filled and carry an x mark,
// so pass and fail differ by shape as well as color.
import { dashboard } from '../../lib/stats';
import { BRAND_LABEL } from '../../lib/tokens';

const { contrast } = dashboard();
const pct = Math.round(contrast.rate * 1000) / 10;
---

<figure class="waffle">
  <div class="waffle-score">
    <strong class="display num">{pct}%</strong>
    <span>of {contrast.total} checks pass WCAG AA</span>
  </div>
  {
    contrast.byCombo.map((checks) => {
      const m = checks.mode;
      const label = `${BRAND_LABEL[checks.brand]} ${m}`;
      return (
        <div class="waffle-row">
          <span class="waffle-mode">{label}</span>
          <ul class="waffle-grid" aria-label={`${label}: ${checks.pass} of ${checks.total} pass`}>
            {contrast.failing
              .filter((f) => f.mode === m && f.brand === checks.brand)
              .map((f) => (
                <li class="cell is-fail" title={`${f.pair.fg} on ${f.pair.bg}: ${f.result.ratio.toFixed(2)}:1, fails AA`}>
                  <span class="sr-only">
                    Fails: {f.pair.fg} on {f.pair.bg}, {f.result.ratio.toFixed(2)}:1
                  </span>
                </li>
              ))}
            {Array.from({ length: checks.pass }, () => (
              <li class="cell" aria-hidden="true" />
            ))}
          </ul>
          <span class="waffle-count num">
            {checks.pass}/{checks.total}
          </span>
        </div>
      );
    })
  }
  <figcaption class="waffle-key">
    <span><span class="cell" aria-hidden="true"></span> passes AA</span>
    <span><span class="cell is-fail" aria-hidden="true"></span> fails AA</span>
    <span class="num">{contrast.aaa} also reach AAA</span>
  </figcaption>
</figure>
