---
// Horizontal stacked bars: tokens per category, split by layer. Widths are relative to the largest category.
interface Row {
  key: string;
  label: string;
  primitive: number;
  semantic: number;
}
interface Props {
  rows: Row[];
}
const { rows } = Astro.props;
const max = Math.max(...rows.map((r) => r.primitive + r.semantic), 1);
const w = (n: number) => `${(n / max) * 100}%`;
---

<figure class="stacked">
  <ul class="legend legend-inline" aria-hidden="true">
    <li><span class="legend-key data-2"></span>Primitive</li>
    <li><span class="legend-key data-1"></span>Semantic</li>
  </ul>
  <table class="stacked-table">
    <caption class="sr-only">Tokens per category, primitive and semantic</caption>
    <thead class="sr-only">
      <tr><th scope="col">Category</th><th scope="col">Primitive</th><th scope="col">Semantic</th><th scope="col">Total</th></tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            <td class="stacked-bar" colspan="2">
              <span class="stacked-track">
                {r.primitive > 0 && (
                  <span class="seg data-2" style={`width: ${w(r.primitive)}`} title={`${r.primitive} primitive`}>
                    <span class="sr-only">{r.primitive} primitive</span>
                  </span>
                )}
                {r.semantic > 0 && (
                  <span class="seg data-1" style={`width: ${w(r.semantic)}`} title={`${r.semantic} semantic`}>
                    <span class="sr-only">{r.semantic} semantic</span>
                  </span>
                )}
              </span>
            </td>
            <td class="stacked-total num">
              {r.primitive + r.semantic}
              <span class="muted">
                {r.primitive}/{r.semantic}
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</figure>
