---
// The owner override confirmation, one copy for every page that lists or reviews branches (self-hosted and team
// Branches and Review). scripts/reviews.ts wireOverride fills the branch number and the skipped approvals, then opens
// it; without this dialog on the page the "Merge with owner override" item has nothing to open. The DS Dialog for
// plain scripts: focus trap, Escape, scrim.
import ScriptDialog from './ds/ScriptDialog.astro';
import { Alert, Button, ButtonGroup, Textarea } from '@bridge-ds/react';
---

<ScriptDialog id="rv-ov" title="Add to the library as owner override?" closeLabel="Close" disablePointerDismissal popup={{ role: 'alertdialog', 'aria-describedby': 'rv-ov-desc' }}>
  <div class="gh-dialog-body">
    <div id="rv-ov-desc" class="rv-ov-desc">
      <p>This adds the change to the library without:</p>
      <ul class="rv-ov-missing" data-rv-ov="missing"></ul>
      <p>Your reason is posted on the change and shown in History.</p>
    </div>
    <Textarea label="Reason" data-rv-ov="reason" rows={3} hint="Shown on the change." placeholder="Solo maintainer, tests pass, I reviewed the token diff and contrast." />
    <Alert tone="danger" className="st-hideable" data-rv-ov="error" hidden><span data-rv-ov="error-text"></span></Alert>
  </div>
  <Fragment slot="footer">
    <ButtonGroup align="end">
      <Button variant="secondary" data-dialog-close>Cancel</Button>
      <Button variant="primary" data-rv-ov="go">Post reason and add to the library</Button>
    </ButtonGroup>
  </Fragment>
</ScriptDialog>
