---
// "Viewing: Latest library" in the Studio top bar, on the pages that can show a change (lib/nav branchAware: Tokens,
// Components, Quality). The DS Select island lists the open changes (scripts/view-change.ts fills it); picking one
// shows the page as that change (?change=N, lib/view-scope). The inline script marks the document before the page
// paints, so a page never flashes latest library numbers while it shows a change (html[data-view-change]).
import '../styles/view-change.css';
import ViewingSelect from './ds/studio/ViewingSelect';
---

<script is:inline>
  (function () {
    var m = /[?&]change=(\d+)(?:&|$)/.exec(location.search);
    if (!m) return;
    var root = document.documentElement;
    root.setAttribute('data-view-change', m[1]);
    if (/[?&]edit=1(?:&|$)/.test(location.search) && /^\/studio\/tokens\/?$/.test(location.pathname)) root.setAttribute('data-view-edit', '');
  })();
</script>
<div class="view-pick-wrap" data-view-pick>
  <ViewingSelect client:load />
</div>
