---
import '@bridge-ds/tokens/fonts.css';
import '@bridge-ds/tokens/tokens.css';
import '../styles/site.css';
import '../styles/github.css';
import '../styles/spaces.css';
import '../styles/studio-app.css';
import '../styles/ds-library.css';
import '../styles/ds-studio.css';
import '../styles/brand.css';
import GitHubAccount from '../components/GitHubAccount.astro';
import GitHubDialog from '../components/GitHubDialog.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import ViewAsChange from '../components/ViewAsChange.astro';
import { LIBRARY_HOME, SPACE_LABEL, STUDIO_HOME, locate, navFor, type Space } from '../lib/nav';
import { siteRepoJson } from '../lib/config';
import { GITHUB_URL, STORYBOOK_URL, sourceUrl } from '../lib/repo';
import { humanDate } from '../lib/stats';
import { BRANDS, DEFAULT_BRAND } from '../lib/tokens';
import { Breadcrumb, Button, IconButton, Kbd } from '@bridge-ds/react';
import { BookOpen, Menu as MenuIcon, Moon, Search, X } from 'lucide-react';
import ButtonLink from '../components/ds/ButtonLink';
import { GitHubMark } from '../components/ds/studio/brand-icons';

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  /** Repo-relative files that feed this page. */
  sources?: readonly string[];
  updated?: string | null;
  /** Full-bleed pages (dashboard, explorer) manage their own width. */
  wide?: boolean;
  /** Breadcrumb trail after the space and group. Defaults to the nav entry, then the page title. */
  crumbs?: Crumb[] | false;
  /** Right "On this page" rail, built from the page's h2 headings. Default: on for Library reading pages. */
  toc?: boolean;
}

const { title, description, sources = [], updated, wide = false, crumbs, toc } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const here = locate(path);
const space: Space = here.space;
const nav = navFor(space);
const isStudio = space === 'studio';
const isHome = path === LIBRARY_HOME || path === STUDIO_HOME;
// Tokens, Components and Quality can show the library as an open change (lib/view-scope): the selector and the banner.
const viewAware = isStudio && Boolean(here.item?.branchAware) && here.item?.href === path;
// Library reading pages get the right "On this page" rail: it only shows from 1320px, where the column beside the
// 960px reading width is otherwise empty, and only with two sections or more. Studio and wide pages opt in.
const showToc = toc ?? (!isStudio && !wide && !isHome);
const isCurrent = (href: string) => path === href;

// Breadcrumb only below the side nav's depth (a component page): the Harbor header and the nav say the rest.
const nested = !!here.item && here.item.href !== path;
const trail: Crumb[] = crumbs || (nested && here.item ? [{ label: here.item.label, href: here.item.href }, { label: title }] : []);
const showCrumbs = crumbs !== false && !isStudio && trail.length > 1;
const crumbItems = trail.map((c, i) => (c.href && i < trail.length - 1 ? { label: c.label, href: c.href } : { label: c.label }));
// Page sources for "View source": real files only; "git log" is said in the popover title instead.
const files = sources.filter((s) => s !== 'git log');
const logged = sources.includes('git log');
const searchLabel = isStudio ? 'Search tokens, components, changes' : 'Search tokens, components, pages';
const pageTitle = title === 'Home' ? 'Bridge: your design system, one source of truth' : `${title} | ${SPACE_LABEL[space] === 'Library' ? 'Bridge' : `Bridge ${SPACE_LABEL[space]}`}`;
---

<!doctype html>
<html lang="en" data-theme="light" data-brand="bridge" data-density="comfortable" data-space={space} data-brands={[DEFAULT_BRAND, ...BRANDS.filter((b) => b !== DEFAULT_BRAND)].join(' ')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="author" content="Florian Gouloubi" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1825" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('ds-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
        var b = null, d = null;
        try { b = localStorage.getItem('ds-brand'); d = localStorage.getItem('ds-density'); } catch (e) {}
        // The chrome stays on the bridge brand and comfortable density (attributes above); the picked brand and
        // density only reach the design system previews (scripts/shell.ts copies them onto every data-theme scope).
        var brands = (document.documentElement.getAttribute('data-brands') || 'bridge').split(' ');
        document.documentElement.setAttribute('data-preview-brand', b && brands.indexOf(b) >= 0 ? b : brands[0]);
        document.documentElement.setAttribute('data-preview-density', d === 'compact' ? 'compact' : 'comfortable');
        // Maintainer tools (Edit in Studio, View source, the avatar next to Open Studio) paint before first render
        // from the last check of this browser's GitHub token; scripts/maintainer.ts checks it again.
        try {
          var tk = localStorage.getItem('bridge.github.token');
          var m = JSON.parse(localStorage.getItem('bridge.gh.maintainer') || 'null');
          if (tk && m && m.key === tk.slice(-6)) {
            document.documentElement.setAttribute('data-signed-in', '');
            if (m.write) document.documentElement.setAttribute('data-maintainer', '');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <a class="topbar-brand" href={isStudio ? STUDIO_HOME : LIBRARY_HOME} aria-label={isStudio ? 'Bridge Studio, overview' : 'Bridge, home'}>
        <Logo />
        {isStudio && <span class="topbar-space" aria-hidden="true">Studio</span>}
      </a>
      <Button variant="ghost" iconStart={Search} className="shell-search" id="search-open" aria-haspopup="dialog" aria-controls="palette" aria-label={searchLabel}>
        <span class="shell-search-text">
          <span class="shell-search-label">{searchLabel}</span>
        </span>
      </Button>
      <div class="topbar-actions">
        {viewAware && <ViewAsChange />}
        {/* Same place in the Library and in Studio, so people find it in both. */}
        <IconButton icon={Moon} label="Dark theme" id="theme-toggle" data-theme-toggle aria-pressed="false" title="Dark theme" className="shell-wide" />
        {
          isStudio ? (
            <>
              <ButtonLink variant="secondary" size="sm" className="team-open lib-open" href={LIBRARY_HOME} iconStart={BookOpen} aria-label="View published library" title="View published library">
                <span class="hd-label">Library</span>
              </ButtonLink>
            </>
          ) : (
            <>
              <div class="team shell-wide" data-team>
                <ButtonLink variant="secondary" size="sm" className="team-open" href={STUDIO_HOME}>Open Studio</ButtonLink>
                <a class="team-avatar" href={STUDIO_HOME} data-team-avatar hidden>
                  <img alt="" width="28" height="28" data-team-avatar-img />
                  <span class="sr-only" data-team-avatar-label>Your Studio</span>
                </a>
              </div>
            </>
          )
        }
        <span class="rail-toggle-slot"><IconButton icon={MenuIcon} label="Open navigation" id="rail-toggle" aria-controls="rail" aria-expanded="false" /></span>
      </div>
    </header>

    <div class="shell">
      <nav class="rail" id="rail" aria-label={isStudio ? 'Studio navigation' : 'Library navigation'}>
        <div class="rail-head">
          <Logo />
          <IconButton icon={X} label="Close navigation" id="rail-close" />
        </div>
        <ul class="nav">
          {
            nav.map((entry, n) => {
              if (entry.href) {
                const current = isCurrent(entry.href);
                const inside = !current && here.entry?.label === entry.label;
                return (
                  <li>
                    <a class="nav-link" href={entry.href} aria-current={current ? 'page' : undefined} data-active={inside || undefined} data-keep-branch={isStudio || undefined}>
                      <Icon name={entry.icon} size={20} />
                      <span>{entry.label}</span>
                      {entry.badge && (
                        <span class="rail-num" data-nav-count={entry.badge} hidden>
                          <span class="sr-only">, </span>
                          <span data-nav-count-value></span>
                          <span class="sr-only"> waiting for a review</span>
                        </span>
                      )}
                    </a>
                  </li>
                );
              }
              const open = here.entry?.label === entry.label;
              const id = `nav-group-${n}`;
              return (
                <li class="nav-group">
                  <!-- bridge-audit-ignore-next-line: a side nav group opener styled as its sibling nav links (with the review count badge and chevron); the DS SidebarNav is a React island and would rebuild the whole rail -->
                  <button type="button" class="nav-link nav-toggle" aria-expanded={open ? 'true' : 'false'} aria-controls={id} data-nav-group data-active={open || undefined}>
                    <Icon name={entry.icon} size={20} />
                    <span>{entry.label}</span>
                    {entry.badge && (
                      <span class="rail-num" data-nav-count={entry.badge} hidden>
                        <span class="sr-only">, </span>
                        <span data-nav-count-value></span>
                        <span class="sr-only"> waiting for a review</span>
                      </span>
                    )}
                    <span class="nav-chev" aria-hidden="true"><Icon name="chevron" size={16} /></span>
                  </button>
                  <ul class="nav-sub" id={id} hidden={!open}>
                    {entry.children!.map((item) => (
                      <li class:list={[{ 'nav-apart': item.apart }]}>
                        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} data-keep-branch={isStudio || undefined}>
                          <span>{item.label}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              );
            })
          }
        </ul>
        <div class="rail-foot">
          <div class="rail-tools">
            <Button variant="ghost" iconStart={Moon} data-theme-toggle aria-pressed="false" aria-label="Dark theme">Theme</Button>
            {!isStudio && <ButtonLink variant="ghost" iconStart={GitHubMark} href={GITHUB_URL}>GitHub</ButtonLink>}
          </div>
          {
            isStudio ? (
              <GitHubAccount />
            ) : (
              <div class="rail-team">
                <p>Maintaining Bridge? Edit tokens and review changes.</p>
                <ButtonLink variant="secondary" href={STUDIO_HOME}>Open Studio</ButtonLink>
              </div>
            )
          }
        </div>
      </nav>
      <div class="scrim" id="scrim" hidden></div>

      <main id="main" tabindex="-1" class:list={[{ wide, 'has-toc': showToc }]}>
        {
          showCrumbs && (
            <Breadcrumb items={crumbItems} className="shell-crumbs" />
          )
        }
        {
          showToc ? (
            <div class="page-grid">
              <div class="page-body">
                <slot />
              </div>
              <aside class="page-toc" aria-label="On this page" data-auto-toc hidden>
                <p class="page-toc-title">On this page</p>
                <ul></ul>
              </aside>
            </div>
          ) : (
            <slot />
          )
        }
        <div class="page-end">
          <div class="page-meta">
            <Icon name="clock" size={16} />
            <span title="From the git history of this page's source files">Updated {humanDate(updated ?? null)}</span>
            {
              files.length > 0 && (
                <details class="menu page-source" data-menu data-maintainer-only={!isStudio || undefined}>
                  <summary class="page-source-trigger">
                    <Icon name="code" size={16} />
                    <span>View source</span>
                  </summary>
                  <div class="menu-panel page-source-panel" role="group" aria-label="Source files">
                    <p class="menu-title">Generated from {files.length === 1 ? '1 file' : `${files.length} files`}{logged ? ' and the git log' : ''}</p>
                    <ul class="page-source-list">
                      {files.map((s) => (
                        <li>
                          <a class="menu-item" href={sourceUrl(s)} title={s}>
                            <span class="mono">{s}</span>
                            <Icon name="out" size={16} />
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </details>
              )
            }
          </div>
          {
            !isStudio && (
              <footer class="site-footer">
                <div class="site-footer-brand">
                  <Logo />
                  <p>Free and open source design system, MIT</p>
                </div>
                <nav class="site-footer-links" aria-label="Footer">
                  <a href={GITHUB_URL}>GitHub<span>Source and issues</span></a>
                  <a href="/llms.txt">For AI agents<span class="mono">llms.txt</span></a>
                  <a href={STORYBOOK_URL}>Contribute<span>Storybook workbench</span></a>
                </nav>
              </footer>
            )
          }
        </div>
      </main>
    </div>

    <!-- bridge-audit-ignore-next-line: search palette, a native modal <dialog> opened by a plain script (showModal, focus trap, Escape); the DS Dialog is a React island, so moving it is a rewrite of the script. Follow-up: DS Dialog with a static open/close contract -->
    <dialog class="palette" id="palette" aria-label="Search">
      <form method="dialog" class="palette-box" role="search">
        <div class="palette-input">
          <Icon name="search" />
          <!-- bridge-audit-ignore-next-line: the palette field is a borderless combobox header driven by scripts/shell.ts (listbox, arrow keys); a DS Input would draw a field box inside the palette. Follow-up: DS Combobox or command palette -->
          <input
            id="palette-q"
            type="search"
            placeholder="Search tokens, components, pages, or paste a hex"
            autocomplete="off"
            spellcheck="false"
            role="combobox"
            aria-expanded="true"
            aria-controls="palette-list"
            aria-autocomplete="list"
            aria-label="Search"
          />
          <Kbd keys="Esc" size="sm" />
        </div>
        <ul id="palette-list" class="palette-list" role="listbox" aria-label="Results"></ul>
        <p class="palette-foot">
          <span><Kbd keys="↑" size="sm" /> <Kbd keys="↓" size="sm" /> to move</span>
          <span><Kbd keys="↵" size="sm" /> to open</span>
          <span id="palette-count" aria-live="polite"></span>
        </p>
      </form>
    </dialog>

    {isStudio && <GitHubDialog />}
    <p class="sr-only" role="status" aria-live="polite" id="live"></p>
    <script type="application/json" id="bridge-repo" set:html={siteRepoJson()} />
    <script>
      import { initShell } from '../scripts/shell';
      initShell();
    </script>
  </body>
</html>
