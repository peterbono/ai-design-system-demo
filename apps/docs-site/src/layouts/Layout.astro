---
import '@bridge-ds/tokens/fonts.css';
import '@bridge-ds/tokens/tokens.css';
import '../styles/site.css';
import '../styles/github.css';
import '../styles/spaces.css';
import '../styles/studio-app.css';
import { brandCss } from '../brand/tokens';
import GitHubAccount from '../components/GitHubAccount.astro';
import GitHubDialog from '../components/GitHubDialog.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { LIBRARY_HOME, SETTINGS_HOME, SPACE_LABEL, STUDIO_HOME, locate, navFor, type Space } from '../lib/nav';
import { siteRepoJson } from '../lib/config';
import { versionInfo } from '../lib/changelog';
import { BRANDS, BRAND_LABEL, DENSITIES, DENSITY_LABEL } from '../lib/tokens';
import { GITHUB_URL, STORYBOOK_URL, sourceUrl } from '../lib/repo';
import { humanDate, repoStatus } from '../lib/stats';

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  /** Repo-relative files that feed this page. */
  sources?: readonly string[];
  updated?: string | null;
  /** Full-bleed pages (dashboard, explorer) manage their own width. */
  wide?: boolean;
  /** Breadcrumb trail after the space and group. Defaults to the nav entry, then the page title. */
  crumbs?: Crumb[] | false;
  /** Right "On this page" rail, built from the page's h2 headings. Default: on for Library reading pages. */
  toc?: boolean;
}

const { title, description, sources = [], updated, wide = false, crumbs, toc } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const here = locate(path);
const space: Space = here.space;
const nav = navFor(space);
const repo = repoStatus();
const version = versionInfo();
const isStudio = space !== 'library';
const isHome = path === LIBRARY_HOME || path === STUDIO_HOME;
const showToc = toc ?? (space === 'library' && !wide && !isHome);
const isCurrent = (href: string) => path === href;
const inSection = (href: string) => href !== LIBRARY_HOME && href !== STUDIO_HOME && href !== SETTINGS_HOME && href !== '/components/' && path !== href && path.startsWith(href);
const spaceHome = space === 'library' ? LIBRARY_HOME : space === 'studio' ? STUDIO_HOME : SETTINGS_HOME;

// Breadcrumb: Space / Group / Page (/ Sub-page). Hidden on the two home pages.
const trail: Crumb[] = [{ label: SPACE_LABEL[space], href: spaceHome }];
// Settings has a single group: the space name already says it.
if (here.group && space !== 'settings') trail.push({ label: here.group });
if (crumbs) trail.push(...crumbs);
else if (here.item && here.item.href !== spaceHome) {
  trail.push(here.item.href === path ? { label: here.item.label } : { label: here.item.label, href: here.item.href }, ...(here.item.href === path ? [] : [{ label: title }]));
} else if (path !== spaceHome || space === 'settings') trail.push({ label: title });
// The Studio is an app: its compact page headers say where you are, so no breadcrumb there.
const showCrumbs = crumbs !== false && !isHome && !isStudio;
const pageTitle = title === 'Home' ? 'Bridge: your design system, one source of truth' : `${title} | ${SPACE_LABEL[space] === 'Library' ? 'Bridge' : `Bridge ${SPACE_LABEL[space]}`}`;
---

<!doctype html>
<html lang="en" data-theme="light" data-space={space}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="author" content="Florian Gouloubi" />
    <meta name="theme-color" content="#f2f3f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f141c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <style is:inline set:html={brandCss()}></style>
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('ds-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
        var b = null, d = null;
        try { b = localStorage.getItem('ds-brand'); d = localStorage.getItem('ds-density'); } catch (e) {}
        document.documentElement.setAttribute('data-brand', b === 'ocean' ? 'ocean' : 'bridge');
        document.documentElement.setAttribute('data-density', d === 'compact' ? 'compact' : 'comfortable');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <button type="button" class="icon-btn rail-toggle" id="rail-toggle" aria-controls="rail" aria-expanded="false" aria-label="Open navigation">
        <Icon name="menu" />
      </button>
      <a class="topbar-brand" href={LIBRARY_HOME} aria-label="Bridge Library, home"><Logo /></a>

      {
        space === 'settings' ? (
          <a class="back-link" href={STUDIO_HOME} data-keep-branch>
            <span class="back-icon" aria-hidden="true"><Icon name="chevron" size={14} /></span>
            Back to Studio
          </a>
        ) : (
          <nav class="space-switch topbar-switch" aria-label="Space">
            <a href={LIBRARY_HOME} aria-current={space === 'library' ? 'page' : undefined}>Library</a>
            <a href={STUDIO_HOME} aria-current={space === 'studio' ? 'page' : undefined} data-keep-branch>Studio</a>
          </nav>
        )
      }

      {
        space === 'library' ? (
          <details class="menu scope-pick" data-menu id="version-menu">
            <summary class="scope-pick-trigger" aria-label={`Library version ${version.current}. Change version`} title={`Built from ${repo.branch} at ${repo.sha}, ${humanDate(repo.lastChange)}`}>
              <Icon name="tag" size={14} />
              <span class="mono">{version.current}</span>
              <span class="scope-pick-chev" aria-hidden="true"><Icon name="chevron" size={12} /></span>
            </summary>
            <div class="menu-panel" role="group" aria-label="Versions">
              <p class="menu-title">Version</p>
              <ul class="menu-list">
                <li>
                  <span class="menu-item is-current" aria-current="true">
                    <span class="mono">{version.current}</span>
                    <span class="menu-note">Latest, built from {repo.branch} at <span class="mono">{repo.sha}</span></span>
                    <Icon name="check" size={14} />
                  </span>
                </li>
                {version.past.map((r) => (
                  <li>
                    <span class="menu-item is-disabled" aria-disabled="true" title="Archived docs for past versions are coming soon">
                      <span class="mono">{r.name}</span>
                      <span class="menu-note">Archived docs coming soon</span>
                    </span>
                  </li>
                ))}
              </ul>
              {version.past.length === 0 && <p class="menu-help">No earlier release is tagged yet. Archived docs for past versions are coming soon.</p>}
              <a class="menu-foot" href="/changelog/">
                Release notes{version.pending > 0 && <span class="muted"> and {version.pending} unreleased changes</span>}
              </a>
            </div>
          </details>
        ) : (
          <details class="menu scope-pick" data-menu id="branch-menu">
            <summary class="scope-pick-trigger" aria-label="Branch: main. Change branch" title="Branch this Studio view reads">
              <Icon name="merge" size={14} />
              <span class="mono" data-branch-label>main</span>
              <span class="scope-pick-chev" aria-hidden="true"><Icon name="chevron" size={12} /></span>
            </summary>
            <div class="menu-panel" role="group" aria-label="Branches">
              <p class="menu-title">Branch</p>
              <ul class="menu-list" data-branch-list aria-busy="true">
                <li>
                  <a class="menu-item" href="?" data-branch="">
                    <span class="mono">main</span>
                    <span class="menu-note">Default branch</span>
                  </a>
                </li>
              </ul>
              <p class="menu-help" data-branch-note>
                {here.item?.branchAware ? 'This page reads the branch you pick.' : 'This page reads main. Branch views for it are coming soon; Reviews and Visual impact follow the branch you pick.'}
              </p>
              <a class="menu-foot" href="/studio/branches/" data-keep-branch>All branches and previews</a>
            </div>
          </details>
        )
      }

      <button type="button" class="search-trigger" id="search-open" aria-haspopup="dialog" aria-controls="palette">
        <Icon name="search" size={18} />
        <span class="search-label">Search tokens, components, pages</span>
        <kbd class="kbd" aria-hidden="true">⌘K</kbd>
      </button>
      <div class="topbar-actions">
        {
          isStudio && (
            <div class="topbar-studio">
              <a class="hd-btn hd-drafts" href="/studio/drafts/" data-keep-branch data-drafts-open data-count="0" aria-label="Drafts" title="Token edits waiting in this browser">
                <Icon name="draft" size={16} />
                <span class="hd-label">Drafts</span>
                <span class="hd-n" data-nav-count-value-hd>0</span>
              </a>
              <GitHubAccount />
            </div>
          )
        }
        <a class="icon-btn" href={STORYBOOK_URL} aria-label="Component workbench (Storybook)" title="Component workbench (Storybook), for contributors"><Icon name="storybook" /></a>
        <a class="icon-btn" href={GITHUB_URL} aria-label="View the repository on GitHub" title="GitHub"><Icon name="github" /></a>
        <details class="scope-menu" id="scope-menu">
          <summary class="scope-trigger" aria-label="Design system preview: brand and density" title="Brand and density of the design system previews">
            <span class="scope-swatch" aria-hidden="true"></span>
            <span class="scope-label"><span data-scope-label="brand">Bridge</span><span class="scope-dot" aria-hidden="true"></span><span data-scope-label="density">Comfortable</span></span>
            <Icon name="chevron" size={14} />
          </summary>
          <div class="scope-panel">
            <p class="scope-title">Previews use</p>
            <p class="scope-help">Applies to every design system preview on the site. The Bridge app chrome stays the same.</p>
            <p class="scope-group-label" id="scope-brand-label">Brand</p>
            <div class="scope-seg" role="radiogroup" aria-labelledby="scope-brand-label">
              {BRANDS.map((b) => (
                <button type="button" role="radio" aria-checked={b === 'bridge' ? 'true' : 'false'} data-set-brand={b}>
                  <span class="scope-chip" data-theme="light" data-brand={b} data-scope-fixed aria-hidden="true"></span>{BRAND_LABEL[b]}
                </button>
              ))}
            </div>
            <p class="scope-group-label" id="scope-density-label">Density</p>
            <div class="scope-seg" role="radiogroup" aria-labelledby="scope-density-label">
              {DENSITIES.map((d) => (
                <button type="button" role="radio" aria-checked={d === 'comfortable' ? 'true' : 'false'} data-set-density={d}>{DENSITY_LABEL[d]}</button>
              ))}
            </div>
          </div>
        </details>
        <button type="button" class="icon-btn theme-toggle" id="theme-toggle" aria-label="Dark theme" aria-pressed="false" title="Toggle dark theme">
          <span class="when-light"><Icon name="moon" /></span>
          <span class="when-dark"><Icon name="sun" /></span>
        </button>
      </div>
    </header>

    <div class="shell">
      <nav class="rail" id="rail" aria-label={`${SPACE_LABEL[space]} navigation`}>
        <div class="rail-head">
          <Logo />
          <button type="button" class="icon-btn" id="rail-close" aria-label="Close navigation"><Icon name="close" /></button>
        </div>
        {
          space === 'settings' ? (
            <a class="back-link rail-back" href={STUDIO_HOME} data-keep-branch>
              <span class="back-icon" aria-hidden="true"><Icon name="chevron" size={14} /></span>
              Back to Studio
            </a>
          ) : (
            <nav class="space-switch rail-switch" aria-label="Space">
              <a href={LIBRARY_HOME} aria-current={space === 'library' ? 'page' : undefined}>Library</a>
              <a href={STUDIO_HOME} aria-current={space === 'studio' ? 'page' : undefined} data-keep-branch>Studio</a>
            </nav>
          )
        }
        {
          nav.map((section) => (
            <div class="rail-section">
              {section.label && <p class="rail-label">{section.label}</p>}
              <ul>
                {section.items.map((item) => (
                  <li>
                    <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} data-active={inSection(item.href) || undefined} data-keep-branch={isStudio || undefined}>
                      {item.icon && <Icon name={item.icon} size={18} />}
                      <span>{item.label}</span>
                      {item.count && (
                        <span class="rail-num" data-nav-count={item.count} hidden>
                          <span class="sr-only">, </span>
                          <span data-nav-count-value></span>
                          <span class="sr-only">{item.count === 'drafts' ? ' draft changes' : ' open'}</span>
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
              {section.families?.map((g) => (
                <details class="rail-group" open={g.items.some((item) => isCurrent(item.href)) || undefined}>
                  <summary class="rail-sublabel">
                    <span>{g.label}</span>
                    <span class="rail-count num">{g.items.length}</span>
                  </summary>
                  <ul class="rail-sub">
                    {g.items.map((item) => (
                      <li>
                        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                          <span>{item.label}</span>
                          {item.badge && <span class="rail-badge">{item.badge}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ))}
            </div>
          ))
        }
        <div class="rail-foot">
          {
            space === 'studio' && (
              <a href={SETTINGS_HOME} class="rail-settings" data-keep-branch>
                <Icon name="settings" size={18} /> <span>Settings</span>
              </a>
            )
          }
          <a href="/llms.txt" class="rail-foot-link"><Icon name="file" size={16} /> llms.txt</a>
          <p>Bridge by Florian Gouloubi. Free and open source.</p>
        </div>
      </nav>
      <div class="scrim" id="scrim" hidden></div>

      <main id="main" tabindex="-1" class:list={[{ wide, 'has-toc': showToc }]}>
        {
          showCrumbs && (
            <nav class="crumbs" aria-label="Breadcrumb">
              <ol>
                {trail.map((c, i) => (
                  <li>
                    {c.href && i < trail.length - 1 ? (
                      <a href={c.href} data-keep-branch={isStudio || undefined}>{c.label}</a>
                    ) : (
                      <span aria-current={i === trail.length - 1 ? 'page' : undefined}>{c.label}</span>
                    )}
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        {
          showToc ? (
            <div class="page-grid">
              <div class="page-body">
                <slot />
              </div>
              <aside class="page-toc" aria-label="On this page" data-auto-toc hidden>
                <p class="page-toc-title">On this page</p>
                <ul></ul>
              </aside>
            </div>
          ) : (
            <slot />
          )
        }
        <footer class="page-footer">
          <p>
            <Icon name="clock" size={16} />
            <span>
              Updated <strong>{humanDate(updated ?? null)}</strong>, from the latest commit touching this page's sources.
              {
                sources.length > 0 && (
                  <>
                    {' '}Generated from{' '}
                    {sources.slice(0, 3).map((s, i) => (
                      <>
                        {i > 0 && ', '}
                        {s === 'git log' ? <code>git log</code> : <a href={sourceUrl(s)}><code>{s}</code></a>}
                      </>
                    ))}
                    {sources.length > 3 ? (
                      <details class="footer-more">
                        <summary>and {sources.length - 3} more files</summary>
                        <ul>
                          {sources.slice(3).map((s) => (
                            <li>{s === 'git log' ? <code>git log</code> : <a href={sourceUrl(s)}><code>{s}</code></a>}</li>
                          ))}
                        </ul>
                      </details>
                    ) : (
                      '.'
                    )}
                  </>
                )
              }
            </span>
          </p>
        </footer>
      </main>
    </div>

    <dialog class="palette" id="palette" aria-label="Search">
      <form method="dialog" class="palette-box" role="search">
        <div class="palette-input">
          <Icon name="search" />
          <input
            id="palette-q"
            type="search"
            placeholder="Search tokens, components, pages, or paste a hex"
            autocomplete="off"
            spellcheck="false"
            role="combobox"
            aria-expanded="true"
            aria-controls="palette-list"
            aria-autocomplete="list"
            aria-label="Search"
          />
          <kbd class="kbd">esc</kbd>
        </div>
        <ul id="palette-list" class="palette-list" role="listbox" aria-label="Results"></ul>
        <p class="palette-foot">
          <span><kbd class="kbd">↑</kbd><kbd class="kbd">↓</kbd> to move</span>
          <span><kbd class="kbd">enter</kbd> to open</span>
          <span id="palette-count" aria-live="polite"></span>
        </p>
      </form>
    </dialog>

    {isStudio && <GitHubDialog />}
    <p class="sr-only" role="status" aria-live="polite" id="live"></p>
    <script type="application/json" id="bridge-repo" set:html={siteRepoJson()} />
    <script>
      import { initShell } from '../scripts/shell';
      initShell();
    </script>
  </body>
</html>
