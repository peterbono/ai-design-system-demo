---
// The product pages outside the Library and the Studio: the landing ("/") and the comparison ("/compare/").
// Their own light header (logo, Studio, Docs, GitHub, theme) and footer; no side nav, no search. Same tokens, fonts and
// theme memory as the app (localStorage ds-theme), so a visitor keeps their theme when they move on to the docs.
import '@bridge-ds/tokens/fonts.css';
import '@bridge-ds/tokens/tokens.css';
import '../styles/site.css';
import '../styles/brand.css';
import '../styles/landing.css';
import Logo from '../components/Logo.astro';
import { IconButton, Link } from '@bridge-ds/react';
import { Moon } from 'lucide-react';
import { COMPARE, LANDING, LIBRARY_HOME, STUDIO_HOME } from '../lib/nav';
import { GITHUB_URL } from '../lib/repo';

interface Props {
  /** The full document title. */
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const here = (href: string) => (path === href ? 'page' : undefined);
---

<!doctype html>
<html lang="en" data-theme="light" data-brand="bridge" data-density="comfortable" data-space="landing">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Florian Gouloubi" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bridge" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1825" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('ds-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body class="lp-body">
    <Link variant="subtle" className="skip" href="#main">Skip to content</Link>
    <header class="lp-header">
      <div class="lp-wrap lp-header-row">
        <Link variant="subtle" className="lp-brand" href={LANDING} aria-label="Bridge, overview" aria-current={here(LANDING)}>
          <Logo />
        </Link>
        <nav class="lp-nav" aria-label="Main">
          <Link variant="subtle" href={STUDIO_HOME}>Studio</Link>
          <Link variant="subtle" href={LIBRARY_HOME}>Docs</Link>
          <Link variant="subtle" href={GITHUB_URL} className="lp-nav-wide">GitHub</Link>
          <IconButton icon={Moon} size="sm" label="Dark theme" data-theme-toggle aria-pressed="false" title="Dark theme" />
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1" class="lp-main">
      <slot />
    </main>

    <footer class="lp-footer">
      <div class="lp-wrap lp-footer-row">
        <span class="lp-footer-brand">
          <Logo />
          <span class="lp-muted">Open source, MIT</span>
        </span>
        <nav class="lp-footer-links" aria-label="Footer">
          <Link variant="subtle" href={STUDIO_HOME}>Studio</Link>
          <Link variant="subtle" href={LIBRARY_HOME}>Docs</Link>
          <Link variant="subtle" href={COMPARE} aria-current={here(COMPARE)}>Compare</Link>
          <Link variant="subtle" href={GITHUB_URL}>GitHub</Link>
          <Link variant="subtle" href="https://www.npmjs.com/org/bridge-ds">npm</Link>
          <Link variant="subtle" href="/changelog/">Changelog</Link>
        </nav>
      </div>
    </footer>
    <p class="sr-only" role="status" aria-live="polite" id="live"></p>
    <script>
      import { initLanding } from '../scripts/landing';
      initLanding();
    </script>
  </body>
</html>
