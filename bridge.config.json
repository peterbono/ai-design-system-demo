{
  "tokens": {
    "root": "tokens",
    "include": [
      "**/*.tokens.json"
    ],
    "tiers": {
      "primitive": [
        "primitives"
      ],
      "semantic": [
        "semantic"
      ]
    },
    "layers": [
      {
        "files": "primitives/*.tokens.json"
      },
      {
        "files": "semantic/{theme}.tokens.json"
      }
    ]
  },
  "modes": {
    "theme": {
      "values": [
        "default"
      ],
      "default": "default"
    }
  },
  "name": "shadcn/ui (measured)"
}
